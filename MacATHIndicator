            line.set_xy2(linePDH, bar_index + EXTEND, pdh)
            label.set_xy(labelPDH, bar_index, pdh)

    // PDL - Green dotted line
    if not na(pdl)
        if na(linePDL) or newDay
            if not na(linePDL)
                line.delete(linePDL)
            if not na(labelPDL)
                label.delete(labelPDL)
            linePDL := line.new(bar_index, pdl, bar_index + EXTEND, pdl,
                     color=color.new(color.green, 30), width=2, style=line.style_dotted)
            labelPDL := label.new(bar_index, pdl, "PDL",
                      style=label.style_label_right, color=color.new(color.green, 60),
