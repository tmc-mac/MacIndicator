        lineNYOpen := line.new(bar_index, open, bar_index + EXTEND, open,
                 color=color.new(color.blue, 40), width=1, style=line.style_dotted)
        labelNYOpen := label.new(bar_index, open, "NY Open",
                  style=label.style_label_right, color=color.new(color.blue, 70),
                  textcolor=color.white, size=size.tiny, yloc=yloc.price)

    // Asia High/Low - Yellow
    if not na(asiaHiFinal)
        if na(lineAsiaHi) or asiaStart
            if not na(lineAsiaHi)
                line.delete(lineAsiaHi)
            if not na(labelAsiaHi)
                label.delete(labelAsiaHi)
            lineAsiaHi := line.new(bar_index, asiaHiFinal, bar_index + EXTEND, asiaHiFinal,
                     color=color.new(color.yellow, 50), width=1, style=line.style_dotted)
            labelAsiaHi := label.new(bar_index, asiaHiFinal, "Asia Hi",
                      style=label.style_label_right, color=color.new(color.yellow, 70),
                      textcolor=color.black, size=size.tiny, yloc=yloc.price)
        else
            line.set_xy1(lineAsiaHi, bar_index, asiaHiFinal)
            line.set_xy2(lineAsiaHi, bar_index + EXTEND, asiaHiFinal)
            label.set_xy(labelAsiaHi, bar_index, asiaHiFinal)
    else if not na(lineAsiaHi)
        line.delete(lineAsiaHi)
        lineAsiaHi := na
        label.delete(labelAsiaHi)
        labelAsiaHi := na

    if not na(asiaLoFinal)
        if na(lineAsiaLo) or asiaStart
            if not na(lineAsiaLo)
                line.delete(lineAsiaLo)
            if not na(labelAsiaLo)
                label.delete(labelAsiaLo)
            lineAsiaLo := line.new(bar_index, asiaLoFinal, bar_index + EXTEND, asiaLoFinal,
                     color=color.new(color.yellow, 50), width=1, style=line.style_dotted)
            labelAsiaLo := label.new(bar_index, asiaLoFinal, "Asia Lo",
                      style=label.style_label_right, color=color.new(color.yellow, 70),
                      textcolor=color.black, size=size.tiny, yloc=yloc.price)
        else
            line.set_xy1(lineAsiaLo, bar_index, asiaLoFinal)
            line.set_xy2(lineAsiaLo, bar_index + EXTEND, asiaLoFinal)
            label.set_xy(labelAsiaLo, bar_index, asiaLoFinal)
    else if not na(lineAsiaLo)
        line.delete(lineAsiaLo)
        lineAsiaLo := na
        label.delete(labelAsiaLo)
        labelAsiaLo := na

    // London High/Low - Lime
    if not na(lonHiFinal)
        if na(lineLonHi) or lonStart
            if not na(lineLonHi)
                line.delete(lineLonHi)
            if not na(labelLonHi)
                label.delete(labelLonHi)
            lineLonHi := line.new(bar_index, lonHiFinal, bar_index + EXTEND, lonHiFinal,
                     color=color.new(color.lime, 50), width=1, style=line.style_dotted)
            labelLonHi := label.new(bar_index, lonHiFinal, "London Hi",
                      style=label.style_label_right, color=color.new(color.lime, 70),
                      textcolor=color.black, size=size.tiny, yloc=yloc.price)
        else
            line.set_xy1(lineLonHi, bar_index, lonHiFinal)
            line.set_xy2(lineLonHi, bar_index + EXTEND, lonHiFinal)
            label.set_xy(labelLonHi, bar_index, lonHiFinal)
    else if not na(lineLonHi)
        line.delete(lineLonHi)
        lineLonHi := na
        label.delete(labelLonHi)
        labelLonHi := na

    if not na(lonLoFinal)
        if na(lineLonLo) or lonStart
            if not na(lineLonLo)
                line.delete(lineLonLo)
            if not na(labelLonLo)
                label.delete(labelLonLo)
            lineLonLo := line.new(bar_index, lonLoFinal, bar_index + EXTEND, lonLoFinal,
                     color=color.new(color.lime, 50), width=1, style=line.style_dotted)
            labelLonLo := label.new(bar_index, lonLoFinal, "London Lo",
                      style=label.style_label_right, color=color.new(color.lime, 70),
                      textcolor=color.black, size=size.tiny, yloc=yloc.price)
        else
            line.set_xy1(lineLonLo, bar_index, lonLoFinal)
            line.set_xy2(lineLonLo, bar_index + EXTEND, lonLoFinal)
            label.set_xy(labelLonLo, bar_index, lonLoFinal)
    else if not na(lineLonLo)
        line.delete(lineLonLo)
        lineLonLo := na
        label.delete(labelLonLo)
        labelLonLo := na

    // 4HR Entry Level - Lime solid line
    if not na(r4_entry_level) and r4_setup_bias != 0 and not r4_triggered
        if na(line4HREntry) or new4HCandle
            if not na(line4HREntry)
                line.delete(line4HREntry)
            if not na(label4HREntry)
                label.delete(label4HREntry)
            entryColor = r4_setup_bias == 1 ? color.lime : color.fuchsia
            line4HREntry := line.new(bar_index, r4_entry_level, bar_index + EXTEND, r4_entry_level,
                     color=color.new(entryColor, 20), width=2, style=line.style_solid)
            label4HREntry := label.new(bar_index, r4_entry_level, "4HR ENTRY",
                      style=label.style_label_right, color=color.new(entryColor, 50),
                      textcolor=color.white, size=size.small, yloc=yloc.price)
        else
            line.set_xy1(line4HREntry, bar_index, r4_entry_level)
            line.set_xy2(line4HREntry, bar_index + EXTEND, r4_entry_level)
            label.set_xy(label4HREntry, bar_index, r4_entry_level)
    else if not na(line4HREntry)
        line.delete(line4HREntry)
        line4HREntry := na
        label.delete(label4HREntry)
        label4HREntry := na

    // 4HR Stop Level - Red dashed line
    if not na(r4_exit_level) and r4_setup_bias != 0
        if na(line4HRStop) or new4HCandle
            if not na(line4HRStop)
                line.delete(line4HRStop)
            if not na(label4HRStop)
                label.delete(label4HRStop)
            line4HRStop := line.new(bar_index, r4_exit_level, bar_index + EXTEND, r4_exit_level,
                     color=color.new(color.red, 30), width=1, style=line.style_dashed)
            label4HRStop := label.new(bar_index, r4_exit_level, "STOP",
                      style=label.style_label_right, color=color.new(color.red, 50),
                      textcolor=color.white, size=size.tiny, yloc=yloc.price)
        else
            line.set_xy1(line4HRStop, bar_index, r4_exit_level)
            line.set_xy2(line4HRStop, bar_index + EXTEND, r4_exit_level)
            label.set_xy(label4HRStop, bar_index, r4_exit_level)
    else if not na(line4HRStop)
        line.delete(line4HRStop)
        line4HRStop := na
        label.delete(label4HRStop)
        label4HRStop := na

    // 4HR Target Level - Aqua dashed line
    if not na(r4_target_level) and r4_setup_bias != 0
        if na(line4HRTarget) or new4HCandle
            if not na(line4HRTarget)
                line.delete(line4HRTarget)
            if not na(label4HRTarget)
                label.delete(label4HRTarget)
            line4HRTarget := line.new(bar_index, r4_target_level, bar_index + EXTEND, r4_target_level,
                     color=color.new(color.aqua, 30), width=1, style=line.style_dashed)
            label4HRTarget := label.new(bar_index, r4_target_level, "TARGET",
                      style=label.style_label_right, color=color.new(color.aqua, 50),
                      textcolor=color.white, size=size.tiny, yloc=yloc.price)
        else
            line.set_xy1(line4HRTarget, bar_index, r4_target_level)
            line.set_xy2(line4HRTarget, bar_index + EXTEND, r4_target_level)
            label.set_xy(label4HRTarget, bar_index, r4_target_level)
    else if not na(line4HRTarget)
        line.delete(line4HRTarget)
        line4HRTarget := na
        label.delete(label4HRTarget)
        label4HRTarget := na

    // 4HR Re-Entry Level - Yellow solid line (shows pullback entry during active trades)
    if not na(reentry_level) and r4_triggered
        if na(line4HRReentry) or new1HCandle
            if not na(line4HRReentry)
                line.delete(line4HRReentry)
            if not na(label4HRReentry)
                label.delete(label4HRReentry)
            reentryLineColor = r4_setup_bias == 1 ? color.yellow : color.orange
            line4HRReentry := line.new(bar_index, reentry_level, bar_index + EXTEND, reentry_level,
                     color=color.new(reentryLineColor, 20), width=2, style=line.style_solid)
            label4HRReentry := label.new(bar_index, reentry_level, "RE-ENTRY (" + reentry_type + ")",
                      style=label.style_label_right, color=color.new(reentryLineColor, 50),
                      textcolor=color.white, size=size.small, yloc=yloc.price)
        else
            line.set_xy1(line4HRReentry, bar_index, reentry_level)
            line.set_xy2(line4HRReentry, bar_index + EXTEND, reentry_level)
            label.set_xy(label4HRReentry, bar_index, reentry_level)
    else if not na(line4HRReentry)
        line.delete(line4HRReentry)
        line4HRReentry := na
        label.delete(label4HRReentry)
        label4HRReentry := na

