//@version=5
indicator("MAC ATH Strategy V1", overlay=true, max_labels_count=500, max_boxes_count=50)

//══════════════════════════════════════════════════════════════════════════════
// INPUTS & SETTINGS
//══════════════════════════════════════════════════════════════════════════════

// Timezone
string TZ = input.string("America/New_York", "Timezone", options=["America/New_York", "America/Chicago", "America/Los_Angeles"])

// Strategy Toggles
enable12HR = input.bool(true, "Enable 12HR Miyagi Strategy", group="Strategy Selection")
enable4HR  = input.bool(true, "Enable 4HR Re-Trigger Strategy", group="Strategy Selection")
enable322  = input.bool(true, "Enable 322 First Live Strategy", group="Strategy Selection")

// Dashboard Settings
showDashboard = input.bool(true, "Show Dashboard", group="Dashboard")
dashPosition  = input.string("top_right", "Dashboard Position", 
     options=["top_left", "top_center", "top_right", "middle_left", "middle_center", 
              "middle_right", "bottom_left", "bottom_center", "bottom_right"], group="Dashboard")
dashSize      = input.string("normal", "Dashboard Size", options=["tiny", "small", "normal", "large", "huge"], group="Dashboard")

// Visual Settings
showLevels    = input.bool(true, "Show Key Levels on Chart", group="Visual")
showPatterns  = input.bool(true, "Show Pattern Annotations", group="Visual")
colBullish    = input.color(color.new(color.green, 80), "Bullish Color", group="Visual")
colBearish    = input.color(color.new(color.red, 80), "Bearish Color", group="Visual")
colNeutral    = input.color(color.new(color.gray, 80), "Neutral Color", group="Visual")

// Volume Settings
volEMALen     = input.int(20, "Volume EMA Length", minval=1, group="Volume")
volThreshold  = input.float(1.5, "High Volume Threshold (x EMA)", minval=0.5, step=0.1, group="Volume")

//══════════════════════════════════════════════════════════════════════════════
// BAR NOTATION SYSTEM (1-Inside, 2-Directional, 3-Outside)
//══════════════════════════════════════════════════════════════════════════════

f_getBarType(_high, _low, _close, _open) =>
    prevHigh = high[1]
    prevLow  = low[1]
    
    isInside  = (_high <= prevHigh and _low >= prevLow)
    isOutside = (_high > prevHigh and _low < prevLow)
    is2UP     = (_high > prevHigh and _low >= prevLow and _close > _open)
    is2DOWN   = (_high <= prevHigh and _low < prevLow and _close < _open)
    
    barType = 0  // 0=undefined
    if isInside
        barType := 1
    else if isOutside
        barType := 3
    else if is2UP
        barType := 2  // 2UP
    else if is2DOWN
        barType := -2 // 2DOWN
    
    barType

currentBarType = f_getBarType(high, low, close, open)

//══════════════════════════════════════════════════════════════════════════════
// HELPER FUNCTIONS
//══════════════════════════════════════════════════════════════════════════════

f_getMidpoint(_high, _low) =>
    (_high + _low) / 2.0

f_isMarketOpen() =>
    hour(time, TZ) == 9 and minute(time, TZ) >= 30 or hour(time, TZ) > 9

f_is4AMCandle() =>
    hour(time, TZ) == 4 and minute(time, TZ) == 0

f_is8AMCandle() =>
    hour(time, TZ) == 8 and minute(time, TZ) == 0

f_is4PMCandle() =>
    hour(time, TZ) == 16 and minute(time, TZ) == 0

f_is9AMCandle() =>
    hour(time, TZ) == 9 and minute(time, TZ) == 0

f_is10AMCandle() =>
    hour(time, TZ) == 10 and minute(time, TZ) == 0

//══════════════════════════════════════════════════════════════════════════════
// MULTI-TIMEFRAME DATA REQUESTS & SESSION LEVELS
//══════════════════════════════════════════════════════════════════════════════

// Previous Day High/Low - Using PT timezone for consistency
newDay = ta.change(time("D", "America/Los_Angeles")) != 0

var float dayHi = na
var float dayLo = na
var float pdh = na
var float pdl = na

// On new PT day: lock prior day FIRST (before updating with new bar), then reset
if newDay
    pdh := dayHi
    pdl := dayLo
    dayHi := high
    dayLo := low
else
    // Only update running high/low if NOT a new day (to avoid including new day's bar in PDH/PDL)
    if na(dayHi)
        dayHi := high
        dayLo := low
    else
        dayHi := math.max(dayHi, high)
        dayLo := math.min(dayLo, low)

// Asia/London session definitions (PT timezone)
string ASIA_SESSION   = "1500-0000"   // 3:00pm–12:00am PT
string LONDON_SESSION = "0000-0630"   // 12:00am–6:30am PT

inAsia   = not na(time(timeframe.period, ASIA_SESSION, "America/Los_Angeles"))
inLondon = not na(time(timeframe.period, LONDON_SESSION, "America/Los_Angeles"))

asiaStart = inAsia and not inAsia[1]
asiaEnd   = (not inAsia) and inAsia[1]
lonStart  = inLondon and not inLondon[1]
lonEnd    = (not inLondon) and inLondon[1]

// LIVE Asia High/Low (updates while in session, then locks)
var float asiaHiLive = na
var float asiaLoLive = na
var float asiaHiLock = na
var float asiaLoLock = na

// IMPORTANT: Lock Asia values BEFORE clearing on newDay (asiaEnd and newDay happen simultaneously at midnight PT)
if asiaEnd and not na(asiaHiLive) and not na(asiaLoLive)
    asiaHiLock := asiaHiLive
    asiaLoLock := asiaLoLive

// Clear live values on new day (after locking above)
if newDay
    asiaHiLive := na
    asiaLoLive := na
    // Note: Keep asiaHiLock/asiaLoLock - they hold the locked session values

if asiaStart
    asiaHiLive := high
    asiaLoLive := low

if inAsia
    asiaHiLive := math.max(nz(asiaHiLive, high), high)
    asiaLoLive := math.min(nz(asiaLoLive, low),  low)

float asiaHiFinal = inAsia ? asiaHiLive : asiaHiLock
float asiaLoFinal = inAsia ? asiaLoLive : asiaLoLock

// LIVE London High/Low (updates while in session, then locks)
var float lonHiLive = na
var float lonLoLive = na
var float lonHiLock = na
var float lonLoLock = na

if newDay
    lonHiLive := na
    lonLoLive := na
    // DO NOT clear lonHiLock / lonLoLock here - keep previous London levels until new session locks them

if lonStart
    lonHiLive := high
    lonLoLive := low

if inLondon
    lonHiLive := math.max(nz(lonHiLive, high), high)
    lonLoLive := math.min(nz(lonLoLive, low),  low)

if lonEnd and not na(lonHiLive) and not na(lonLoLive)
    lonHiLock := lonHiLive
    lonLoLock := lonLoLive

float lonHiFinal = inLondon ? lonHiLive : lonHiLock
float lonLoFinal = inLondon ? lonLoLive : lonLoLock

// Session opens (PT timezone)
y = year(time, "America/Los_Angeles")
m = month(time, "America/Los_Angeles")
d = dayofmonth(time, "America/Los_Angeles")

ts0630 = timestamp("America/Los_Angeles", y, m, d, 6, 30)
ts1500 = timestamp("America/Los_Angeles", y, m, d, 15, 0)
ts0000 = timestamp("America/Los_Angeles", y, m, d, 0, 0)

cross0630 = (time >= ts0630) and (nz(time[1]) < ts0630)
cross1500 = (time >= ts1500) and (nz(time[1]) < ts1500)
cross0000 = (time >= ts0000) and (nz(time[1]) < ts0000)

var float nyOpen = na      // 6:30 AM PT (9:30 AM ET)
var float pm3Open = na     // 15:00 PT (3:00 PM PT)
var float midnightOpen = na // 00:00 PT (Midnight PT)

if cross0630
    nyOpen := open

if cross1500
    pm3Open := open

if cross0000
    midnightOpen := open

// 12HR data
[mtf12H_open, mtf12H_high, mtf12H_low, mtf12H_close, mtf12H_time] = 
     request.security(syminfo.tickerid, "720", [open, high, low, close, time], 
     lookahead=barmerge.lookahead_off)

// 4HR data
[mtf4H_open, mtf4H_high, mtf4H_low, mtf4H_close, mtf4H_time] = 
     request.security(syminfo.tickerid, "240", [open, high, low, close, time], 
     lookahead=barmerge.lookahead_off)

// 1HR data
[mtf1H_open, mtf1H_high, mtf1H_low, mtf1H_close, mtf1H_time] = 
     request.security(syminfo.tickerid, "60", [open, high, low, close, time], 
     lookahead=barmerge.lookahead_off)

//══════════════════════════════════════════════════════════════════════════════
// 12HR MIYAGI STRATEGY (1-3-1 Pattern)
//══════════════════════════════════════════════════════════════════════════════

var float m12_candle1_high = na
var float m12_candle1_low  = na
var float m12_candle2_high = na
var float m12_candle2_low  = na
var float m12_candle3_high = na
var float m12_candle3_low  = na
var float m12_trigger      = na
var int   m12_setup_state  = 0  // 0=none, 1=1st inside, 2=2nd outside, 3=3rd inside, 4=live
var int   m12_bias         = 0  // 1=bullish, -1=bearish, 0=neutral
var string m12_pattern     = ""
var bool  m12_invalidated  = false
var int   m12_candle_count = 0

// Detect new 12HR candle
bool new12HCandle = ta.change(mtf12H_time) != 0

if new12HCandle
    m12_candle_count += 1
    
    // Get bar types for sequence detection
    int bar1Type = na
    int bar2Type = na
    int bar3Type = na
    
    if m12_candle_count >= 3
        // Calculate bar types for previous candles
        bar3Type := f_getBarType(mtf12H_high[0], mtf12H_low[0], mtf12H_close[0], mtf12H_open[0])
        bar2Type := f_getBarType(mtf12H_high[1], mtf12H_low[1], mtf12H_close[1], mtf12H_open[1])
        bar1Type := f_getBarType(mtf12H_high[2], mtf12H_low[2], mtf12H_close[2], mtf12H_open[2])
        
        // Check for 1-3-1 pattern
        if bar1Type == 1 and bar2Type == 3 and bar3Type == 1
            m12_candle1_high := mtf12H_high[2]
            m12_candle1_low  := mtf12H_low[2]
            m12_candle2_high := mtf12H_high[1]
            m12_candle2_low  := mtf12H_low[1]
            m12_candle3_high := mtf12H_high[0]
            m12_candle3_low  := mtf12H_low[0]
            m12_trigger      := f_getMidpoint(m12_candle3_high, m12_candle3_low)
            m12_setup_state  := 3
            m12_pattern      := "1-3-1 Valid"
            m12_invalidated  := false
            m12_candle_count := 0

// Check for 4th candle (live candle) - must be 2UP or 2DOWN
if m12_setup_state == 3
    currentBar = f_getBarType(mtf12H_high, mtf12H_low, mtf12H_close, mtf12H_open)
    
    // Check if 3rd candle becomes invalidated (becomes a 3-bar)
    if mtf12H_high > m12_candle3_high and mtf12H_low < m12_candle3_low
        m12_invalidated := true
        m12_setup_state := 0
        m12_pattern := "Invalidated"
    
    // Check if 4th candle is forming as 2UP or 2DOWN
    if currentBar == 2  // 2UP
        m12_setup_state := 4
        m12_bias := close > m12_trigger ? -1 : 0  // Bearish if above trigger (reversal expected)
        m12_pattern := "2UP Live"
    else if currentBar == -2  // 2DOWN
        m12_setup_state := 4
        m12_bias := close < m12_trigger ? 1 : 0   // Bullish if below trigger (reversal expected)
        m12_pattern := "2DOWN Live"

// Entry logic at market open
var bool m12_entry_triggered = false
if m12_setup_state == 4 and f_isMarketOpen() and not m12_entry_triggered
    if m12_bias == 1 and close >= m12_trigger  // Bullish entry
        m12_entry_triggered := true
    else if m12_bias == -1 and close <= m12_trigger  // Bearish entry
        m12_entry_triggered := true

// 60-minute flip invalidation
var bool m12_active_trade = false
var float m12_last_60m_high = na
var float m12_last_60m_low  = na

if m12_entry_triggered
    m12_active_trade := true
    m12_last_60m_high := mtf1H_high
    m12_last_60m_low  := mtf1H_low

if m12_active_trade
    // Update 60m levels
    if ta.change(mtf1H_time) != 0
        m12_last_60m_high := mtf1H_high
        m12_last_60m_low  := mtf1H_low
    
    // Check for flip
    if m12_bias == 1 and low < m12_last_60m_low  // Bullish trade flipped
        m12_active_trade := false
        m12_setup_state := 0
        m12_pattern := "60m Flip Exit"
    else if m12_bias == -1 and high > m12_last_60m_high  // Bearish trade flipped
        m12_active_trade := false
        m12_setup_state := 0
        m12_pattern := "60m Flip Exit"

//══════════════════════════════════════════════════════════════════════════════
// 4HR RE-TRIGGER STRATEGY (Enhanced - All 4HR Sessions)
//══════════════════════════════════════════════════════════════════════════════

// Track multiple 4HR setups throughout the day
var array<float> r4_entry_highs = array.new<float>()
var array<float> r4_entry_lows = array.new<float>()
var array<int> r4_biases = array.new<int>()
var array<int> r4_bar_times = array.new<int>()
var array<bool> r4_triggered = array.new<bool>()

var float r4_current_high = na
var float r4_current_low = na
var int r4_current_bias = 0
var string r4_pattern = ""
var bool r4_current_triggered = false
var int r4_setup_count = 0

// Detect new 4HR candle
bool new4HCandle = ta.change(mtf4H_time) != 0

if new4HCandle
    // Get previous two 4HR candles' bar types
    int bar1Type = f_getBarType(mtf4H_high[1], mtf4H_low[1], mtf4H_close[1], mtf4H_open[1])
    int bar2Type = f_getBarType(mtf4H_high[0], mtf4H_low[0], mtf4H_close[0], mtf4H_open[0])
    
    // Check for reversal patterns (2DOWN→2UP or 2UP→2DOWN)
    bool bullishReversal = (bar1Type == -2 and bar2Type == 2)  // 2DOWN then 2UP
    bool bearishReversal = (bar1Type == 2 and bar2Type == -2)  // 2UP then 2DOWN
    
    if bullishReversal
        // New bullish reversal setup
        r4_current_high := mtf4H_high[1]  // First candle (2DOWN) high is entry trigger
        r4_current_low := mtf4H_low[1]
        r4_current_bias := 1  // Bullish
        r4_pattern := "2DOWN→2UP Rev"
        r4_current_triggered := false
        r4_setup_count += 1
        
        if showPatterns
            label.new(bar_index, low, "4HR CALL Setup\n" + str.tostring(r4_current_high, format.mintick), 
                     style=label.style_label_up, color=color.new(color.green, 50), 
                     textcolor=color.white, size=size.small)
    
    else if bearishReversal
        // New bearish reversal setup
        r4_current_high := mtf4H_high[1]
        r4_current_low := mtf4H_low[1]  // First candle (2UP) low is entry trigger
        r4_current_bias := -1  // Bearish
        r4_pattern := "2UP→2DOWN Rev"
        r4_current_triggered := false
        r4_setup_count += 1
        
        if showPatterns
            label.new(bar_index, high, "4HR PUT Setup\n" + str.tostring(r4_current_low, format.mintick), 
                     style=label.style_label_down, color=color.new(color.red, 50), 
                     textcolor=color.white, size=size.small)

// Entry triggers (check on every bar)
if not na(r4_current_high) and not r4_current_triggered
    if r4_current_bias == 1 and close > r4_current_high  // Bullish breakout
        r4_current_triggered := true
        r4_pattern := "CALL Entry ✓"
        
        if showPatterns
            label.new(bar_index, low, "4HR CALL Entry\n" + str.tostring(close, format.mintick), 
                     style=label.style_label_up, color=color.new(color.lime, 30), 
                     textcolor=color.white, size=size.normal)
    
    else if r4_current_bias == -1 and close < r4_current_low  // Bearish breakdown
        r4_current_triggered := true
        r4_pattern := "PUT Entry ✓"
        
        if showPatterns
            label.new(bar_index, high, "4HR PUT Entry\n" + str.tostring(close, format.mintick), 
                     style=label.style_label_down, color=color.new(color.maroon, 30), 
                     textcolor=color.white, size=size.normal)

//══════════════════════════════════════════════════════════════════════════════
// 322 FIRST LIVE STRATEGY (3-2-2 Reversal, 1HR)
//══════════════════════════════════════════════════════════════════════════════

var float f322_candle8AM_high = na
var float f322_candle8AM_low  = na
var float f322_candle9AM_high = na
var float f322_candle9AM_low  = na
var int   f322_setup_state    = 0  // 0=none, 1=8AM 3-bar set, 2=9AM 2-bar set, 3=valid
var int   f322_bias           = 0
var string f322_pattern       = ""
var bool  f322_triggered      = false

// 8AM 1HR candle check
bool is8AM_1H = ta.change(mtf1H_time) != 0 and hour(mtf1H_time, TZ) == 8

if is8AM_1H
    int barType8AM = f_getBarType(mtf1H_high, mtf1H_low, mtf1H_close, mtf1H_open)
    
    if barType8AM == 3  // Outside bar
        f322_candle8AM_high := mtf1H_high
        f322_candle8AM_low  := mtf1H_low
        f322_setup_state    := 1
        f322_pattern        := "8AM 3-Bar"
        f322_triggered      := false

// 9AM 1HR candle check
bool is9AM_1H = ta.change(mtf1H_time) != 0 and hour(mtf1H_time, TZ) == 9

if is9AM_1H and f322_setup_state == 1
    int barType9AM = f_getBarType(mtf1H_high, mtf1H_low, mtf1H_close, mtf1H_open)
    
    if barType9AM == 2  // 2UP
        f322_candle9AM_high := mtf1H_high
        f322_candle9AM_low  := mtf1H_low
        f322_setup_state    := 2
        f322_bias           := -1  // Bearish (reversal expected)
        f322_pattern        := "3-2UP (Rev Down)"
    else if barType9AM == -2  // 2DOWN
        f322_candle9AM_high := mtf1H_high
        f322_candle9AM_low  := mtf1H_low
        f322_setup_state    := 2
        f322_bias           := 1  // Bullish (reversal expected)
        f322_pattern        := "3-2DOWN (Rev Up)"
    else
        f322_setup_state := 0
        f322_pattern := "9AM not 2-bar"

// 10AM entry window
bool is10AM_1H = hour(time, TZ) == 10

if is10AM_1H and f322_setup_state == 2 and not f322_triggered
    if f322_bias == 1 and close > f322_candle9AM_high  // Bullish entry
        f322_triggered := true
        f322_setup_state := 3
        f322_pattern := "CALL Entry"
    else if f322_bias == -1 and close < f322_candle9AM_low  // Bearish entry
        f322_triggered := true
        f322_setup_state := 3
        f322_pattern := "PUT Entry"

// 60-minute flip for 322
var bool f322_active_trade = false
var float f322_last_60m_high = na
var float f322_last_60m_low  = na

if f322_triggered
    f322_active_trade := true
    f322_last_60m_high := mtf1H_high
    f322_last_60m_low  := mtf1H_low

if f322_active_trade
    if ta.change(mtf1H_time) != 0
        f322_last_60m_high := mtf1H_high
        f322_last_60m_low  := mtf1H_low
    
    if f322_bias == 1 and low < f322_last_60m_low
        f322_active_trade := false
        f322_setup_state := 0
        f322_pattern := "60m Flip Exit"
    else if f322_bias == -1 and high > f322_last_60m_high
        f322_active_trade := false
        f322_setup_state := 0
        f322_pattern := "60m Flip Exit"

//══════════════════════════════════════════════════════════════════════════════
// VOLUME ANALYSIS
//══════════════════════════════════════════════════════════════════════════════

volEMA = ta.ema(volume, volEMALen)
volStatus = volume > volEMA * volThreshold ? "High" : volume > volEMA ? "Above Avg" : "Below Avg"
volColor = volume > volEMA * volThreshold ? color.green : volume > volEMA ? color.yellow : color.gray

//══════════════════════════════════════════════════════════════════════════════
// KEY SESSION LEVELS & BIAS TARGET
//══════════════════════════════════════════════════════════════════════════════

// All session levels are now calculated above in the session tracking section
// Build array of all key levels with labels

var array<float> keyLevels = array.new<float>()
var array<string> keyLabels = array.new<string>()

// Update levels array
if barstate.islast
    array.clear(keyLevels)
    array.clear(keyLabels)
    
    if not na(pdh)
        array.push(keyLevels, pdh)
        array.push(keyLabels, "PDH")
    
    if not na(pdl)
        array.push(keyLevels, pdl)
        array.push(keyLabels, "PDL")
    
    if not na(nyOpen)
        array.push(keyLevels, nyOpen)
        array.push(keyLabels, "NY Open")
    
    if not na(pm3Open)
        array.push(keyLevels, pm3Open)
        array.push(keyLabels, "3PM Open")
    
    if not na(midnightOpen)
        array.push(keyLevels, midnightOpen)
        array.push(keyLabels, "Midnight")
    
    if not na(asiaHiFinal)
        array.push(keyLevels, asiaHiFinal)
        array.push(keyLabels, "Asia High")
    
    if not na(asiaLoFinal)
        array.push(keyLevels, asiaLoFinal)
        array.push(keyLabels, "Asia Low")
    
    if not na(lonHiFinal)
        array.push(keyLevels, lonHiFinal)
        array.push(keyLabels, "London High")
    
    if not na(lonLoFinal)
        array.push(keyLevels, lonLoFinal)
        array.push(keyLabels, "London Low")

// Find nearest level and determine bias
string biasTarget = "None"
float biasLevel = na
float minDistance = 999999.0

if array.size(keyLevels) > 0
    for i = 0 to array.size(keyLevels) - 1
        float lvl = array.get(keyLevels, i)
        float dist = math.abs(close - lvl)
        
        if dist < minDistance and not na(lvl)
            minDistance := dist
            biasLevel := lvl
            biasTarget := array.get(keyLabels, i)

// Determine if bias is to go up or down to level
string biasDirection = na(biasLevel) ? "" : close < biasLevel ? " ↑" : close > biasLevel ? " ↓" : " @"
string levelBiasText = biasTarget + biasDirection

//══════════════════════════════════════════════════════════════════════════════
// STRUCTURE & PULLBACK ANALYSIS
//══════════════════════════════════════════════════════════════════════════════

// Simple structure: higher highs/lower lows
hhll_lookback = 20
isHH = high == ta.highest(high, hhll_lookback)
isLL = low == ta.lowest(low, hhll_lookback)
isLH = high[1] > high and high[1] == ta.highest(high, hhll_lookback)
isHL = low[1] < low and low[1] == ta.lowest(low, hhll_lookback)

structure = isHH or isLH ? "Bearish" : isLL or isHL ? "Bullish" : "Neutral"

// Pullback detection (price retracing from recent extreme)
atr = ta.atr(14)
recentHigh = ta.highest(high, 10)
recentLow = ta.lowest(low, 10)
pullbackDepth = (recentHigh - close) / atr

pullbackStatus = pullbackDepth > 2 ? "Deep" : pullbackDepth > 1 ? "Moderate" : "Shallow"

//══════════════════════════════════════════════════════════════════════════════
// PREFERENCE (PREF) - Time of day preference
//══════════════════════════════════════════════════════════════════════════════

currentHour = hour(time, TZ)
pref = currentHour >= 9 and currentHour < 11 ? "Prime" : 
       currentHour >= 11 and currentHour < 15 ? "Active" : 
       currentHour >= 15 or currentHour < 9 ? "Off-Hours" : "Other"

//══════════════════════════════════════════════════════════════════════════════
// OVERALL BIAS & CONFIDENCE SCORE
//══════════════════════════════════════════════════════════════════════════════

// Aggregate bias from all strategies
biasScore = 0
activeStrategies = 0

if enable12HR and m12_setup_state > 0
    biasScore += m12_bias
    activeStrategies += 1

if enable4HR and r4_current_bias != 0
    biasScore += r4_current_bias
    activeStrategies += 1

if enable322 and f322_setup_state > 0
    biasScore += f322_bias
    activeStrategies += 1

// Calculate normalized bias
overallBias = activeStrategies > 0 ? biasScore / activeStrategies : 0
biasText = overallBias > 0.3 ? "Bullish" : overallBias < -0.3 ? "Bearish" : "Neutral"
biasColor = overallBias > 0.3 ? color.green : overallBias < -0.3 ? color.red : color.gray

// Confidence score (0-100)
confidence = 0

// Add points for aligned strategies
if activeStrategies > 1
    alignment = math.abs(biasScore) / activeStrategies
    confidence += alignment * 40  // Max 40 points for alignment

// Add points for volume
if volStatus == "High"
    confidence += 20
else if volStatus == "Above Avg"
    confidence += 10

// Add points for structure alignment
if (biasText == "Bullish" and structure == "Bullish") or (biasText == "Bearish" and structure == "Bearish")
    confidence += 20

// Add points for being in prime time
if pref == "Prime"
    confidence += 10

confidence := math.min(confidence, 100)

