// VISUAL PLOTTING - Key Levels
//══════════════════════════════════════════════════════════════════════════════

int EXTEND = 500

var line linePDH = na
var line linePDL = na
var line lineNYOpen = na
var line lineAsiaHi = na
var line lineAsiaLo = na
var line lineLonHi = na
var line lineLonLo = na
var line line4HREntry = na
var line line4HRStop = na
var line line4HRTarget = na

var label labelPDH = na
var label labelPDL = na
var label labelNYOpen = na
var label labelAsiaHi = na
var label labelAsiaLo = na
var label labelLonHi = na
var label labelLonLo = na
var label label4HREntry = na
var label label4HRStop = na
var label label4HRTarget = na

if showLevels
    // PDH - Red dotted line
    if not na(pdh)
        if na(linePDH) or newDay
            if not na(linePDH)
                line.delete(linePDH)
            if not na(labelPDH)
                label.delete(labelPDH)
            linePDH := line.new(bar_index, pdh, bar_index + EXTEND, pdh,
                     color=color.new(color.red, 30), width=2, style=line.style_dotted)
            labelPDH := label.new(bar_index, pdh, "PDH",
                      style=label.style_label_right, color=color.new(color.red, 60),
                      textcolor=color.white, size=size.small, yloc=yloc.price)
        else
            line.set_xy1(linePDH, bar_index, pdh)
            line.set_xy2(linePDH, bar_index + EXTEND, pdh)
            label.set_xy(labelPDH, bar_index, pdh)

    // PDL - Green dotted line
    if not na(pdl)
        if na(linePDL) or newDay
            if not na(linePDL)
                line.delete(linePDL)
            if not na(labelPDL)
                label.delete(labelPDL)
            linePDL := line.new(bar_index, pdl, bar_index + EXTEND, pdl,
                     color=color.new(color.green, 30), width=2, style=line.style_dotted)
            labelPDL := label.new(bar_index, pdl, "PDL",
                      style=label.style_label_right, color=color.new(color.green, 60),
                      textcolor=color.white, size=size.small, yloc=yloc.price)
        else
            line.set_xy1(linePDL, bar_index, pdl)
            line.set_xy2(linePDL, bar_index + EXTEND, pdl)
            label.set_xy(labelPDL, bar_index, pdl)

    // NY Open - Blue dotted line
    if cross0630
        if not na(lineNYOpen)
            line.delete(lineNYOpen)
        if not na(labelNYOpen)
            label.delete(labelNYOpen)
        lineNYOpen := line.new(bar_index, open, bar_index + EXTEND, open,
                 color=color.new(color.blue, 40), width=1, style=line.style_dotted)
        labelNYOpen := label.new(bar_index, open, "NY Open",
                  style=label.style_label_right, color=color.new(color.blue, 70),
                  textcolor=color.white, size=size.tiny, yloc=yloc.price)

    // Asia High/Low - Yellow
    if not na(asiaHiFinal)
        if na(lineAsiaHi) or asiaStart
            if not na(lineAsiaHi)
                line.delete(lineAsiaHi)
            if not na(labelAsiaHi)
                label.delete(labelAsiaHi)
            lineAsiaHi := line.new(bar_index, asiaHiFinal, bar_index + EXTEND, asiaHiFinal,
                     color=color.new(color.yellow, 50), width=1, style=line.style_dotted)
            labelAsiaHi := label.new(bar_index, asiaHiFinal, "Asia Hi",
                      style=label.style_label_right, color=color.new(color.yellow, 70),
                      textcolor=color.black, size=size.tiny, yloc=yloc.price)
        else
            line.set_xy1(lineAsiaHi, bar_index, asiaHiFinal)
            line.set_xy2(lineAsiaHi, bar_index + EXTEND, asiaHiFinal)
            label.set_xy(labelAsiaHi, bar_index, asiaHiFinal)
    else if not na(lineAsiaHi)
        line.delete(lineAsiaHi)
        lineAsiaHi := na
        label.delete(labelAsiaHi)
        labelAsiaHi := na

    if not na(asiaLoFinal)
        if na(lineAsiaLo) or asiaStart
            if not na(lineAsiaLo)
                line.delete(lineAsiaLo)
            if not na(labelAsiaLo)
                label.delete(labelAsiaLo)
