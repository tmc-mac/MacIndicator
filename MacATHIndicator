    signal := biasText == "Bullish" ? "LONG" : biasText == "Bearish" ? "SHORT" : "None"
else if m12_setup_state >= 3 or (not na(r4_current_high) and r4_current_bias != 0) or f322_setup_state >= 2
    state := "Setup Active"
    signal := "Watch"
else if m12_setup_state > 0 or r4_setup_count > 0 or f322_setup_state > 0
    state := "Forming"
    signal := "Pending"

