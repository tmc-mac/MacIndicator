// ALERTS
//══════════════════════════════════════════════════════════════════════════════

// 4HR Setup Alerts (separate for bullish/bearish since message must be const)
alertcondition(new4HCandle and r4_setup_bias == 1 and not r4_triggered, "4HR LONG Setup", "4HR Re-Trigger LONG setup detected: {{ticker}} @ {{close}}")
alertcondition(new4HCandle and r4_setup_bias == -1 and not r4_triggered, "4HR SHORT Setup", "4HR Re-Trigger SHORT setup detected: {{ticker}} @ {{close}}")

// 4HR Entry Alerts
alertcondition(r4_triggered and r4_setup_bias == 1, "4HR LONG Entry", "4HR LONG Entry triggered: {{ticker}} @ {{close}}")
alertcondition(r4_triggered and r4_setup_bias == -1, "4HR SHORT Entry", "4HR SHORT Entry triggered: {{ticker}} @ {{close}}")

// GPS State Alerts
alertcondition(gpsState == "GO" and dailyBias == 1, "GPS GO LONG", "GPS GO: {{ticker}} - HTF Aligned LONG")
alertcondition(gpsState == "GO" and dailyBias == -1, "GPS GO SHORT", "GPS GO: {{ticker}} - HTF Aligned SHORT")
alertcondition(gpsState == "CHOP", "GPS CHOP Warning", "GPS CHOP: {{ticker}} - HTF Conflict or Inside Day")

// Volume Alerts
alertcondition(expansionAlert, "Volume Expansion", "Volume expansion detected: {{ticker}} - Breakout likely")
alertcondition(compressionAlert, "Volume Compression", "Volume compression detected: {{ticker}} - Expect breakout soon")
