//@version=5
indicator("MAC Price GPS - 4HR Re-Trigger", overlay=true, max_labels_count=500, max_boxes_count=500, max_lines_count=500)

//══════════════════════════════════════════════════════════════════════════════
// INPUTS & SETTINGS
//══════════════════════════════════════════════════════════════════════════════

// Timezone
string TZ = input.string("America/New_York", "Timezone", options=["America/New_York", "America/Chicago", "America/Los_Angeles"])

// Dashboard Settings
showDashboard = input.bool(true, "Show Dashboard", group="Dashboard")
dashPosition  = input.string("top_right", "Dashboard Position",
     options=["top_left", "top_center", "top_right", "middle_left", "middle_center",
              "middle_right", "bottom_left", "bottom_center", "bottom_right"], group="Dashboard")
dashSize      = input.string("normal", "Dashboard Size", options=["tiny", "small", "normal", "large", "huge"], group="Dashboard")

// Visual Settings
showLevels    = input.bool(true, "Show Key Levels on Chart", group="Visual")
showPatterns  = input.bool(true, "Show Pattern Annotations", group="Visual")
showOBs       = input.bool(true, "Show Order Blocks", group="Visual")
colBullish    = input.color(color.new(color.green, 80), "Bullish Color", group="Visual")
colBearish    = input.color(color.new(color.red, 80), "Bearish Color", group="Visual")
colNeutral    = input.color(color.new(color.gray, 80), "Neutral Color", group="Visual")

// Order Block Settings
ob_length     = input.int(5, 'OB Volume Pivot Length', minval=1, group="Order Blocks")
ob_bull_count = input.int(3, 'Bullish OB Count', minval=1, group="Order Blocks")
ob_bear_count = input.int(3, 'Bearish OB Count', minval=1, group="Order Blocks")
ob_mitigation = input.string('Wick', 'OB Mitigation Method', options=['Wick', 'Close'], group="Order Blocks")

//══════════════════════════════════════════════════════════════════════════════
// BAR NOTATION SYSTEM (1-Inside, 2-Directional, 3-Outside)
//══════════════════════════════════════════════════════════════════════════════

f_getBarType(_high, _low, _close, _open, _prevHigh, _prevLow) =>
    isInside  = (_high <= _prevHigh and _low >= _prevLow)
    isOutside = (_high > _prevHigh and _low < _prevLow)
    is2UP     = (_high > _prevHigh and _low >= _prevLow and _close > _open)
    is2DOWN   = (_high <= _prevHigh and _low < _prevLow and _close < _open)

    barType = 0  // 0=undefined
    if isInside
        barType := 1
    else if isOutside
        barType := 3
    else if is2UP
        barType := 2  // 2UP
    else if is2DOWN
        barType := -2 // 2DOWN

    barType

currentBarType = f_getBarType(high, low, close, open, high[1], low[1])

//══════════════════════════════════════════════════════════════════════════════
// HELPER FUNCTIONS
//══════════════════════════════════════════════════════════════════════════════

f_getMidpoint(_high, _low) =>
    (_high + _low) / 2.0

f_isMarketOpen() =>
    hour(time, TZ) == 9 and minute(time, TZ) >= 30 or hour(time, TZ) > 9

//══════════════════════════════════════════════════════════════════════════════
// ORDER BLOCK DETECTION (Based on LuxAlgo logic)
//══════════════════════════════════════════════════════════════════════════════

// Order state tracking
var int ob_state = 0
var float ob_target_bull = 0.0
var float ob_target_bear = 0.0

ob_upper = ta.highest(ob_length)
ob_lower = ta.lowest(ob_length)

if ob_mitigation == 'Close'
    ob_target_bull := ta.lowest(close, ob_length)
    ob_target_bear := ta.highest(close, ob_length)
else
    ob_target_bull := ob_lower
    ob_target_bear := ob_upper

// Order state: 0 = bearish, 1 = bullish
ob_state := high[ob_length] > ob_upper ? 0 : low[ob_length] < ob_lower ? 1 : ob_state[1]

// Volume pivot detection
ob_phv = ta.pivothigh(volume, ob_length, ob_length)

// Bullish OB arrays (GREEN - buy zones below price)
var array<float> bull_ob_top = array.new<float>(0)
var array<float> bull_ob_btm = array.new<float>(0)
var array<float> bull_ob_avg = array.new<float>(0)
var array<int> bull_ob_left = array.new<int>(0)

// Bearish OB arrays (RED - sell zones above price)
var array<float> bear_ob_top = array.new<float>(0)
var array<float> bear_ob_btm = array.new<float>(0)
var array<float> bear_ob_avg = array.new<float>(0)
var array<int> bear_ob_left = array.new<int>(0)

// Detect new bullish OB (forms in bullish state)
if ob_phv and ob_state == 1
    float ob_top_val = hl2[ob_length]
    float ob_btm_val = low[ob_length]
    float ob_avg_val = math.avg(ob_top_val, ob_btm_val)

    array.unshift(bull_ob_top, ob_top_val)
    array.unshift(bull_ob_btm, ob_btm_val)
    array.unshift(bull_ob_avg, ob_avg_val)
    array.unshift(bull_ob_left, time[ob_length])

// Detect new bearish OB (forms in bearish state)
if ob_phv and ob_state == 0
    float ob_top_val = high[ob_length]
    float ob_btm_val = hl2[ob_length]
    float ob_avg_val = math.avg(ob_top_val, ob_btm_val)

    array.unshift(bear_ob_top, ob_top_val)
    array.unshift(bear_ob_btm, ob_btm_val)
    array.unshift(bear_ob_avg, ob_avg_val)
    array.unshift(bear_ob_left, time[ob_length])

// Remove mitigated bullish OBs (price went below bottom)
if array.size(bull_ob_btm) > 0
    for i = array.size(bull_ob_btm) - 1 to 0
        if i < array.size(bull_ob_btm)
            float btm = array.get(bull_ob_btm, i)
            if ob_target_bull < btm
                array.remove(bull_ob_top, i)
                array.remove(bull_ob_btm, i)
                array.remove(bull_ob_avg, i)
                array.remove(bull_ob_left, i)

// Remove mitigated bearish OBs (price went above top)
if array.size(bear_ob_top) > 0
    for i = array.size(bear_ob_top) - 1 to 0
        if i < array.size(bear_ob_top)
            float top = array.get(bear_ob_top, i)
            if ob_target_bear > top
                array.remove(bear_ob_top, i)
                array.remove(bear_ob_btm, i)
                array.remove(bear_ob_avg, i)
                array.remove(bear_ob_left, i)

// Limit array sizes
while array.size(bull_ob_top) > ob_bull_count * 2
    array.pop(bull_ob_top)
    array.pop(bull_ob_btm)
    array.pop(bull_ob_avg)
    array.pop(bull_ob_left)

while array.size(bear_ob_top) > ob_bear_count * 2
    array.pop(bear_ob_top)
    array.pop(bear_ob_btm)
    array.pop(bear_ob_avg)
    array.pop(bear_ob_left)

// Find nearest bearish OB ABOVE current price (for LONG targets - where liquidity is)
float nearest_bear_ob_above = na
float nearest_bear_ob_top = na
float nearest_bear_ob_btm = na
if array.size(bear_ob_avg) > 0
    float min_dist = 999999.0
    for i = 0 to array.size(bear_ob_avg) - 1
        float avg = array.get(bear_ob_avg, i)
        if avg > close
            float dist = avg - close
            if dist < min_dist
                min_dist := dist
                nearest_bear_ob_above := avg
                nearest_bear_ob_top := array.get(bear_ob_top, i)
                nearest_bear_ob_btm := array.get(bear_ob_btm, i)

// Find nearest bullish OB BELOW current price (for SHORT targets - where liquidity is)
float nearest_bull_ob_below = na
float nearest_bull_ob_top = na
float nearest_bull_ob_btm = na
if array.size(bull_ob_avg) > 0
    float min_dist = 999999.0
    for i = 0 to array.size(bull_ob_avg) - 1
        float avg = array.get(bull_ob_avg, i)
        if avg < close
            float dist = close - avg
            if dist < min_dist
                min_dist := dist
                nearest_bull_ob_below := avg
                nearest_bull_ob_top := array.get(bull_ob_top, i)
                nearest_bull_ob_btm := array.get(bull_ob_btm, i)

//══════════════════════════════════════════════════════════════════════════════
// MULTI-TIMEFRAME DATA REQUESTS
//══════════════════════════════════════════════════════════════════════════════

// Daily data for HTF bias
[mtfD_open, mtfD_high, mtfD_low, mtfD_close, mtfD_time] =
     request.security(syminfo.tickerid, "D", [open, high, low, close, time],
     lookahead=barmerge.lookahead_off)

// Previous day data
[mtfD_prevHigh, mtfD_prevLow, mtfD_prevClose] =
     request.security(syminfo.tickerid, "D", [high[1], low[1], close[1]],
     lookahead=barmerge.lookahead_off)

// 4HR data
[mtf4H_open, mtf4H_high, mtf4H_low, mtf4H_close, mtf4H_time] =
     request.security(syminfo.tickerid, "240", [open, high, low, close, time],
     lookahead=barmerge.lookahead_off)

// Previous 4HR candles for bar type calculation
[mtf4H_prevHigh, mtf4H_prevLow, mtf4H_prevClose, mtf4H_prevOpen] =
     request.security(syminfo.tickerid, "240", [high[1], low[1], close[1], open[1]],
     lookahead=barmerge.lookahead_off)

[mtf4H_prev2High, mtf4H_prev2Low] =
     request.security(syminfo.tickerid, "240", [high[2], low[2]],
     lookahead=barmerge.lookahead_off)

// 1HR data
[mtf1H_open, mtf1H_high, mtf1H_low, mtf1H_close, mtf1H_time] =
     request.security(syminfo.tickerid, "60", [open, high, low, close, time],
     lookahead=barmerge.lookahead_off)

// 30min data for tighter stops
[mtf30_open, mtf30_high, mtf30_low, mtf30_close, mtf30_time] =
     request.security(syminfo.tickerid, "30", [open, high, low, close, time],
     lookahead=barmerge.lookahead_off)

[mtf30_prevHigh, mtf30_prevLow] =
     request.security(syminfo.tickerid, "30", [high[1], low[1]],
     lookahead=barmerge.lookahead_off)

// Detect new 30min candle
bool new30mCandle = ta.change(mtf30_time) != 0

//══════════════════════════════════════════════════════════════════════════════
// SESSION LEVELS (PDH/PDL, Session Opens, Asia/London)
//══════════════════════════════════════════════════════════════════════════════

// Previous Day High/Low - Using PT timezone for consistency
newDay = ta.change(time("D", "America/Los_Angeles")) != 0

var float dayHi = na
var float dayLo = na
var float pdh = na
var float pdl = na

// On new PT day: lock prior day FIRST (before updating with new bar), then reset
if newDay
    pdh := dayHi
    pdl := dayLo
    dayHi := high
    dayLo := low
else
    // Only update running high/low if NOT a new day
    if na(dayHi)
        dayHi := high
        dayLo := low
    else
        dayHi := math.max(dayHi, high)
        dayLo := math.min(dayLo, low)

// Asia/London session definitions (PT timezone)
string ASIA_SESSION   = "1500-0000"   // 3:00pm–12:00am PT
string LONDON_SESSION = "0000-0630"   // 12:00am–6:30am PT

inAsia   = not na(time(timeframe.period, ASIA_SESSION, "America/Los_Angeles"))
inLondon = not na(time(timeframe.period, LONDON_SESSION, "America/Los_Angeles"))

asiaStart = inAsia and not inAsia[1]
asiaEnd   = (not inAsia) and inAsia[1]
lonStart  = inLondon and not inLondon[1]
lonEnd    = (not inLondon) and inLondon[1]

// LIVE Asia High/Low
var float asiaHiLive = na
var float asiaLoLive = na
var float asiaHiLock = na
var float asiaLoLock = na

if asiaEnd and not na(asiaHiLive) and not na(asiaLoLive)
    asiaHiLock := asiaHiLive
    asiaLoLock := asiaLoLive

if newDay
    asiaHiLive := na
    asiaLoLive := na

if asiaStart
    asiaHiLive := high
    asiaLoLive := low

if inAsia
    asiaHiLive := math.max(nz(asiaHiLive, high), high)
    asiaLoLive := math.min(nz(asiaLoLive, low),  low)

float asiaHiFinal = inAsia ? asiaHiLive : asiaHiLock
float asiaLoFinal = inAsia ? asiaLoLive : asiaLoLock

// LIVE London High/Low
var float lonHiLive = na
var float lonLoLive = na
var float lonHiLock = na
var float lonLoLock = na

if newDay
    lonHiLive := na
    lonLoLive := na

if lonStart
    lonHiLive := high
    lonLoLive := low

if inLondon
    lonHiLive := math.max(nz(lonHiLive, high), high)
    lonLoLive := math.min(nz(lonLoLive, low),  low)

if lonEnd and not na(lonHiLive) and not na(lonLoLive)
    lonHiLock := lonHiLive
    lonLoLock := lonLoLive

float lonHiFinal = inLondon ? lonHiLive : lonHiLock
float lonLoFinal = inLondon ? lonLoLive : lonLoLock

// Session opens (PT timezone)
y = year(time, "America/Los_Angeles")
m = month(time, "America/Los_Angeles")
d = dayofmonth(time, "America/Los_Angeles")

ts0630 = timestamp("America/Los_Angeles", y, m, d, 6, 30)
ts1500 = timestamp("America/Los_Angeles", y, m, d, 15, 0)
ts0000 = timestamp("America/Los_Angeles", y, m, d, 0, 0)

cross0630 = (time >= ts0630) and (nz(time[1]) < ts0630)
cross1500 = (time >= ts1500) and (nz(time[1]) < ts1500)
cross0000 = (time >= ts0000) and (nz(time[1]) < ts0000)

var float nyOpen = na
var float pm3Open = na
var float midnightOpen = na

if cross0630
    nyOpen := open

if cross1500
    pm3Open := open

if cross0000
    midnightOpen := open

//══════════════════════════════════════════════════════════════════════════════
// DAY TYPE DETECTION (Trend Up, Inside Day, Trend Down)
//══════════════════════════════════════════════════════════════════════════════

// Compare current day's range to previous day
bool isTrendDayUp   = mtfD_high > mtfD_prevHigh and mtfD_low >= mtfD_prevLow and mtfD_close > mtfD_open
bool isTrendDayDown = mtfD_low < mtfD_prevLow and mtfD_high <= mtfD_prevHigh and mtfD_close < mtfD_open
bool isInsideDay    = mtfD_high <= mtfD_prevHigh and mtfD_low >= mtfD_prevLow
bool isOutsideDay   = mtfD_high > mtfD_prevHigh and mtfD_low < mtfD_prevLow

string dayType = isInsideDay ? "Inside Day" :
                 isTrendDayUp ? "Trend Day UP" :
                 isTrendDayDown ? "Trend Day DOWN" :
                 isOutsideDay ? "Outside Day" :
                 mtfD_close > mtfD_open ? "Developing UP" : "Developing DOWN"

color dayTypeColor = isInsideDay ? color.yellow :
                     isTrendDayUp or dayType == "Developing UP" ? color.green :
                     isTrendDayDown or dayType == "Developing DOWN" ? color.red :
                     color.orange

//══════════════════════════════════════════════════════════════════════════════
// HTF BIAS SYSTEM (Daily → 4HR Alignment)
//══════════════════════════════════════════════════════════════════════════════

// Daily Bias: Based on price position relative to PDH/PDL and current day direction
int dailyBias = 0
if not na(pdh) and not na(pdl)
    if close > pdh
        dailyBias := 1  // Bullish - trading above prior day high
    else if close < pdl
        dailyBias := -1 // Bearish - trading below prior day low
    else if close > f_getMidpoint(pdh, pdl)
        dailyBias := 1  // Lean bullish - above midpoint
    else
        dailyBias := -1 // Lean bearish - below midpoint

// Also consider daily candle direction
if isTrendDayUp
    dailyBias := 1
else if isTrendDayDown
    dailyBias := -1

string dailyBiasText = dailyBias == 1 ? "BULLISH" : dailyBias == -1 ? "BEARISH" : "NEUTRAL"
color dailyBiasColor = dailyBias == 1 ? color.green : dailyBias == -1 ? color.red : color.gray

//══════════════════════════════════════════════════════════════════════════════
// 4HR RE-TRIGGER STRATEGY (Core Focus)
//══════════════════════════════════════════════════════════════════════════════

var float r4_entry_level = na      // Entry trigger level
var float r4_exit_level = na       // Exit/stop level
var float r4_target_level = na     // Target level
var int r4_setup_bias = 0          // Setup-specific bias: 1=bullish setup, -1=bearish setup
var string r4_pattern = "Scanning"
var bool r4_triggered = false
var int r4_setup_bar = 0
var bool r4_entry_label_drawn = false  // Track if we already drew entry label for this setup

// Detect new 4HR candle
bool new4HCandle = ta.change(mtf4H_time) != 0

// Get 4HR bar types
int bar4H_current = f_getBarType(mtf4H_high, mtf4H_low, mtf4H_close, mtf4H_open, mtf4H_prevHigh, mtf4H_prevLow)
int bar4H_prev = f_getBarType(mtf4H_prevHigh, mtf4H_prevLow, mtf4H_prevClose, mtf4H_prevOpen, mtf4H_prev2High, mtf4H_prev2Low)

//══════════════════════════════════════════════════════════════════════════════
// 4HR MARKET BIAS (Continuous - Always calculated based on current conditions)
//══════════════════════════════════════════════════════════════════════════════

// Calculate continuous 4HR market bias based on multiple factors:
// 1. Current 4HR candle direction
// 2. Price position (above prior high = bullish momentum)
// 3. Bar type patterns (2UP = bullish, 2DOWN = bearish)
// 4. Close relative to prior candle range

int r4_market_bias = 0

// Factor 1: Current 4HR candle is bullish/bearish
bool r4_candle_bullish = mtf4H_close > mtf4H_open
bool r4_candle_bearish = mtf4H_close < mtf4H_open

// Factor 2: Breaking out of prior candle range
bool r4_above_prior_high = mtf4H_close > mtf4H_prevHigh
bool r4_below_prior_low = mtf4H_close < mtf4H_prevLow

// Factor 3: Current bar type indicates momentum
bool r4_is_2up = bar4H_current == 2
bool r4_is_2down = bar4H_current == -2

// Factor 4: Close position within current candle and prior range
float r4_prior_mid = f_getMidpoint(mtf4H_prevHigh, mtf4H_prevLow)
bool r4_close_above_prior_mid = mtf4H_close > r4_prior_mid
bool r4_close_below_prior_mid = mtf4H_close < r4_prior_mid

// Calculate market bias score
int r4_bias_score = 0

// Strong bullish signals
if r4_above_prior_high
    r4_bias_score += 2
if r4_is_2up
    r4_bias_score += 2
if r4_candle_bullish
    r4_bias_score += 1
if r4_close_above_prior_mid
    r4_bias_score += 1

// Strong bearish signals
if r4_below_prior_low
    r4_bias_score -= 2
if r4_is_2down
    r4_bias_score -= 2
if r4_candle_bearish
    r4_bias_score -= 1
if r4_close_below_prior_mid
    r4_bias_score -= 1

// Determine market bias from score
// Score >= 2: Bullish, Score <= -2: Bearish, else: Neutral
if r4_bias_score >= 2
    r4_market_bias := 1
else if r4_bias_score <= -2
    r4_market_bias := -1
else
    r4_market_bias := 0

// For HTF alignment purposes, use market bias (which is always calculated)
// r4_bias is used for dashboard and alignment - it reflects CURRENT market conditions
int r4_bias = r4_market_bias

if new4HCandle
    // Check for reversal patterns (2DOWN→2UP or 2UP→2DOWN)
    bool bullishReversal = (bar4H_prev == -2 and bar4H_current == 2)  // 2DOWN then 2UP
    bool bearishReversal = (bar4H_prev == 2 and bar4H_current == -2)  // 2UP then 2DOWN

    // Also detect continuation patterns when aligned with HTF
    bool bullishContinuation = (bar4H_current == 2 and dailyBias == 1)  // 2UP with daily bullish
    bool bearishContinuation = (bar4H_current == -2 and dailyBias == -1)  // 2DOWN with daily bearish

    // Only create new setups if NOT already in an active trade
    if not r4_triggered
        if bullishReversal
            r4_entry_level := mtf4H_prevHigh  // Break above the 2DOWN high for entry
            // Tight stop based on 30min/1HR structure (lowest of recent lows)
            float tight_stop = math.max(mtf30_prevLow, math.max(mtf30_low, mtf1H_low))
            r4_exit_level := tight_stop
            // Target: nearest bearish OB above (where liquidity/sells are), or fallback to 2:1
            if not na(nearest_bear_ob_above)
                r4_target_level := nearest_bear_ob_above
            else
                r4_target_level := r4_entry_level + (r4_entry_level - r4_exit_level) * 2
            r4_setup_bias := 1
            r4_pattern := "2DOWN→2UP (LONG)"
            r4_entry_label_drawn := false
            r4_setup_bar := bar_index

        else if bearishReversal
            r4_entry_level := mtf4H_prevLow   // Break below the 2UP low for entry
            // Tight stop based on 30min/1HR structure (highest of recent highs)
            float tight_stop = math.min(mtf30_prevHigh, math.min(mtf30_high, mtf1H_high))
            r4_exit_level := tight_stop
            // Target: nearest bullish OB below (where liquidity/buys are), or fallback to 2:1
            if not na(nearest_bull_ob_below)
                r4_target_level := nearest_bull_ob_below
            else
                r4_target_level := r4_entry_level - (r4_exit_level - r4_entry_level) * 2
            r4_setup_bias := -1
            r4_pattern := "2UP→2DOWN (SHORT)"
            r4_entry_label_drawn := false
            r4_setup_bar := bar_index

        // Continuation setups - only if no existing setup
        else if bullishContinuation and r4_setup_bias != 1
            // Set entry at current 30min/1HR low for pullback entry
            r4_entry_level := math.min(mtf30_low, mtf1H_low)
            // Tight stop just below the entry structure
            r4_exit_level := math.max(mtf30_prevLow, mtf30_low) - syminfo.mintick
            if not na(nearest_bear_ob_above)
                r4_target_level := nearest_bear_ob_above
            else
                r4_target_level := r4_entry_level + (r4_entry_level - r4_exit_level) * 2
            r4_setup_bias := 1
            r4_pattern := "HTF ALIGNED LONG"
            r4_entry_label_drawn := false
            r4_setup_bar := bar_index

        else if bearishContinuation and r4_setup_bias != -1
            // Set entry at current 30min/1HR high for pullback entry
            r4_entry_level := math.max(mtf30_high, mtf1H_high)
            // Tight stop just above the entry structure
            r4_exit_level := math.min(mtf30_prevHigh, mtf30_high) + syminfo.mintick
            if not na(nearest_bull_ob_below)
                r4_target_level := nearest_bull_ob_below
            else
                r4_target_level := r4_entry_level - (r4_exit_level - r4_entry_level) * 2
            r4_setup_bias := -1
            r4_pattern := "HTF ALIGNED SHORT"
            r4_entry_label_drawn := false
            r4_setup_bar := bar_index

// Entry triggers (check on every bar) - use r4_setup_bias for setup tracking
if not na(r4_entry_level) and not r4_triggered
    if r4_setup_bias == 1 and close > r4_entry_level
        r4_triggered := true
        r4_pattern := "LONG ACTIVE"

        // Only draw label once per setup
        if showPatterns and not r4_entry_label_drawn
            label.new(bar_index, low, "LONG @ " + str.tostring(close, format.mintick),
                     style=label.style_label_up, color=color.new(color.lime, 30),
                     textcolor=color.white, size=size.small)
            r4_entry_label_drawn := true

    else if r4_setup_bias == -1 and close < r4_entry_level
        r4_triggered := true
        r4_pattern := "SHORT ACTIVE"

        // Only draw label once per setup
        if showPatterns and not r4_entry_label_drawn
            label.new(bar_index, high, "SHORT @ " + str.tostring(close, format.mintick),
                     style=label.style_label_down, color=color.new(color.maroon, 30),
                     textcolor=color.white, size=size.small)
            r4_entry_label_drawn := true

// Dynamically update target based on nearest OB (liquidity target)
if r4_setup_bias == 1 and not na(nearest_bear_ob_above)
    // For LONG: target the nearest RED OB above (where sell liquidity is)
    r4_target_level := nearest_bear_ob_above
else if r4_setup_bias == -1 and not na(nearest_bull_ob_below)
    // For SHORT: target the nearest GREEN OB below (where buy liquidity is)
    r4_target_level := nearest_bull_ob_below

//══════════════════════════════════════════════════════════════════════════════
// PULLBACK RE-ENTRY LEVELS (For active trades - dynamic entries)
//══════════════════════════════════════════════════════════════════════════════

var float reentry_level = na
var string reentry_type = "N/A"

// 1HR data for shorter-term pullback detection
[mtf1H_prevHigh, mtf1H_prevLow, mtf1H_prevClose, mtf1H_prevOpen] =
     request.security(syminfo.tickerid, "60", [high[1], low[1], close[1], open[1]],
     lookahead=barmerge.lookahead_off)

[mtf1H_prev2High, mtf1H_prev2Low] =
     request.security(syminfo.tickerid, "60", [high[2], low[2]],
     lookahead=barmerge.lookahead_off)

// Get 1HR bar type
int bar1H_current = f_getBarType(mtf1H_high, mtf1H_low, mtf1H_close, mtf1H_open, mtf1H_prevHigh, mtf1H_prevLow)
int bar1H_prev = f_getBarType(mtf1H_prevHigh, mtf1H_prevLow, mtf1H_prevClose, mtf1H_prevOpen, mtf1H_prev2High, mtf1H_prev2Low)

// Detect new 1HR candle
bool new1HCandle = ta.change(mtf1H_time) != 0

// Track recent swing lows/highs for pullback entries
var float recent_swing_low = na
var float recent_swing_high = na

// Update swing points on 1HR timeframe
if new1HCandle
    // Detect swing low: previous candle low is lower than candles on either side
    if mtf1H_prevLow < mtf1H_prev2Low and mtf1H_prevLow < mtf1H_low
        recent_swing_low := mtf1H_prevLow
    // Detect swing high: previous candle high is higher than candles on either side
    if mtf1H_prevHigh > mtf1H_prev2High and mtf1H_prevHigh > mtf1H_high
        recent_swing_high := mtf1H_prevHigh

// Calculate pullback re-entry levels when trade is active
if r4_triggered
    if r4_setup_bias == 1
        // LONG ACTIVE: Look for pullback entries
        // Re-entry options (in priority order):
        // 1. Nearest bullish OB below current price (support zone)
        // 2. Recent 1HR swing low
        // 3. Current 1HR candle low (aggressive)

        if not na(nearest_bull_ob_below) and nearest_bull_ob_below > r4_exit_level
            reentry_level := nearest_bull_ob_below
            reentry_type := "OB Support"
        else if not na(recent_swing_low) and recent_swing_low > r4_exit_level and recent_swing_low < close
            reentry_level := recent_swing_low
            reentry_type := "Swing Low"
        else
            // Use recent 1HR low as aggressive re-entry
            reentry_level := mtf1H_low
            reentry_type := "1HR Low"

    else if r4_setup_bias == -1
        // SHORT ACTIVE: Look for pullback entries
        if not na(nearest_bear_ob_above) and nearest_bear_ob_above < r4_exit_level
            reentry_level := nearest_bear_ob_above
            reentry_type := "OB Resistance"
        else if not na(recent_swing_high) and recent_swing_high < r4_exit_level and recent_swing_high > close
            reentry_level := recent_swing_high
            reentry_type := "Swing High"
        else
            reentry_level := mtf1H_high
            reentry_type := "1HR High"
else
    // No active trade - re-entry is same as entry
    if r4_setup_bias != 0 and not na(r4_entry_level)
        reentry_level := r4_entry_level
        reentry_type := "Setup Entry"
    else
        reentry_level := na
        reentry_type := "N/A"

// Check for stop hit or target reached
if r4_triggered
    if r4_setup_bias == 1
        if close <= r4_exit_level
            r4_pattern := "STOPPED OUT"
            r4_triggered := false
            r4_setup_bias := 0  // Only reset setup bias, not market bias
        else if close >= r4_target_level
            r4_pattern := "TARGET HIT"
            r4_triggered := false
            r4_setup_bias := 0  // Only reset setup bias, not market bias
    else if r4_setup_bias == -1
        if close >= r4_exit_level
            r4_pattern := "STOPPED OUT"
            r4_triggered := false
            r4_setup_bias := 0
        else if close <= r4_target_level
            r4_pattern := "TARGET HIT"
            r4_triggered := false
            r4_setup_bias := 0

// 4HR Bias text
string r4_biasText = r4_bias == 1 ? "BULLISH" : r4_bias == -1 ? "BEARISH" : "NEUTRAL"
color r4_biasColor = r4_bias == 1 ? color.green : r4_bias == -1 ? color.red : color.gray

//══════════════════════════════════════════════════════════════════════════════
// HTF ALIGNMENT CHECK (using market bias which is always calculated)
//══════════════════════════════════════════════════════════════════════════════

bool htfAligned = (dailyBias == r4_market_bias) and r4_market_bias != 0
bool htfConflict = (dailyBias != r4_market_bias) and dailyBias != 0 and r4_market_bias != 0

string alignmentText = htfAligned ? "ALIGNED" : htfConflict ? "CONFLICT" : "WAITING"
color alignmentColor = htfAligned ? color.green : htfConflict ? color.red : color.yellow

//══════════════════════════════════════════════════════════════════════════════
// GPS STATE: GO, Chop, Wait For Entry Level
//══════════════════════════════════════════════════════════════════════════════

string gpsState = "WAIT"
color gpsColor = color.yellow
string gpsDirection = ""

if r4_triggered and htfAligned
    // Active trade with HTF alignment = GO
    gpsState := "GO"
    gpsColor := r4_setup_bias == 1 ? color.green : color.red
    gpsDirection := r4_setup_bias == 1 ? "LONG ↑" : "SHORT ↓"
else if r4_triggered and htfConflict
    // Active trade but HTF conflict = CHOP warning
    gpsState := "CHOP"
    gpsColor := color.orange
    gpsDirection := r4_setup_bias == 1 ? "LONG (Caution)" : "SHORT (Caution)"
else if not na(r4_entry_level) and not r4_triggered and r4_setup_bias != 0
    // Setup active, waiting for entry
    gpsState := "WAIT FOR ENTRY"
    gpsColor := color.yellow
    if r4_setup_bias == 1
        gpsDirection := "Watch " + str.tostring(r4_entry_level, format.mintick) + " ↑"
    else
        gpsDirection := "Watch " + str.tostring(r4_entry_level, format.mintick) + " ↓"
else if htfAligned
    // No active setup but HTF aligned - show the directional bias
    gpsState := "WAIT FOR ENTRY"
    gpsColor := r4_market_bias == 1 ? color.green : color.red
    if r4_market_bias == 1
        gpsDirection := "BULLISH BIAS ↑ - Wait for pullback"
    else
        gpsDirection := "BEARISH BIAS ↓ - Wait for pullback"
else if isInsideDay
    // Inside day = expect chop
    gpsState := "CHOP"
    gpsColor := color.orange
    gpsDirection := "Inside Day - Range Bound"
else if r4_market_bias != 0 and dailyBias != 0
    // Market has direction but conflicting with HTF
    gpsState := "CHOP"
    gpsColor := color.orange
    gpsDirection := "HTF Conflict - Be Cautious"
else
    // Truly neutral - no clear direction
    gpsState := "WAIT"
    gpsColor := color.gray
    gpsDirection := "No Clear Bias"

//══════════════════════════════════════════════════════════════════════════════
// NEAREST KEY LEVEL & PRICE TARGET
//══════════════════════════════════════════════════════════════════════════════

var array<float> keyLevels = array.new<float>()
var array<string> keyLabels = array.new<string>()

if barstate.islast
    array.clear(keyLevels)
    array.clear(keyLabels)

    if not na(pdh)
        array.push(keyLevels, pdh)
        array.push(keyLabels, "PDH")

    if not na(pdl)
        array.push(keyLevels, pdl)
        array.push(keyLabels, "PDL")

    if not na(nyOpen)
        array.push(keyLevels, nyOpen)
        array.push(keyLabels, "NY Open")

    if not na(asiaHiFinal)
        array.push(keyLevels, asiaHiFinal)
        array.push(keyLabels, "Asia High")

    if not na(asiaLoFinal)
        array.push(keyLevels, asiaLoFinal)
        array.push(keyLabels, "Asia Low")

    if not na(lonHiFinal)
        array.push(keyLevels, lonHiFinal)
        array.push(keyLabels, "London High")

    if not na(lonLoFinal)
        array.push(keyLevels, lonLoFinal)
        array.push(keyLabels, "London Low")

    // Add 4HR entry/exit levels if active
    if not na(r4_entry_level) and r4_setup_bias != 0
        array.push(keyLevels, r4_entry_level)
        array.push(keyLabels, "4HR Entry")

    if not na(r4_exit_level) and r4_setup_bias != 0
        array.push(keyLevels, r4_exit_level)
        array.push(keyLabels, "4HR Stop")

// Find nearest level above and below
string nearestAbove = "None"
string nearestBelow = "None"
float nearestAbovePrice = na
float nearestBelowPrice = na
float minDistAbove = 999999.0
float minDistBelow = 999999.0

if array.size(keyLevels) > 0
    for i = 0 to array.size(keyLevels) - 1
        float lvl = array.get(keyLevels, i)
        if not na(lvl)
            if lvl > close and (lvl - close) < minDistAbove
                minDistAbove := lvl - close
                nearestAbovePrice := lvl
                nearestAbove := array.get(keyLabels, i)
            else if lvl < close and (close - lvl) < minDistBelow
                minDistBelow := close - lvl
                nearestBelowPrice := lvl
                nearestBelow := array.get(keyLabels, i)

string priceTarget = dailyBias == 1 ? nearestAbove + " ↑" : dailyBias == -1 ? nearestBelow + " ↓" : "Neutral"

//══════════════════════════════════════════════════════════════════════════════
// TIME PREFERENCE
//══════════════════════════════════════════════════════════════════════════════

currentHour = hour(time, TZ)
pref = currentHour >= 9 and currentHour < 11 ? "Prime" :
       currentHour >= 11 and currentHour < 15 ? "Active" :
       currentHour >= 15 or currentHour < 9 ? "Off-Hours" : "Other"
prefColor = pref == "Prime" ? color.green : pref == "Active" ? color.yellow : color.gray

//══════════════════════════════════════════════════════════════════════════════
// VOLUME EXPANSION/COMPRESSION INDICATOR
//══════════════════════════════════════════════════════════════════════════════

// Compare current volume to average volume
int volPeriod = 20
float avgVolume = ta.sma(volume, volPeriod)
float volRatio = volume / avgVolume

// Determine volume state
string volState = "NORMAL"
color volStateColor = color.gray

if volRatio >= 2.0
    volState := "EXPANSION"
    volStateColor := color.green
else if volRatio >= 1.5
    volState := "RISING"
    volStateColor := color.lime
else if volRatio <= 0.5
    volState := "COMPRESSION"
    volStateColor := color.orange
else if volRatio <= 0.75
    volState := "DECLINING"
    volStateColor := color.yellow
else
    volState := "NORMAL"
    volStateColor := color.gray

// Track consecutive compression/expansion bars
var int compressionBars = 0
var int expansionBars = 0

if volRatio <= 0.75
    compressionBars += 1
    expansionBars := 0
else if volRatio >= 1.5
    expansionBars += 1
    compressionBars := 0
else
    compressionBars := math.max(0, compressionBars - 1)
    expansionBars := math.max(0, expansionBars - 1)

// Compression often precedes expansion (breakout)
bool compressionAlert = compressionBars >= 3
bool expansionAlert = expansionBars >= 2

//══════════════════════════════════════════════════════════════════════════════
// CONFIDENCE LEVEL CALCULATION
//══════════════════════════════════════════════════════════════════════════════

// Calculate confidence based on multiple factors aligning
int confidenceScore = 0
int maxConfidence = 10

// Factor 1: Daily and 4HR bias alignment (+3)
if htfAligned
    confidenceScore += 3

// Factor 2: Day type supports direction (+2)
if (r4_market_bias == 1 and (isTrendDayUp or dayType == "Developing UP")) or
   (r4_market_bias == -1 and (isTrendDayDown or dayType == "Developing DOWN"))
    confidenceScore += 2

// Factor 3: Volume supports move (+2)
if (r4_market_bias != 0 and volRatio >= 1.5)
    confidenceScore += 2
else if compressionBars >= 3  // Compression = potential breakout
    confidenceScore += 1

// Factor 4: Bar type momentum (+2)
if (r4_market_bias == 1 and bar4H_current == 2) or (r4_market_bias == -1 and bar4H_current == -2)
    confidenceScore += 2

// Factor 5: Prime trading time (+1)
if pref == "Prime"
    confidenceScore += 1

// Confidence percentage
int confidencePct = math.round(confidenceScore * 100 / maxConfidence)
string confidenceText = str.tostring(confidencePct) + "%"
color confidenceColor = confidencePct >= 70 ? color.green : confidencePct >= 50 ? color.yellow : confidencePct >= 30 ? color.orange : color.red

//══════════════════════════════════════════════════════════════════════════════
// CHOP DETECTION (Improved)
//══════════════════════════════════════════════════════════════════════════════

// Chop indicators:
// 1. Inside day
// 2. HTF conflict
// 3. Volume compression
// 4. Price oscillating within range

bool isChoppy = false
string chopReason = ""

if isInsideDay
    isChoppy := true
    chopReason := "Inside Day"
else if htfConflict
    isChoppy := true
    chopReason := "HTF Conflict"
else if compressionBars >= 3
    isChoppy := true
    chopReason := "Vol Compression"
else if r4_market_bias == 0 and dailyBias == 0
    isChoppy := true
    chopReason := "No Clear Direction"

// Update GPS state for chop
if isChoppy and gpsState != "GO"
    gpsState := "CHOP"
    gpsColor := color.orange
    if chopReason != ""
        gpsDirection := chopReason

//══════════════════════════════════════════════════════════════════════════════
// DASHBOARD TABLE
//══════════════════════════════════════════════════════════════════════════════

if showDashboard and barstate.islast
    var table dashboard = table.new(
         position=dashPosition == "top_left" ? position.top_left :
                  dashPosition == "top_center" ? position.top_center :
                  dashPosition == "top_right" ? position.top_right :
                  dashPosition == "middle_left" ? position.middle_left :
                  dashPosition == "middle_center" ? position.middle_center :
                  dashPosition == "middle_right" ? position.middle_right :
