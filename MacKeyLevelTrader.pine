//@version=5
indicator("MAC Key Level Trader V1", overlay=true, max_labels_count=500, max_boxes_count=500, max_lines_count=500)

//==============================================================================
// MAC KEY LEVEL TRADER - Intraday GPS for Price
// Dashboard shows: Daily/4HR/1HR Bias -> Key Levels -> Signals -> RSI
//==============================================================================

//==============================================================================
// INPUTS & SETTINGS
//==============================================================================

// Key Levels
showMonthly = input.bool(true, "Show Monthly H/L", group="Key Levels")
showWeekly  = input.bool(true, "Show Weekly H/L", group="Key Levels")
showDaily   = input.bool(true, "Show Daily H/L", group="Key Levels")
show4HR     = input.bool(true, "Show 4HR H/L", group="Key Levels")
show1HR     = input.bool(true, "Show 1HR H/L", group="Key Levels")

// Inside Bar Settings
showInsideBar50 = input.bool(true, "Show Inside Bar 50% Level", group="Inside Bar")
insideBarColor  = input.color(color.new(color.fuchsia, 20), "Inside Bar 50% Color", group="Inside Bar")

// RSI Settings
rsiLength       = input.int(14, "RSI Period", minval=1, group="RSI")
rsiOverbought   = input.int(77, "RSI Overbought Level", minval=60, maxval=90, group="RSI")
rsiOversold     = input.int(22, "RSI Oversold Level", minval=10, maxval=40, group="RSI")
showRSIDashboard = input.bool(true, "Show RSI Dashboard", group="RSI")

// Order Block Settings (LuxAlgo style)
obEnabled       = input.bool(true, "Enable Order Blocks", group="Order Blocks")
obLength        = input.int(5, "OB Pivot Length", minval=1, group="Order Blocks")
obBullCount     = input.int(3, "Max Bullish OBs", minval=1, maxval=10, group="Order Blocks")
obBearCount     = input.int(3, "Max Bearish OBs", minval=1, maxval=10, group="Order Blocks")
obBullBgColor   = input.color(color.new(#169400, 80), "Bullish OB Fill", group="Order Blocks")
obBullBorderColor = input.color(#169400, "Bullish OB Border", group="Order Blocks")
obBearBgColor   = input.color(color.new(#ff1100, 80), "Bearish OB Fill", group="Order Blocks")
obBearBorderColor = input.color(#ff1100, "Bearish OB Border", group="Order Blocks")
obAvgColor      = input.color(color.new(#9598a1, 37), "OB 50% Line", group="Order Blocks")
obMitigation    = input.string("Wick", "Mitigation Method", options=["Wick", "Close"], group="Order Blocks")

// FVG Settings
fvgEnabled      = input.bool(true, "Enable FVGs", group="Fair Value Gaps")
fvgBullCount    = input.int(3, "Max Bullish FVGs", minval=1, maxval=10, group="Fair Value Gaps")
fvgBearCount    = input.int(3, "Max Bearish FVGs", minval=1, maxval=10, group="Fair Value Gaps")
fvgBullColor    = input.color(color.new(#00bcd4, 80), "Bullish FVG Color", group="Fair Value Gaps")
fvgBearColor    = input.color(color.new(#ff9800, 80), "Bearish FVG Color", group="Fair Value Gaps")
fvgMitigation   = input.string("Wick", "FVG Mitigation", options=["Wick", "Close", "Half"], group="Fair Value Gaps")

// 4HR 2-2 Combo Settings
combo22Enabled  = input.bool(true, "Enable 4HR 2-2 Combo", group="4HR 2-2 Combo")
volMultiplier   = input.float(1.5, "Volume Multiplier", minval=1.0, maxval=3.0, step=0.1, group="4HR 2-2 Combo")
volEMALen       = input.int(20, "Volume EMA Length", minval=5, group="4HR 2-2 Combo")

// Signal Settings
showSignals     = input.bool(true, "Show Entry Signals", group="Signals")
showTierLabels  = input.bool(true, "Show Tier Labels", group="Signals")

// Dashboard Settings
showDashboard   = input.bool(true, "Show Main Dashboard", group="Dashboard")
dashPosition    = input.string("top_right", "Dashboard Position", options=["top_left", "top_center", "top_right", "middle_left", "middle_center", "middle_right", "bottom_left", "bottom_center", "bottom_right"], group="Dashboard")
dashSize        = input.string("small", "Dashboard Size", options=["tiny", "small", "normal", "large"], group="Dashboard")

//==============================================================================
// HELPER FUNCTIONS
//==============================================================================

f_getMidpoint(_high, _low) =>
    (_high + _low) / 2.0

// Bias calculation - more intuitive: close vs close[1] AND bar color
// BULLISH: Close > previous close AND green bar (close > open) OR breaking out above prev high
// BEARISH: Close < previous close AND red bar (close < open) OR breaking down below prev low
f_getBias(_close, _open, _prevClose, _prevHigh, _prevLow) =>
    int result = 0
    if _close > _prevHigh
        result := 1
    else if _close < _prevLow
        result := -1
    else if _close > _prevClose and _close > _open
        result := 1
    else if _close < _prevClose and _close < _open
        result := -1
    result

// Get line style
f_getLineStyle(style) =>
    style == "----" ? line.style_dashed : style == "...." ? line.style_dotted : line.style_solid

//==============================================================================
// MULTI-TIMEFRAME DATA
//==============================================================================

// Daily data for bias
[d_close, d_open, d_close_1, d_high_1, d_low_1] = request.security(syminfo.tickerid, "D", [close, open, close[1], high[1], low[1]], lookahead=barmerge.lookahead_off)
dailyBias = f_getBias(d_close, d_open, d_close_1, d_high_1, d_low_1)

// 4HR data for bias
[h4_close, h4_open, h4_close_1, h4_high_1, h4_low_1] = request.security(syminfo.tickerid, "240", [close, open, close[1], high[1], low[1]], lookahead=barmerge.lookahead_off)
h4Bias = f_getBias(h4_close, h4_open, h4_close_1, h4_high_1, h4_low_1)

// 1HR data for bias
[h1_close, h1_open, h1_close_1, h1_high_1, h1_low_1] = request.security(syminfo.tickerid, "60", [close, open, close[1], high[1], low[1]], lookahead=barmerge.lookahead_off)
h1Bias = f_getBias(h1_close, h1_open, h1_close_1, h1_high_1, h1_low_1)

// 30min data for bias
[m30_close, m30_open, m30_close_1, m30_high_1, m30_low_1] = request.security(syminfo.tickerid, "30", [close, open, close[1], high[1], low[1]], lookahead=barmerge.lookahead_off)
m30Bias = f_getBias(m30_close, m30_open, m30_close_1, m30_high_1, m30_low_1)

// 15min data for bias
[m15_close, m15_open, m15_close_1, m15_high_1, m15_low_1] = request.security(syminfo.tickerid, "15", [close, open, close[1], high[1], low[1]], lookahead=barmerge.lookahead_off)
m15Bias = f_getBias(m15_close, m15_open, m15_close_1, m15_high_1, m15_low_1)

// 3min data for bias
[m3_close, m3_open, m3_close_1, m3_high_1, m3_low_1] = request.security(syminfo.tickerid, "3", [close, open, close[1], high[1], low[1]], lookahead=barmerge.lookahead_off)
m3Bias = f_getBias(m3_close, m3_open, m3_close_1, m3_high_1, m3_low_1)

//==============================================================================
// RSI MULTI-TIMEFRAME
//==============================================================================

rsi15m = request.security(syminfo.tickerid, "15", ta.rsi(close, rsiLength), lookahead=barmerge.lookahead_off)
rsi30m = request.security(syminfo.tickerid, "30", ta.rsi(close, rsiLength), lookahead=barmerge.lookahead_off)
rsi1H = request.security(syminfo.tickerid, "60", ta.rsi(close, rsiLength), lookahead=barmerge.lookahead_off)

allRSIOversold  = rsi15m <= rsiOversold and rsi30m <= rsiOversold and rsi1H <= rsiOversold
allRSIOverbought = rsi15m >= rsiOverbought and rsi30m >= rsiOverbought and rsi1H >= rsiOverbought

//==============================================================================
// KEY LEVELS
//==============================================================================

// Previous Monthly High/Low
[pmh, pml] = request.security(syminfo.tickerid, "M", [high[1], low[1]], lookahead=barmerge.lookahead_on)

// Previous Weekly High/Low
[pwh, pwl] = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead=barmerge.lookahead_on)

// Previous Daily High/Low
newDay = ta.change(time("D")) != 0
var float dayHi = na
var float dayLo = na
var float pdh = na
var float pdl = na

if newDay
    pdh := dayHi
    pdl := dayLo
    dayHi := high
    dayLo := low
else
    if na(dayHi)
        dayHi := high
        dayLo := low
    else
        dayHi := math.max(dayHi, high)
        dayLo := math.min(dayLo, low)

// Previous 4HR High/Low
[p4hh, p4hl] = request.security(syminfo.tickerid, "240", [high[1], low[1]], lookahead=barmerge.lookahead_off)

// Previous 1HR High/Low
[p1hh, p1hl] = request.security(syminfo.tickerid, "60", [high[1], low[1]], lookahead=barmerge.lookahead_off)

//==============================================================================
// INSIDE BAR DETECTION - Only plot 50% after actual inside day
//==============================================================================

// Get previous 2 days' data to check for inside bar
[d_high_prev, d_low_prev, d_high_prev2, d_low_prev2] = request.security(syminfo.tickerid, "D", [high[1], low[1], high[2], low[2]], lookahead=barmerge.lookahead_on)

// Previous day was inside bar if its high <= day before's high AND its low >= day before's low
prevDayWasInsideBar = d_high_prev <= d_high_prev2 and d_low_prev >= d_low_prev2

// Calculate 50% level of the inside bar day
insideBar50Level = prevDayWasInsideBar ? f_getMidpoint(d_high_prev, d_low_prev) : na
insideBarActive = prevDayWasInsideBar

//==============================================================================
// ORDER BLOCK DETECTION (LuxAlgo Method)
//==============================================================================

var ob_bull_top  = array.new_float(0)
var ob_bull_btm  = array.new_float(0)
var ob_bull_avg  = array.new_float(0)
var ob_bull_left = array.new_int(0)

var ob_bear_top  = array.new_float(0)
var ob_bear_btm  = array.new_float(0)
var ob_bear_avg  = array.new_float(0)
var ob_bear_left = array.new_int(0)

var os_ob = 0
upper_ob = ta.highest(obLength)
lower_ob = ta.lowest(obLength)

target_bull = obMitigation == "Close" ? ta.lowest(close, obLength) : lower_ob
target_bear = obMitigation == "Close" ? ta.highest(close, obLength) : upper_ob

os_ob := high[obLength] > upper_ob ? 0 : low[obLength] < lower_ob ? 1 : os_ob[1]

phv = ta.pivothigh(volume, obLength, obLength)

// Detect and store bullish order block
bull_ob_signal = obEnabled and phv and os_ob == 1
if bull_ob_signal
    avg = math.avg(hl2[obLength], low[obLength])
    array.unshift(ob_bull_top, hl2[obLength])
    array.unshift(ob_bull_btm, low[obLength])
    array.unshift(ob_bull_avg, avg)
    array.unshift(ob_bull_left, time[obLength])

// Detect and store bearish order block
bear_ob_signal = obEnabled and phv and os_ob == 0
if bear_ob_signal
    avg = math.avg(high[obLength], hl2[obLength])
    array.unshift(ob_bear_top, high[obLength])
    array.unshift(ob_bear_btm, hl2[obLength])
    array.unshift(ob_bear_avg, avg)
    array.unshift(ob_bear_left, time[obLength])

// Remove mitigated bullish OBs
if array.size(ob_bull_btm) > 0
    for i = array.size(ob_bull_btm) - 1 to 0
        if i < array.size(ob_bull_btm)
            if target_bull < array.get(ob_bull_btm, i)
                array.remove(ob_bull_top, i)
                array.remove(ob_bull_btm, i)
                array.remove(ob_bull_avg, i)
                array.remove(ob_bull_left, i)

// Remove mitigated bearish OBs
if array.size(ob_bear_top) > 0
    for i = array.size(ob_bear_top) - 1 to 0
        if i < array.size(ob_bear_top)
            if target_bear > array.get(ob_bear_top, i)
                array.remove(ob_bear_top, i)
                array.remove(ob_bear_btm, i)
                array.remove(ob_bear_avg, i)
                array.remove(ob_bear_left, i)

// Check if price is in order block
inBullOB = false
inBearOB = false

if array.size(ob_bull_top) > 0
    for i = 0 to math.min(obBullCount - 1, array.size(ob_bull_top) - 1)
        if close >= array.get(ob_bull_btm, i) and close <= array.get(ob_bull_top, i)
            inBullOB := true

if array.size(ob_bear_top) > 0
    for i = 0 to math.min(obBearCount - 1, array.size(ob_bear_top) - 1)
        if close >= array.get(ob_bear_btm, i) and close <= array.get(ob_bear_top, i)
            inBearOB := true

//==============================================================================
// ORDER BLOCK DRAWING (LuxAlgo Method - Pre-create boxes)
//==============================================================================

var array<box> ob_bull_boxes = array.new_box(0)
var array<line> ob_bull_lines = array.new_line(0)
var array<box> ob_bear_boxes = array.new_box(0)
var array<line> ob_bear_lines = array.new_line(0)

// Initialize boxes/lines on first bar
if barstate.isfirst and obEnabled
    for i = 0 to obBullCount - 1
        array.push(ob_bull_boxes, box.new(na, na, na, na, xloc=xloc.bar_time, extend=extend.right, bgcolor=obBullBgColor, border_color=color.new(obBullBorderColor, 70)))
        array.push(ob_bull_lines, line.new(na, na, na, na, xloc=xloc.bar_time, extend=extend.right, color=obAvgColor, style=line.style_dashed))
    for i = 0 to obBearCount - 1
        array.push(ob_bear_boxes, box.new(na, na, na, na, xloc=xloc.bar_time, extend=extend.right, bgcolor=obBearBgColor, border_color=color.new(obBearBorderColor, 70)))
        array.push(ob_bear_lines, line.new(na, na, na, na, xloc=xloc.bar_time, extend=extend.right, color=obAvgColor, style=line.style_dashed))

// Update box positions on last bar
if barstate.islast and obEnabled
    // Update bullish OBs
    if array.size(ob_bull_top) > 0
        for i = 0 to math.min(obBullCount - 1, array.size(ob_bull_top) - 1)
            get_box = array.get(ob_bull_boxes, i)
            get_line = array.get(ob_bull_lines, i)
            box.set_lefttop(get_box, array.get(ob_bull_left, i), array.get(ob_bull_top, i))
            box.set_rightbottom(get_box, array.get(ob_bull_left, i), array.get(ob_bull_btm, i))
            line.set_xy1(get_line, array.get(ob_bull_left, i), array.get(ob_bull_avg, i))
            line.set_xy2(get_line, array.get(ob_bull_left, i) + 1, array.get(ob_bull_avg, i))

    // Clear unused bullish boxes
    if array.size(ob_bull_top) < obBullCount
        for i = array.size(ob_bull_top) to obBullCount - 1
            box.set_lefttop(array.get(ob_bull_boxes, i), na, na)
            box.set_rightbottom(array.get(ob_bull_boxes, i), na, na)
            line.set_xy1(array.get(ob_bull_lines, i), na, na)
            line.set_xy2(array.get(ob_bear_lines, i), na, na)

    // Update bearish OBs
    if array.size(ob_bear_top) > 0
        for i = 0 to math.min(obBearCount - 1, array.size(ob_bear_top) - 1)
            get_box = array.get(ob_bear_boxes, i)
            get_line = array.get(ob_bear_lines, i)
            box.set_lefttop(get_box, array.get(ob_bear_left, i), array.get(ob_bear_top, i))
            box.set_rightbottom(get_box, array.get(ob_bear_left, i), array.get(ob_bear_btm, i))
            line.set_xy1(get_line, array.get(ob_bear_left, i), array.get(ob_bear_avg, i))
            line.set_xy2(get_line, array.get(ob_bear_left, i) + 1, array.get(ob_bear_avg, i))

    // Clear unused bearish boxes
    if array.size(ob_bear_top) < obBearCount
        for i = array.size(ob_bear_top) to obBearCount - 1
            box.set_lefttop(array.get(ob_bear_boxes, i), na, na)
            box.set_rightbottom(array.get(ob_bear_boxes, i), na, na)
            line.set_xy1(array.get(ob_bear_lines, i), na, na)
            line.set_xy2(array.get(ob_bear_lines, i), na, na)

//==============================================================================
// FAIR VALUE GAP DETECTION & DRAWING
//==============================================================================

var fvg_bull_top  = array.new_float(0)
var fvg_bull_btm  = array.new_float(0)
var fvg_bull_left = array.new_int(0)

var fvg_bear_top  = array.new_float(0)
var fvg_bear_btm  = array.new_float(0)
var fvg_bear_left = array.new_int(0)

// Bullish FVG: gap up (current low > 2 bars ago high)
bullFVGSignal = fvgEnabled and low > high[2]
if bullFVGSignal
    array.unshift(fvg_bull_top, low)
    array.unshift(fvg_bull_btm, high[2])
    array.unshift(fvg_bull_left, time[1])

// Bearish FVG: gap down (current high < 2 bars ago low)
bearFVGSignal = fvgEnabled and high < low[2]
if bearFVGSignal
    array.unshift(fvg_bear_top, low[2])
    array.unshift(fvg_bear_btm, high)
    array.unshift(fvg_bear_left, time[1])

// FVG Mitigation targets
fvg_target_bull = fvgMitigation == "Close" ? close : fvgMitigation == "Half" ? hl2 : low
fvg_target_bear = fvgMitigation == "Close" ? close : fvgMitigation == "Half" ? hl2 : high

// Remove mitigated bullish FVGs
if array.size(fvg_bull_btm) > 0
    for i = array.size(fvg_bull_btm) - 1 to 0
        if i < array.size(fvg_bull_btm)
            if fvg_target_bull < array.get(fvg_bull_btm, i)
                array.remove(fvg_bull_top, i)
                array.remove(fvg_bull_btm, i)
                array.remove(fvg_bull_left, i)

// Remove mitigated bearish FVGs
if array.size(fvg_bear_top) > 0
    for i = array.size(fvg_bear_top) - 1 to 0
        if i < array.size(fvg_bear_top)
            if fvg_target_bear > array.get(fvg_bear_top, i)
                array.remove(fvg_bear_top, i)
                array.remove(fvg_bear_btm, i)
                array.remove(fvg_bear_left, i)

// Check if in FVG
inBullFVG = false
inBearFVG = false

if array.size(fvg_bull_top) > 0
    for i = 0 to math.min(fvgBullCount - 1, array.size(fvg_bull_top) - 1)
        if close >= array.get(fvg_bull_btm, i) and close <= array.get(fvg_bull_top, i)
            inBullFVG := true

if array.size(fvg_bear_top) > 0
    for i = 0 to math.min(fvgBearCount - 1, array.size(fvg_bear_top) - 1)
        if close >= array.get(fvg_bear_btm, i) and close <= array.get(fvg_bear_top, i)
            inBearFVG := true

// FVG Drawing
var array<box> fvg_bull_boxes = array.new_box(0)
var array<box> fvg_bear_boxes = array.new_box(0)

if barstate.isfirst and fvgEnabled
    for i = 0 to fvgBullCount - 1
        array.push(fvg_bull_boxes, box.new(na, na, na, na, xloc=xloc.bar_time, extend=extend.right, bgcolor=fvgBullColor, border_color=color.new(#00bcd4, 50)))
    for i = 0 to fvgBearCount - 1
        array.push(fvg_bear_boxes, box.new(na, na, na, na, xloc=xloc.bar_time, extend=extend.right, bgcolor=fvgBearColor, border_color=color.new(#ff9800, 50)))

if barstate.islast and fvgEnabled
    // Update bullish FVGs
    if array.size(fvg_bull_top) > 0
        for i = 0 to math.min(fvgBullCount - 1, array.size(fvg_bull_top) - 1)
            box.set_lefttop(array.get(fvg_bull_boxes, i), array.get(fvg_bull_left, i), array.get(fvg_bull_top, i))
            box.set_rightbottom(array.get(fvg_bull_boxes, i), array.get(fvg_bull_left, i), array.get(fvg_bull_btm, i))

    if array.size(fvg_bull_top) < fvgBullCount
        for i = array.size(fvg_bull_top) to fvgBullCount - 1
            box.set_lefttop(array.get(fvg_bull_boxes, i), na, na)
            box.set_rightbottom(array.get(fvg_bull_boxes, i), na, na)

    // Update bearish FVGs
    if array.size(fvg_bear_top) > 0
        for i = 0 to math.min(fvgBearCount - 1, array.size(fvg_bear_top) - 1)
            box.set_lefttop(array.get(fvg_bear_boxes, i), array.get(fvg_bear_left, i), array.get(fvg_bear_top, i))
            box.set_rightbottom(array.get(fvg_bear_boxes, i), array.get(fvg_bear_left, i), array.get(fvg_bear_btm, i))

    if array.size(fvg_bear_top) < fvgBearCount
        for i = array.size(fvg_bear_top) to fvgBearCount - 1
            box.set_lefttop(array.get(fvg_bear_boxes, i), na, na)
            box.set_rightbottom(array.get(fvg_bear_boxes, i), na, na)

// Combined zone check
inBullZone = inBullOB or inBullFVG
inBearZone = inBearOB or inBearFVG

//==============================================================================
// 4HR ROB SMITH / THE STRAT COMBO DETECTION
//==============================================================================

// Bar type functions - The Strat methodology
// 1 = Inside bar (trading within previous range)
// 2-Up = Breaks high, holds low (bullish directional)
// 2-Down = Breaks low, holds high (bearish directional)
// 3 = Outside bar (breaks both high and low)

f_isBar1(_high, _low, _prevHigh, _prevLow) =>
    _high <= _prevHigh and _low >= _prevLow

f_isBar2Up(_high, _low, _prevHigh, _prevLow) =>
    _high > _prevHigh and _low >= _prevLow

f_isBar2Down(_high, _low, _prevHigh, _prevLow) =>
    _low < _prevLow and _high <= _prevHigh

f_isBar3(_high, _low, _prevHigh, _prevLow) =>
    _high > _prevHigh and _low < _prevLow

// Get 4HR data for combos (need 5 bars back for some patterns)
[h4_h, h4_l, h4_c, h4_o, h4_vol, h4_time] = request.security(syminfo.tickerid, "240", [high, low, close, open, volume, time], lookahead=barmerge.lookahead_off)
[h4_h1, h4_l1, h4_c1, h4_o1] = request.security(syminfo.tickerid, "240", [high[1], low[1], close[1], open[1]], lookahead=barmerge.lookahead_off)
[h4_h2, h4_l2, h4_c2, h4_o2] = request.security(syminfo.tickerid, "240", [high[2], low[2], close[2], open[2]], lookahead=barmerge.lookahead_off)
[h4_h3, h4_l3, h4_c3, h4_o3] = request.security(syminfo.tickerid, "240", [high[3], low[3], close[3], open[3]], lookahead=barmerge.lookahead_off)
[h4_h4, h4_l4] = request.security(syminfo.tickerid, "240", [high[4], low[4]], lookahead=barmerge.lookahead_off)

h4_volEMA = request.security(syminfo.tickerid, "240", ta.ema(volume, volEMALen), lookahead=barmerge.lookahead_off)
h4_highVol = h4_vol > h4_volEMA * volMultiplier

// Bar classifications for positions [1], [2], [3] (most recent closed bars)
bar1_is1 = f_isBar1(h4_h1, h4_l1, h4_h2, h4_l2)
bar1_is2Up = f_isBar2Up(h4_h1, h4_l1, h4_h2, h4_l2)
bar1_is2Down = f_isBar2Down(h4_h1, h4_l1, h4_h2, h4_l2)
bar1_is3 = f_isBar3(h4_h1, h4_l1, h4_h2, h4_l2)

bar2_is1 = f_isBar1(h4_h2, h4_l2, h4_h3, h4_l3)
bar2_is2Up = f_isBar2Up(h4_h2, h4_l2, h4_h3, h4_l3)
bar2_is2Down = f_isBar2Down(h4_h2, h4_l2, h4_h3, h4_l3)
bar2_is3 = f_isBar3(h4_h2, h4_l2, h4_h3, h4_l3)

bar3_is1 = f_isBar1(h4_h3, h4_l3, h4_h4, h4_l4)
bar3_is2Up = f_isBar2Up(h4_h3, h4_l3, h4_h4, h4_l4)
bar3_is2Down = f_isBar2Down(h4_h3, h4_l3, h4_h4, h4_l4)
bar3_is3 = f_isBar3(h4_h3, h4_l3, h4_h4, h4_l4)

// === 2-2 COMBO (Continuation) ===
// Two consecutive 2-bars in same direction
bullish22 = bar2_is2Up and bar1_is2Up
bearish22 = bar2_is2Down and bar1_is2Down

// === 2-1-2 COMBO (Reversal/Continuation) ===
// 2-bar, then inside bar (1), then 2-bar breaking the inside bar
// Bullish: 2-down or any, then 1, then 2-up breaking above the 1
bullish212 = bar3_is2Down and bar2_is1 and bar1_is2Up
bearish212 = bar3_is2Up and bar2_is1 and bar1_is2Down

// === 3-1-2 COMBO (Reversal) ===
// Outside bar (3), then inside bar (1), then 2-bar
// Very powerful reversal setup
bullish312 = bar3_is3 and bar2_is1 and bar1_is2Up and h4_c3 < h4_o3  // 3 was bearish, now reversing up
bearish312 = bar3_is3 and bar2_is1 and bar1_is2Down and h4_c3 > h4_o3  // 3 was bullish, now reversing down

// === 3-2-2 COMBO (Reversal) ===
// Outside bar followed by two 2-bars in reversal direction
bullish322 = bar3_is3 and bar2_is2Up and bar1_is2Up and h4_c3 < h4_o3  // 3 was bearish
bearish322 = bar3_is3 and bar2_is2Down and bar1_is2Down and h4_c3 > h4_o3  // 3 was bullish

// === 1-2-2 COMBO (Breakout) ===
// Inside bar followed by two 2-bars breaking out
bullish122 = bar3_is1 and bar2_is2Up and bar1_is2Up
bearish122 = bar3_is1 and bar2_is2Down and bar1_is2Down

// Combined combo signals with volume confirmation
bullish22Combo = combo22Enabled and bullish22 and h4_highVol
bearish22Combo = combo22Enabled and bearish22 and h4_highVol
bullish212Combo = combo22Enabled and bullish212
bearish212Combo = combo22Enabled and bearish212
bullish312Combo = combo22Enabled and bullish312
bearish312Combo = combo22Enabled and bearish312
bullish322Combo = combo22Enabled and bullish322
bearish322Combo = combo22Enabled and bearish322
bullish122Combo = combo22Enabled and bullish122
bearish122Combo = combo22Enabled and bearish122

// Track active combos
var string activeComboType = "None"
var int activeComboDir = 0  // 1 = bullish, -1 = bearish

new4HCandle = ta.change(h4_time) != 0
if new4HCandle
    // Priority order: 3-1-2 > 3-2-2 > 2-1-2 > 1-2-2 > 2-2
    if bullish312Combo
        activeComboType := "3-1-2"
        activeComboDir := 1
    else if bearish312Combo
        activeComboType := "3-1-2"
        activeComboDir := -1
    else if bullish322Combo
        activeComboType := "3-2-2"
        activeComboDir := 1
    else if bearish322Combo
        activeComboType := "3-2-2"
        activeComboDir := -1
    else if bullish212Combo
        activeComboType := "2-1-2"
        activeComboDir := 1
    else if bearish212Combo
        activeComboType := "2-1-2"
        activeComboDir := -1
    else if bullish122Combo
        activeComboType := "1-2-2"
        activeComboDir := 1
    else if bearish122Combo
        activeComboType := "1-2-2"
        activeComboDir := -1
    else if bullish22Combo
        activeComboType := "2-2"
        activeComboDir := 1
    else if bearish22Combo
        activeComboType := "2-2"
        activeComboDir := -1
    else
        activeComboType := "None"
        activeComboDir := 0

// For backward compatibility
active22Bull = activeComboDir == 1
active22Bear = activeComboDir == -1

//==============================================================================
// VOLUME ANALYSIS - Compression/Expansion/Normal
//==============================================================================

volEMA = ta.ema(volume, volEMALen)
volEMA_long = ta.ema(volume, volEMALen * 2)
volRatio = volume / volEMA

// Volume character
volExpansion = volRatio > 1.5
volCompression = volRatio < 0.5
volNormal = not volExpansion and not volCompression

volCharacter = volExpansion ? "Expansion" : volCompression ? "Compression" : "Normal"
volCharColor = volExpansion ? color.lime : volCompression ? color.orange : color.gray

//==============================================================================
// NEARBY KEY LEVEL - Relative to chart timeframe
//==============================================================================

// Get current chart timeframe in minutes
tfInMinutes = timeframe.in_seconds() / 60

// Determine which levels are relevant based on timeframe
// For < 60min charts: show 1HR, 4HR, Daily levels
// For 60-239min charts: show 4HR, Daily, Weekly levels
// For >= 240min charts: show Daily, Weekly, Monthly levels

nearLevel1H = math.abs(close - p1hh) < math.abs(close - p1hl) ? p1hh : p1hl
nearLevel4H = math.abs(close - p4hh) < math.abs(close - p4hl) ? p4hh : p4hl
nearLevelD = math.abs(close - pdh) < math.abs(close - pdl) ? pdh : pdl
nearLevelW = math.abs(close - pwh) < math.abs(close - pwl) ? pwh : pwl
nearLevelM = math.abs(close - pmh) < math.abs(close - pml) ? pmh : pml

nearLevel1H_dist = math.min(math.abs(close - p1hh), math.abs(close - p1hl))
nearLevel4H_dist = math.min(math.abs(close - p4hh), math.abs(close - p4hl))
nearLevelD_dist = math.min(math.abs(close - pdh), math.abs(close - pdl))
nearLevelW_dist = math.min(math.abs(close - pwh), math.abs(close - pwl))
nearLevelM_dist = math.min(math.abs(close - pmh), math.abs(close - pml))

// Select nearest based on timeframe
nearestLevelText = ""
nearestLevelValue = 0.0

if tfInMinutes < 60
    // For sub-hourly, prioritize 1HR levels
    if nearLevel1H_dist < nearLevel4H_dist and nearLevel1H_dist < nearLevelD_dist
        nearestLevelText := close > nearLevel1H ? "1H L" : "1H H"
        nearestLevelValue := nearLevel1H
    else if nearLevel4H_dist < nearLevelD_dist
        nearestLevelText := close > nearLevel4H ? "4H L" : "4H H"
        nearestLevelValue := nearLevel4H
    else
        nearestLevelText := close > nearLevelD ? "PDL" : "PDH"
        nearestLevelValue := nearLevelD
else if tfInMinutes < 240
    // For hourly to 4HR, prioritize 4HR and Daily
    if nearLevel4H_dist < nearLevelD_dist and nearLevel4H_dist < nearLevelW_dist
        nearestLevelText := close > nearLevel4H ? "4H L" : "4H H"
        nearestLevelValue := nearLevel4H
    else if nearLevelD_dist < nearLevelW_dist
        nearestLevelText := close > nearLevelD ? "PDL" : "PDH"
        nearestLevelValue := nearLevelD
    else
        nearestLevelText := close > nearLevelW ? "Weekly L" : "Weekly H"
        nearestLevelValue := nearLevelW
else
    // For 4HR+, prioritize Daily, Weekly, Monthly
    if nearLevelD_dist < nearLevelW_dist and nearLevelD_dist < nearLevelM_dist
        nearestLevelText := close > nearLevelD ? "PDL" : "PDH"
        nearestLevelValue := nearLevelD
    else if nearLevelW_dist < nearLevelM_dist
        nearestLevelText := close > nearLevelW ? "Weekly L" : "Weekly H"
        nearestLevelValue := nearLevelW
    else
        nearestLevelText := close > nearLevelM ? "Monthly L" : "Monthly H"
        nearestLevelValue := nearLevelM

//==============================================================================
// TIERED SIGNAL SYSTEM
//==============================================================================

nearKeyLevel = nearLevel1H_dist < close * 0.0025 or nearLevel4H_dist < close * 0.0025 or nearLevelD_dist < close * 0.0025
volSufficient = not volCompression

tier1Long  = nearKeyLevel and allRSIOversold and inBullZone and volSufficient
tier1Short = nearKeyLevel and allRSIOverbought and inBearZone and volSufficient

tier1AltLong  = insideBarActive and ta.crossover(close, insideBar50Level) and allRSIOversold and inBullZone
tier1AltShort = insideBarActive and ta.crossunder(close, insideBar50Level) and allRSIOverbought and inBearZone

tier2Long  = active22Bull and inBullZone and allRSIOversold
tier2Short = active22Bear and inBearZone and allRSIOverbought

tier3Long  = allRSIOversold and inBullZone and volSufficient and not tier1Long and not tier1AltLong and not tier2Long
tier3Short = allRSIOverbought and inBearZone and volSufficient and not tier1Short and not tier1AltShort and not tier2Short

longSignal  = tier1Long or tier1AltLong or tier2Long or tier3Long
shortSignal = tier1Short or tier1AltShort or tier2Short or tier3Short

signalTier = tier1Long or tier1Short ? "T1" : tier1AltLong or tier1AltShort ? "T1-IB" : tier2Long or tier2Short ? "T2" : tier3Long or tier3Short ? "T3" : ""

//==============================================================================
// KEY LEVEL PLOTTING
//==============================================================================

int EXTEND = 100

// Monthly
var line lineMonthlyH = na, var line lineMonthlyL = na
var label labelMonthlyH = na, var label labelMonthlyL = na

if showMonthly and barstate.islast
    if not na(lineMonthlyH)
        line.delete(lineMonthlyH), label.delete(labelMonthlyH)
    if not na(lineMonthlyL)
        line.delete(lineMonthlyL), label.delete(labelMonthlyL)
    lineMonthlyH := line.new(bar_index - 50, pmh, bar_index + EXTEND, pmh, color=color.new(color.purple, 30), width=2, style=line.style_solid)
    labelMonthlyH := label.new(bar_index + EXTEND, pmh, "Monthly H", style=label.style_label_left, color=color.new(color.purple, 70), textcolor=color.white, size=size.tiny)
    lineMonthlyL := line.new(bar_index - 50, pml, bar_index + EXTEND, pml, color=color.new(color.purple, 30), width=2, style=line.style_solid)
    labelMonthlyL := label.new(bar_index + EXTEND, pml, "Monthly L", style=label.style_label_left, color=color.new(color.purple, 70), textcolor=color.white, size=size.tiny)

// Weekly
var line lineWeeklyH = na, var line lineWeeklyL = na
var label labelWeeklyH = na, var label labelWeeklyL = na

if showWeekly and barstate.islast
    if not na(lineWeeklyH)
        line.delete(lineWeeklyH), label.delete(labelWeeklyH)
    if not na(lineWeeklyL)
        line.delete(lineWeeklyL), label.delete(labelWeeklyL)
    lineWeeklyH := line.new(bar_index - 50, pwh, bar_index + EXTEND, pwh, color=color.new(color.blue, 30), width=2, style=line.style_dashed)
    labelWeeklyH := label.new(bar_index + EXTEND, pwh, "Weekly H", style=label.style_label_left, color=color.new(color.blue, 70), textcolor=color.white, size=size.tiny)
    lineWeeklyL := line.new(bar_index - 50, pwl, bar_index + EXTEND, pwl, color=color.new(color.blue, 30), width=2, style=line.style_dashed)
    labelWeeklyL := label.new(bar_index + EXTEND, pwl, "Weekly L", style=label.style_label_left, color=color.new(color.blue, 70), textcolor=color.white, size=size.tiny)

// Daily
var line lineDailyH = na, var line lineDailyL = na
var label labelDailyH = na, var label labelDailyL = na

if showDaily and barstate.islast
    if not na(lineDailyH)
        line.delete(lineDailyH), label.delete(labelDailyH)
    if not na(lineDailyL)
        line.delete(lineDailyL), label.delete(labelDailyL)
    lineDailyH := line.new(bar_index - 50, pdh, bar_index + EXTEND, pdh, color=color.new(color.red, 30), width=2, style=line.style_dotted)
    labelDailyH := label.new(bar_index + EXTEND, pdh, "PDH", style=label.style_label_left, color=color.new(color.red, 70), textcolor=color.white, size=size.tiny)
    lineDailyL := line.new(bar_index - 50, pdl, bar_index + EXTEND, pdl, color=color.new(color.green, 30), width=2, style=line.style_dotted)
    labelDailyL := label.new(bar_index + EXTEND, pdl, "PDL", style=label.style_label_left, color=color.new(color.green, 70), textcolor=color.white, size=size.tiny)

// 4HR
var line line4HH = na, var line line4HL = na
var label label4HH = na, var label label4HL = na

if show4HR and barstate.islast
    if not na(line4HH)
        line.delete(line4HH), label.delete(label4HH)
    if not na(line4HL)
        line.delete(line4HL), label.delete(label4HL)
    line4HH := line.new(bar_index - 50, p4hh, bar_index + EXTEND, p4hh, color=color.new(color.orange, 40), width=1, style=line.style_dotted)
    label4HH := label.new(bar_index + EXTEND, p4hh, "4H H", style=label.style_label_left, color=color.new(color.orange, 70), textcolor=color.white, size=size.tiny)
    line4HL := line.new(bar_index - 50, p4hl, bar_index + EXTEND, p4hl, color=color.new(color.orange, 40), width=1, style=line.style_dotted)
    label4HL := label.new(bar_index + EXTEND, p4hl, "4H L", style=label.style_label_left, color=color.new(color.orange, 70), textcolor=color.white, size=size.tiny)

// 1HR
var line line1HH = na, var line line1HL = na
var label label1HH = na, var label label1HL = na

if show1HR and barstate.islast
    if not na(line1HH)
        line.delete(line1HH), label.delete(label1HH)
    if not na(line1HL)
        line.delete(line1HL), label.delete(label1HL)
    line1HH := line.new(bar_index - 50, p1hh, bar_index + EXTEND, p1hh, color=color.new(color.yellow, 50), width=1, style=line.style_dotted)
    label1HH := label.new(bar_index + EXTEND, p1hh, "1H H", style=label.style_label_left, color=color.new(color.yellow, 70), textcolor=color.black, size=size.tiny)
    line1HL := line.new(bar_index - 50, p1hl, bar_index + EXTEND, p1hl, color=color.new(color.yellow, 50), width=1, style=line.style_dotted)
    label1HL := label.new(bar_index + EXTEND, p1hl, "1H L", style=label.style_label_left, color=color.new(color.yellow, 70), textcolor=color.black, size=size.tiny)

// Inside Bar 50% (only if previous day was inside bar)
var line lineIB50 = na
var label labelIB50 = na

if showInsideBar50 and barstate.islast
    if not na(lineIB50)
        line.delete(lineIB50), label.delete(labelIB50)
    if insideBarActive and not na(insideBar50Level)
        lineIB50 := line.new(bar_index - 50, insideBar50Level, bar_index + EXTEND, insideBar50Level, color=insideBarColor, width=3, style=line.style_dashed)
        labelIB50 := label.new(bar_index + EXTEND, insideBar50Level, "IB 50%", style=label.style_label_left, color=color.new(insideBarColor, 50), textcolor=color.white, size=size.small)

//==============================================================================
// SIGNAL PLOTTING
//==============================================================================

plotshape(showSignals and longSignal, "Long Signal", shape.triangleup, location.belowbar, color.new(color.lime, 0), size=size.normal)
plotshape(showSignals and shortSignal, "Short Signal", shape.triangledown, location.abovebar, color.new(color.red, 0), size=size.normal)

if showTierLabels and longSignal and signalTier != ""
    label.new(bar_index, low, signalTier + " LONG", style=label.style_label_up, color=color.new(color.lime, 30), textcolor=color.white, size=size.small)

if showTierLabels and shortSignal and signalTier != ""
    label.new(bar_index, high, signalTier + " SHORT", style=label.style_label_down, color=color.new(color.red, 30), textcolor=color.white, size=size.small)

//==============================================================================
// RSI DASHBOARD
//==============================================================================

var table rsiTable = table.new(position.bottom_right, 4, 4, bgcolor=color.new(color.black, 20), border_width=1, border_color=color.gray)

if showRSIDashboard and barstate.islast
    txtSize = dashSize == "tiny" ? size.tiny : dashSize == "small" ? size.small : dashSize == "normal" ? size.normal : size.large

    table.cell(rsiTable, 0, 0, "RSI", text_color=color.white, bgcolor=color.new(color.blue, 50), text_size=txtSize)
    table.cell(rsiTable, 1, 0, "15m", text_color=color.white, bgcolor=color.new(color.blue, 50), text_size=txtSize)
    table.cell(rsiTable, 2, 0, "30m", text_color=color.white, bgcolor=color.new(color.blue, 50), text_size=txtSize)
    table.cell(rsiTable, 3, 0, "1H", text_color=color.white, bgcolor=color.new(color.blue, 50), text_size=txtSize)

    table.cell(rsiTable, 0, 1, "Value", text_color=color.gray, text_size=txtSize)
    rsi15Color = rsi15m <= rsiOversold ? color.green : rsi15m >= rsiOverbought ? color.red : color.gray
    rsi30Color = rsi30m <= rsiOversold ? color.green : rsi30m >= rsiOverbought ? color.red : color.gray
    rsi1HColor = rsi1H <= rsiOversold ? color.green : rsi1H >= rsiOverbought ? color.red : color.gray
    table.cell(rsiTable, 1, 1, str.tostring(rsi15m, "#.0"), text_color=rsi15Color, text_size=txtSize)
    table.cell(rsiTable, 2, 1, str.tostring(rsi30m, "#.0"), text_color=rsi30Color, text_size=txtSize)
    table.cell(rsiTable, 3, 1, str.tostring(rsi1H, "#.0"), text_color=rsi1HColor, text_size=txtSize)

    table.cell(rsiTable, 0, 2, "Status", text_color=color.gray, text_size=txtSize)
    confText = allRSIOversold ? "OVERSOLD" : allRSIOverbought ? "OVERBOUGHT" : "Normal"
    confColor = allRSIOversold ? color.green : allRSIOverbought ? color.red : color.gray
    table.cell(rsiTable, 1, 2, confText, text_color=confColor, text_size=txtSize)
    table.merge_cells(rsiTable, 1, 2, 3, 2)

//==============================================================================
// MAIN DASHBOARD - Reorganized: Bias first, RSI last
//==============================================================================

getDashPos(pos) =>
    pos == "top_left" ? position.top_left : pos == "top_center" ? position.top_center : pos == "top_right" ? position.top_right : pos == "middle_left" ? position.middle_left : pos == "middle_center" ? position.middle_center : pos == "middle_right" ? position.middle_right : pos == "bottom_left" ? position.bottom_left : pos == "bottom_center" ? position.bottom_center : position.bottom_right

var table mainDash = table.new(getDashPos(dashPosition), 2, 16, bgcolor=color.new(color.black, 10), border_width=1, border_color=color.new(color.gray, 50))

if showDashboard and barstate.islast
    txtSize = dashSize == "tiny" ? size.tiny : dashSize == "small" ? size.small : dashSize == "normal" ? size.normal : size.large

    // Header
    table.cell(mainDash, 0, 0, "MAC KEY LEVEL TRADER", text_color=color.white, bgcolor=color.new(color.blue, 30), text_size=txtSize)
    table.merge_cells(mainDash, 0, 0, 1, 0)

    // Row 1: Daily Bias
    dailyBiasText = dailyBias == 1 ? "BULLISH" : dailyBias == -1 ? "BEARISH" : "NEUTRAL"
    dailyBiasColor = dailyBias == 1 ? color.lime : dailyBias == -1 ? color.red : color.gray
    table.cell(mainDash, 0, 1, "Daily Bias", text_color=color.gray, text_size=txtSize)
    table.cell(mainDash, 1, 1, dailyBiasText, text_color=dailyBiasColor, text_size=txtSize)

    // Row 2: 4HR Bias
    h4BiasText = h4Bias == 1 ? "BULLISH" : h4Bias == -1 ? "BEARISH" : "NEUTRAL"
    h4BiasColor = h4Bias == 1 ? color.lime : h4Bias == -1 ? color.red : color.gray
    table.cell(mainDash, 0, 2, "4HR Bias", text_color=color.gray, text_size=txtSize)
    table.cell(mainDash, 1, 2, h4BiasText, text_color=h4BiasColor, text_size=txtSize)

    // Row 3: 1HR Bias
    h1BiasText = h1Bias == 1 ? "BULLISH" : h1Bias == -1 ? "BEARISH" : "NEUTRAL"
    h1BiasColor = h1Bias == 1 ? color.lime : h1Bias == -1 ? color.red : color.gray
    table.cell(mainDash, 0, 3, "1HR Bias", text_color=color.gray, text_size=txtSize)
    table.cell(mainDash, 1, 3, h1BiasText, text_color=h1BiasColor, text_size=txtSize)

    // Row 4: 30m Bias
    m30BiasText = m30Bias == 1 ? "BULLISH" : m30Bias == -1 ? "BEARISH" : "NEUTRAL"
    m30BiasColor = m30Bias == 1 ? color.lime : m30Bias == -1 ? color.red : color.gray
    table.cell(mainDash, 0, 4, "30m Bias", text_color=color.gray, text_size=txtSize)
    table.cell(mainDash, 1, 4, m30BiasText, text_color=m30BiasColor, text_size=txtSize)

    // Row 5: 15m Bias
    m15BiasText = m15Bias == 1 ? "BULLISH" : m15Bias == -1 ? "BEARISH" : "NEUTRAL"
    m15BiasColor = m15Bias == 1 ? color.lime : m15Bias == -1 ? color.red : color.gray
    table.cell(mainDash, 0, 5, "15m Bias", text_color=color.gray, text_size=txtSize)
    table.cell(mainDash, 1, 5, m15BiasText, text_color=m15BiasColor, text_size=txtSize)

    // Row 6: 3m Bias
    m3BiasText = m3Bias == 1 ? "BULLISH" : m3Bias == -1 ? "BEARISH" : "NEUTRAL"
    m3BiasColor = m3Bias == 1 ? color.lime : m3Bias == -1 ? color.red : color.gray
    table.cell(mainDash, 0, 6, "3m Bias", text_color=color.gray, text_size=txtSize)
    table.cell(mainDash, 1, 6, m3BiasText, text_color=m3BiasColor, text_size=txtSize)

    // Row 7: Inside Bar 50%
    ibText = insideBarActive ? "ACTIVE" : "None"
    ibColor = insideBarActive ? color.fuchsia : color.gray
    table.cell(mainDash, 0, 7, "Inside Bar 50%", text_color=color.gray, text_size=txtSize)
    table.cell(mainDash, 1, 7, ibText, text_color=ibColor, text_size=txtSize)

    // Row 8: 4HR Strat Combo (shows combo type: 2-2, 2-1-2, 3-1-2, 3-2-2, 1-2-2)
    comboDisplayText = activeComboType != "None" ? (activeComboDir == 1 ? activeComboType + " BULL" : activeComboType + " BEAR") : "None"
    comboColor = activeComboDir == 1 ? color.lime : activeComboDir == -1 ? color.red : color.gray
    table.cell(mainDash, 0, 8, "4HR Strat Combo", text_color=color.gray, text_size=txtSize)
    table.cell(mainDash, 1, 8, comboDisplayText, text_color=comboColor, text_size=txtSize)

    // Row 9: Near Key Level (relative to TF)
    table.cell(mainDash, 0, 9, "Near Key Level", text_color=color.gray, text_size=txtSize)
    table.cell(mainDash, 1, 9, nearestLevelText, text_color=color.yellow, text_size=txtSize)

    // Row 10: Volume Character
    table.cell(mainDash, 0, 10, "Volume", text_color=color.gray, text_size=txtSize)
    table.cell(mainDash, 1, 10, volCharacter, text_color=volCharColor, text_size=txtSize)

    // Row 11: Separator
    table.cell(mainDash, 0, 11, "-------------", text_color=color.gray, text_size=txtSize)
    table.merge_cells(mainDash, 0, 11, 1, 11)

    // Row 12: Signal
    signalText = longSignal ? "LONG " + signalTier : shortSignal ? "SHORT " + signalTier : "No Signal"
    signalColor = longSignal ? color.lime : shortSignal ? color.red : color.gray
    table.cell(mainDash, 0, 12, "SIGNAL", text_color=color.white, bgcolor=color.new(signalColor, 50), text_size=txtSize)
    table.cell(mainDash, 1, 12, signalText, text_color=signalColor, bgcolor=color.new(signalColor, 80), text_size=txtSize)

    // Row 13: Separator
    table.cell(mainDash, 0, 13, "-------------", text_color=color.gray, text_size=txtSize)
    table.merge_cells(mainDash, 0, 13, 1, 13)

    // Row 14: RSI Confluence (LAST)
    rsiConfText = allRSIOversold ? "OVERSOLD" : allRSIOverbought ? "OVERBOUGHT" : "Normal"
    rsiConfColor = allRSIOversold ? color.lime : allRSIOverbought ? color.red : color.gray
    table.cell(mainDash, 0, 14, "RSI Confluence", text_color=color.gray, text_size=txtSize)
    table.cell(mainDash, 1, 14, rsiConfText, text_color=rsiConfColor, text_size=txtSize)

