//@version=5
indicator("MAC Key Level Trader V2", overlay=true, max_labels_count=100, max_boxes_count=50, max_lines_count=50)

//==============================================================================
// MAC KEY LEVEL TRADER V2 - Clean Intraday GPS
// Simplified, actionable bias and signal system
//==============================================================================

//==============================================================================
// INPUTS
//==============================================================================

// Key Levels - simplified
showDailyLevels = input.bool(true, "Show PDH/PDL", group="Key Levels")
showWeeklyLevels = input.bool(false, "Show Weekly H/L", group="Key Levels")
showMonthlyLevels = input.bool(false, "Show Monthly H/L", group="Key Levels")

// Dashboard
showDashboard = input.bool(true, "Show Dashboard", group="Dashboard")
dashPosition = input.string("top_right", "Position", options=["top_left", "top_right", "bottom_left", "bottom_right"], group="Dashboard")

// Strat Combos
showCombos = input.bool(true, "Show 4HR Strat Combos", group="Strat Combos")

// RSI
rsiLength = input.int(14, "RSI Length", group="RSI")
rsiOB = input.int(70, "Overbought", group="RSI")
rsiOS = input.int(30, "Oversold", group="RSI")

//==============================================================================
// PREVIOUS DAY HIGH/LOW (for Daily Bias)
//==============================================================================

newDay = ta.change(time("D")) != 0
var float todayHigh = na
var float todayLow = na
var float pdh = na
var float pdl = na

if newDay
    pdh := todayHigh
    pdl := todayLow
    todayHigh := high
    todayLow := low
else
    todayHigh := na(todayHigh) ? high : math.max(todayHigh, high)
    todayLow := na(todayLow) ? low : math.min(todayLow, low)

// DAILY BIAS: Based on current price vs PDH/PDL
// TREND UP = price > PDH (broke out bullish)
// TREND DOWN = price < PDL (broke out bearish)
// INSIDE DAY = price between PDH and PDL (ranging)
dailyBiasNum = close > pdh ? 1 : close < pdl ? -1 : 0
dailyBiasText = dailyBiasNum == 1 ? "TREND UP" : dailyBiasNum == -1 ? "TREND DOWN" : "INSIDE DAY"
dailyBiasColor = dailyBiasNum == 1 ? color.lime : dailyBiasNum == -1 ? color.red : color.yellow

//==============================================================================
// TIMEFRAME BIAS FUNCTION
// BULLISH = price > prev candle high
// BEARISH = price < prev candle low
// CHOP = price inside prev candle range
//==============================================================================

f_tfBias(_close, _prevHigh, _prevLow) =>
    _close > _prevHigh ? 1 : _close < _prevLow ? -1 : 0

// 4HR Bias
[h4_prevH, h4_prevL] = request.security(syminfo.tickerid, "240", [high[1], low[1]], lookahead=barmerge.lookahead_off)
h4Bias = f_tfBias(close, h4_prevH, h4_prevL)
h4BiasText = h4Bias == 1 ? "BULLISH" : h4Bias == -1 ? "BEARISH" : "CHOP"
h4BiasColor = h4Bias == 1 ? color.lime : h4Bias == -1 ? color.red : color.yellow

// 1HR Bias
[h1_prevH, h1_prevL] = request.security(syminfo.tickerid, "60", [high[1], low[1]], lookahead=barmerge.lookahead_off)
h1Bias = f_tfBias(close, h1_prevH, h1_prevL)
h1BiasText = h1Bias == 1 ? "BULLISH" : h1Bias == -1 ? "BEARISH" : "CHOP"
h1BiasColor = h1Bias == 1 ? color.lime : h1Bias == -1 ? color.red : color.yellow

// 30m Bias
[m30_prevH, m30_prevL] = request.security(syminfo.tickerid, "30", [high[1], low[1]], lookahead=barmerge.lookahead_off)
m30Bias = f_tfBias(close, m30_prevH, m30_prevL)
m30BiasText = m30Bias == 1 ? "BULLISH" : m30Bias == -1 ? "BEARISH" : "CHOP"
m30BiasColor = m30Bias == 1 ? color.lime : m30Bias == -1 ? color.red : color.yellow

// 15m Bias
[m15_prevH, m15_prevL] = request.security(syminfo.tickerid, "15", [high[1], low[1]], lookahead=barmerge.lookahead_off)
m15Bias = f_tfBias(close, m15_prevH, m15_prevL)
m15BiasText = m15Bias == 1 ? "BULLISH" : m15Bias == -1 ? "BEARISH" : "CHOP"
m15BiasColor = m15Bias == 1 ? color.lime : m15Bias == -1 ? color.red : color.yellow

// 5m Bias
[m5_prevH, m5_prevL] = request.security(syminfo.tickerid, "5", [high[1], low[1]], lookahead=barmerge.lookahead_off)
m5Bias = f_tfBias(close, m5_prevH, m5_prevL)
m5BiasText = m5Bias == 1 ? "BULLISH" : m5Bias == -1 ? "BEARISH" : "CHOP"
m5BiasColor = m5Bias == 1 ? color.lime : m5Bias == -1 ? color.red : color.yellow

//==============================================================================
// BIAS ALIGNMENT - How many TFs agree?
//==============================================================================

bullCount = (h4Bias == 1 ? 1 : 0) + (h1Bias == 1 ? 1 : 0) + (m30Bias == 1 ? 1 : 0) + (m15Bias == 1 ? 1 : 0) + (m5Bias == 1 ? 1 : 0)
bearCount = (h4Bias == -1 ? 1 : 0) + (h1Bias == -1 ? 1 : 0) + (m30Bias == -1 ? 1 : 0) + (m15Bias == -1 ? 1 : 0) + (m5Bias == -1 ? 1 : 0)

overallBias = bullCount >= 3 ? "ALIGNED BULL" : bearCount >= 3 ? "ALIGNED BEAR" : "MIXED"
overallBiasColor = bullCount >= 3 ? color.lime : bearCount >= 3 ? color.red : color.yellow

//==============================================================================
// RSI MULTI-TIMEFRAME
//==============================================================================

rsi15m = request.security(syminfo.tickerid, "15", ta.rsi(close, rsiLength), lookahead=barmerge.lookahead_off)
rsi30m = request.security(syminfo.tickerid, "30", ta.rsi(close, rsiLength), lookahead=barmerge.lookahead_off)
rsi1H = request.security(syminfo.tickerid, "60", ta.rsi(close, rsiLength), lookahead=barmerge.lookahead_off)

rsiAvg = (rsi15m + rsi30m + rsi1H) / 3
rsiStatus = rsiAvg <= rsiOS ? "OVERSOLD" : rsiAvg >= rsiOB ? "OVERBOUGHT" : "NEUTRAL"
rsiColor = rsiAvg <= rsiOS ? color.lime : rsiAvg >= rsiOB ? color.red : color.gray

//==============================================================================
// 4HR STRAT COMBOS
//==============================================================================

f_isBar1(_h, _l, _ph, _pl) => _h <= _ph and _l >= _pl
f_isBar2Up(_h, _l, _ph, _pl) => _h > _ph and _l >= _pl
f_isBar2Down(_h, _l, _ph, _pl) => _l < _pl and _h <= _ph
f_isBar3(_h, _l, _ph, _pl) => _h > _ph and _l < _pl

[h4_h1, h4_l1, h4_c1, h4_o1] = request.security(syminfo.tickerid, "240", [high[1], low[1], close[1], open[1]], lookahead=barmerge.lookahead_off)
[h4_h2, h4_l2, h4_c2, h4_o2] = request.security(syminfo.tickerid, "240", [high[2], low[2], close[2], open[2]], lookahead=barmerge.lookahead_off)
[h4_h3, h4_l3, h4_c3, h4_o3] = request.security(syminfo.tickerid, "240", [high[3], low[3], close[3], open[3]], lookahead=barmerge.lookahead_off)
[h4_h4, h4_l4] = request.security(syminfo.tickerid, "240", [high[4], low[4]], lookahead=barmerge.lookahead_off)

bar1_2Up = f_isBar2Up(h4_h1, h4_l1, h4_h2, h4_l2)
bar1_2Down = f_isBar2Down(h4_h1, h4_l1, h4_h2, h4_l2)
bar1_1 = f_isBar1(h4_h1, h4_l1, h4_h2, h4_l2)
bar2_2Up = f_isBar2Up(h4_h2, h4_l2, h4_h3, h4_l3)
bar2_2Down = f_isBar2Down(h4_h2, h4_l2, h4_h3, h4_l3)
bar2_1 = f_isBar1(h4_h2, h4_l2, h4_h3, h4_l3)
bar3_2Up = f_isBar2Up(h4_h3, h4_l3, h4_h4, h4_l4)
bar3_2Down = f_isBar2Down(h4_h3, h4_l3, h4_h4, h4_l4)
bar3_3 = f_isBar3(h4_h3, h4_l3, h4_h4, h4_l4)

// Combo detection
combo22Bull = bar2_2Up and bar1_2Up
combo22Bear = bar2_2Down and bar1_2Down
combo212Bull = bar3_2Down and bar2_1 and bar1_2Up
combo212Bear = bar3_2Up and bar2_1 and bar1_2Down
combo312Bull = bar3_3 and bar2_1 and bar1_2Up and h4_c3 < h4_o3
combo312Bear = bar3_3 and bar2_1 and bar1_2Down and h4_c3 > h4_o3
combo122Bull = f_isBar1(h4_h3, h4_l3, h4_h4, h4_l4) and bar2_2Up and bar1_2Up
combo122Bear = f_isBar1(h4_h3, h4_l3, h4_h4, h4_l4) and bar2_2Down and bar1_2Down

comboText = combo312Bull ? "3-1-2 BULL" : combo312Bear ? "3-1-2 BEAR" : combo212Bull ? "2-1-2 BULL" : combo212Bear ? "2-1-2 BEAR" : combo122Bull ? "1-2-2 BULL" : combo122Bear ? "1-2-2 BEAR" : combo22Bull ? "2-2 BULL" : combo22Bear ? "2-2 BEAR" : "None"
comboColor = str.contains(comboText, "BULL") ? color.lime : str.contains(comboText, "BEAR") ? color.red : color.gray

//==============================================================================
// SIMPLE ACTIONABLE SIGNAL
// Long when: Daily trending up OR inside day + lower TFs bullish aligned + RSI not overbought
// Short when: Daily trending down OR inside day + lower TFs bearish aligned + RSI not oversold
//==============================================================================

longCondition = (dailyBiasNum >= 0) and (bullCount >= 3) and (rsiAvg < rsiOB)
shortCondition = (dailyBiasNum <= 0) and (bearCount >= 3) and (rsiAvg > rsiOS)

signalText = longCondition ? "LOOK LONG" : shortCondition ? "LOOK SHORT" : "WAIT"
signalColor = longCondition ? color.lime : shortCondition ? color.red : color.gray

//==============================================================================
// KEY LEVEL PLOTTING - Clean, minimal
//==============================================================================

var line linePDH = na
var line linePDL = na

if showDailyLevels and barstate.islast
    if not na(linePDH)
        line.delete(linePDH)
    if not na(linePDL)
        line.delete(linePDL)

    linePDH := line.new(bar_index - 50, pdh, bar_index + 20, pdh, color=color.new(color.red, 30), width=2, style=line.style_solid)
    linePDL := line.new(bar_index - 50, pdl, bar_index + 20, pdl, color=color.new(color.green, 30), width=2, style=line.style_solid)

// Weekly levels
[pwh, pwl] = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead=barmerge.lookahead_on)
var line linePWH = na
var line linePWL = na

if showWeeklyLevels and barstate.islast
    if not na(linePWH)
        line.delete(linePWH)
    if not na(linePWL)
        line.delete(linePWL)

    linePWH := line.new(bar_index - 50, pwh, bar_index + 20, pwh, color=color.new(color.blue, 40), width=1, style=line.style_dashed)
    linePWL := line.new(bar_index - 50, pwl, bar_index + 20, pwl, color=color.new(color.blue, 40), width=1, style=line.style_dashed)

// Monthly levels
[pmh, pml] = request.security(syminfo.tickerid, "M", [high[1], low[1]], lookahead=barmerge.lookahead_on)
var line linePMH = na
var line linePML = na

if showMonthlyLevels and barstate.islast
    if not na(linePMH)
        line.delete(linePMH)
    if not na(linePML)
        line.delete(linePML)

    linePMH := line.new(bar_index - 50, pmh, bar_index + 20, pmh, color=color.new(color.purple, 40), width=1, style=line.style_solid)
    linePML := line.new(bar_index - 50, pml, bar_index + 20, pml, color=color.new(color.purple, 40), width=1, style=line.style_solid)

//==============================================================================
// DASHBOARD - Clean and compact
//==============================================================================

getDashPos(p) =>
    p == "top_left" ? position.top_left : p == "top_right" ? position.top_right : p == "bottom_left" ? position.bottom_left : position.bottom_right

var table dash = table.new(getDashPos(dashPosition), 2, 12, bgcolor=color.new(color.black, 20), border_width=1, border_color=color.gray)

if showDashboard and barstate.islast
    // Header
    table.cell(dash, 0, 0, "INTRADAY GPS", text_color=color.white, bgcolor=color.new(color.blue, 40), text_size=size.small)
    table.merge_cells(dash, 0, 0, 1, 0)

    // Daily Bias (most important)
    table.cell(dash, 0, 1, "DAILY", text_color=color.white, bgcolor=color.new(color.gray, 60), text_size=size.small)
    table.cell(dash, 1, 1, dailyBiasText, text_color=color.white, bgcolor=color.new(dailyBiasColor, 40), text_size=size.small)

    // 4HR Bias
    table.cell(dash, 0, 2, "4HR", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 2, h4BiasText, text_color=h4BiasColor, text_size=size.tiny)

    // 1HR Bias
    table.cell(dash, 0, 3, "1HR", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 3, h1BiasText, text_color=h1BiasColor, text_size=size.tiny)

    // 30m Bias
    table.cell(dash, 0, 4, "30m", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 4, m30BiasText, text_color=m30BiasColor, text_size=size.tiny)

    // 15m Bias
    table.cell(dash, 0, 5, "15m", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 5, m15BiasText, text_color=m15BiasColor, text_size=size.tiny)

    // 5m Bias
    table.cell(dash, 0, 6, "5m", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 6, m5BiasText, text_color=m5BiasColor, text_size=size.tiny)

    // Overall alignment
    table.cell(dash, 0, 7, "ALIGN", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 7, overallBias, text_color=overallBiasColor, text_size=size.tiny)

    // 4HR Strat Combo
    if showCombos
        table.cell(dash, 0, 8, "4H COMBO", text_color=color.gray, text_size=size.tiny)
        table.cell(dash, 1, 8, comboText, text_color=comboColor, text_size=size.tiny)

    // RSI
    table.cell(dash, 0, 9, "RSI", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 9, str.tostring(rsiAvg, "#") + " " + rsiStatus, text_color=rsiColor, text_size=size.tiny)

    // Signal
    table.cell(dash, 0, 10, "ACTION", text_color=color.white, bgcolor=color.new(signalColor, 50), text_size=size.small)
    table.cell(dash, 1, 10, signalText, text_color=color.white, bgcolor=color.new(signalColor, 30), text_size=size.small)

//==============================================================================
// ALERTS
//==============================================================================

alertcondition(longCondition and not longCondition[1], "Look Long", "Intraday GPS: LOOK LONG on {{ticker}}")
alertcondition(shortCondition and not shortCondition[1], "Look Short", "Intraday GPS: LOOK SHORT on {{ticker}}")
alertcondition(dailyBiasNum == 1 and dailyBiasNum[1] != 1, "Trend Day Up", "{{ticker}} broke above PDH - TREND DAY UP")
alertcondition(dailyBiasNum == -1 and dailyBiasNum[1] != -1, "Trend Day Down", "{{ticker}} broke below PDL - TREND DAY DOWN")
alertcondition(comboText != "None" and comboText != comboText[1], "4HR Strat Combo", "4HR Strat Combo: " + comboText + " on {{ticker}}")
