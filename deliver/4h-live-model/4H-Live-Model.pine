//@version=5
// 4H LIVE MODEL v3.2 (Team Mac): + your Levels PRO v2.4.2 levels, AT LEVEL, WAIT/ARMED/GO plan with risk: side candles + levels + dashboard = 4H; path line = the chart-timeframe candle (Mac 11/22)
// Shows the current 4H candle's life (OPEN -> EXTREME -> RECLAIM -> EXPANSION -> TARGET -> CLOSED)
// beside live price action on any chart timeframe at or below 4H.
// P4H values: previous completed 4H candle (lookahead_on + [1] = confirmed only, never repaints).
// C4H values: the forming 4H candle, live (chart bars of the current 4H candle; request.security as fallback).
// Phase order (which extreme came first, reclaim timing) is tracked on the chart's own bars,
// using TradingView's own 4H boundaries for the symbol (time("240")).
indicator("4H Live Model", shorttitle = "4H LIVE MODEL", overlay = true, max_bars_back = 500, max_boxes_count = 20, max_lines_count = 120, max_labels_count = 120)

// ================= INPUTS =================
grpEl = "Elements"
showCandles = input.bool(true, "Side candles (P4H / C4H LIVE)", group = grpEl)
showPath    = input.bool(true, "Formation path line", group = grpEl)
showLevels  = input.bool(true, "Level lines", group = grpEl)
showDash    = input.bool(true, "Dashboard", group = grpEl)

grpSc = "Side candles"
offP4H    = input.int(6, "P4H offset (bars right of last bar)", minval = 2, maxval = 300, group = grpSc)
offC4H    = input.int(16, "C4H LIVE offset (bars)", minval = 2, maxval = 300, group = grpSc)
candleW   = input.int(4, "Candle width (bars)", minval = 1, maxval = 30, group = grpSc)
wickW     = input.int(2, "Wick width (px)", minval = 1, maxval = 6, group = grpSc)
bullCol   = input.color(#00c853, "Bullish color", group = grpSc)
bearCol   = input.color(#ff4f7b, "Bearish color", group = grpSc)
c4Transp  = input.int(10, "C4H LIVE body transparency", minval = 0, maxval = 100, group = grpSc)
p4Transp  = input.int(70, "P4H body transparency (muted)", minval = 0, maxval = 100, group = grpSc)
p4WickTr  = input.int(45, "P4H wick/border transparency", minval = 0, maxval = 100, group = grpSc)

grpPa = "Formation path"
offPath   = input.int(26, "Path offset (bars)", minval = 2, maxval = 300, group = grpPa)
pathStep  = input.int(3, "Bars per phase step", minval = 1, maxval = 20, group = grpPa)
pathCol   = input.color(#a64dff, "Path color", group = grpPa)
pathW     = input.int(3, "Path width", minval = 1, maxval = 6, group = grpPa)
lostCol   = input.color(#ff1744, "RECLAIM LOST color", group = grpPa)

grpLv = "Level lines"
extLeft   = input.bool(false, "Extend level lines to the left edge", group = grpLv)
p4hHiCol  = input.color(#2962ff, "P4H HIGH color", group = grpLv)
p4hHiSty  = input.string("Solid", "P4H HIGH style", options = ["Solid", "Dashed", "Dotted"], group = grpLv)
p4hLoCol  = input.color(#ff6d00, "P4H LOW color", group = grpLv)
p4hLoSty  = input.string("Solid", "P4H LOW style", options = ["Solid", "Dashed", "Dotted"], group = grpLv)
p4hOpCol  = input.color(#9e9e9e, "P4H OPEN color", group = grpLv)
p4hOpSty  = input.string("Dashed", "P4H OPEN style", options = ["Solid", "Dashed", "Dotted"], group = grpLv)
c4hOpCol  = input.color(#1a237e, "C4H OPEN color", group = grpLv)
c4hOpSty  = input.string("Solid", "C4H OPEN style", options = ["Solid", "Dashed", "Dotted"], group = grpLv)
c4hOpW    = input.int(3, "C4H OPEN width", minval = 1, maxval = 6, group = grpLv)
lvlW      = input.int(1, "Other level widths", minval = 1, maxval = 6, group = grpLv)

grpDb = "Dashboard"
dashPosS  = input.string("Top Right", "Position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right"], group = grpDb)
dashSizeS = input.string("Small", "Text size", options = ["Tiny", "Small", "Normal", "Large"], group = grpDb)
dashBg    = input.color(#0d1117, "Background", group = grpDb)
dashTxt   = input.color(color.white, "Text", group = grpDb)

grpMb = "Mobile / labels"
mobile    = input.bool(false, "MOBILE MODE (iPhone): compact dashboard, bigger text, tighter drawings", group = grpMb)
mobPosS   = input.string("Top Right", "Mobile dashboard position", options = ["Top Right", "Top Left", "Bottom Left", "Bottom Right", "Middle Right"], group = grpMb)
mobSizeS  = input.string("Normal", "Mobile text size", options = ["Small", "Normal", "Large"], group = grpMb)
lvlLblS   = input.string("Right", "Level line labels", options = ["Right", "Left"], group = grpMb)
pathLblS  = input.string("Right", "Path labels", options = ["Right", "Left"], group = grpMb)

grpAl = "Full alignment"
alReqP4   = input.bool(true, "Require the P4H candle to close in the same direction", group = grpAl)
alReqRC   = input.bool(true, "Require the chart candle's reclaim (v3.2: always a 3m / 5m close)", group = grpAl)
alAlert   = input.bool(true, "Alert when full alignment starts (create the alert with 'Any alert() function call')", group = grpAl)

grpLvl = "Your levels (Levels PRO v2.4.2)"
showLv    = input.bool(true, "Show your levels (and use them for AT LEVEL and targets)", group = grpLvl)
lvPDH     = input.bool(true, "PDH / PDL", group = grpLvl)
lvPDC     = input.bool(true, "PDC (prev day close)", group = grpLvl)
lvWeek    = input.bool(true, "Prev Week H/L + Week Open", group = grpLvl)
lvDO      = input.bool(true, "Daily Open", group = grpLvl)
lvAsia    = input.bool(true, "Asia High / Low", group = grpLvl)
lvLon     = input.bool(true, "London High / Low", group = grpLvl)
lvOpens   = input.bool(true, "06:30 / 15:00 Opens", group = grpLvl)
lvIB      = input.bool(true, "Initial Balance H/L", group = grpLvl)
lvVW      = input.bool(true, "Session VWAP", group = grpLvl)
lvPWO     = input.bool(true, "Prev Week Open (PWO)", group = grpLvl)
lvMO      = input.bool(true, "Month Open (MO)", group = grpLvl)
lvMHML    = input.bool(true, "Month High / Low (MH / ML)", group = grpLvl)
lvPM      = input.bool(true, "Prev Month Open / High / Low (PMO / PMoH / PMoL)", group = grpLvl)
lvMax     = input.int(12, "Levels drawn: nearest N (desktop)", minval = 1, maxval = 30, group = grpLvl)
lvMaxMob  = input.int(6, "Levels drawn: nearest N (mobile)", minval = 1, maxval = 20, group = grpLvl)
lvBack    = input.int(60, "Level lines start this many bars back", minval = 5, maxval = 500, group = grpLvl)
lvColW    = input.color(#ffc53d, "Weekly / monthly levels", group = grpLvl)
lvColD    = input.color(#4dd9e8, "Daily levels", group = grpLvl)
lvColS    = input.color(#9fb3c8, "Session levels", group = grpLvl)
atLvlPct  = input.float(10.0, "AT LEVEL: extreme within this % of a normal candle's range of a level", minval = 1, maxval = 50, step = 1, group = grpLvl)

grpPl = "Trade plan (WAIT / ARMED / GO)"
contracts = input.int(1, "Contracts (for the $ risk / reward)", minval = 1, maxval = 100, group = grpPl)
stopTk    = input.int(4, "Stop buffer beyond the extreme (ticks)", minval = 0, maxval = 400, group = grpPl)
minR      = input.float(1.5, "Minimum R to call GO (below it reads SKIP)", minval = 0.5, maxval = 10, step = 0.1, group = grpPl)
planAlert = input.bool(true, "Alert on ARMED / GO / INVALID (alert condition: Any alert() function call)", group = grpPl)

grpMd = "Model"
confTF    = input.string("5m", "Reclaim confirmed by a close on", options = ["3m", "5m"], group = grpMd, tooltip = "Mac 11/25: the open is reclaimed when a 3m or 5m candle closes through it. On charts at or below this timeframe, 1m closes are used.")
extPct    = input.float(10.0, "Legacy setting (v3.2: stages use 3m / 5m closes, not a percentage)", minval = 0.5, maxval = 100, step = 0.5, group = grpMd)

// ================= HELPERS =================
f_sty(s) => s == "Dashed" ? line.style_dashed : s == "Dotted" ? line.style_dotted : line.style_solid
f_pos(s) => s == "Top Left" ? position.top_left : s == "Bottom Right" ? position.bottom_right : s == "Bottom Left" ? position.bottom_left : s == "Middle Right" ? position.middle_right : position.top_right
f_size(s) => s == "Tiny" ? size.tiny : s == "Normal" ? size.normal : s == "Large" ? size.large : size.small
f_px(v) => na(v) ? "—" : str.tostring(v, format.mintick)
f_cd(ms) =>
    int s = math.max(0, int(math.floor(ms / 1000)))
    int h = int(s / 3600)
    int m = int((s % 3600) / 60)
    int c = s % 60
    str.tostring(h, "00") + ":" + str.tostring(m, "00") + ":" + str.tostring(c, "00")

if timeframe.in_seconds() > 14400
    runtime.error("4H Live Model works on chart timeframes at or below 4H.")

// ================= 4H DATA =================
[p4O, p4H, p4L, p4C] = request.security(syminfo.tickerid, "240", [open[1], high[1], low[1], close[1]], lookahead = barmerge.lookahead_on)
[p2O, p2C] = request.security(syminfo.tickerid, "240", [open[2], close[2]], lookahead = barmerge.lookahead_on)
[c4O, c4H, c4L, c4C] = request.security(syminfo.tickerid, "240", [open, high, low, close], lookahead = barmerge.lookahead_off)

// ================= PHASE TRACKING (chart bars) =================
t4 = time("240")
inSess = not na(t4)
newC = inSess and nz(t4[1], 0) != t4

var float cO = na
var float cH = na
var float cL = na
var int hiBar = na
var int loBar = na
var int side = 0          // 0 unformed, 1 bullish (low first), -1 bearish (high first)
var bool rclF = false     // reclaim happened (intrabar allowed)
var bool rclC = false     // a chart candle closed back through the open
var bool tgtHit = false
var int c4Start = na
var int p4Start = na

thr = math.max(syminfo.mintick * 2, nz(p4H - p4L) * extPct / 100)

if inSess
    bool newHi = false
    bool newLo = false
    if newC
        p4Start := c4Start
        c4Start := bar_index
        cO := open
        cH := high
        cL := low
        hiBar := bar_index
        loBar := bar_index
        side := 0
        rclF := false
        rclC := false
        tgtHit := false
    else if not na(cO)
        if high > cH
            cH := high
            hiBar := bar_index
            newHi := true
        if low < cL
            cL := low
            loBar := bar_index
            newLo := true
    if not na(cO)
        // name the template: whichever extreme forms first
        if side == 0
            float dnX = cO - cL
            float upX = cH - cO
            if dnX >= thr and upX >= thr
                side := close >= open ? 1 : -1
            else if dnX >= thr
                side := 1
            else if upX >= thr
                side := -1
        // the extreme extends again -> reclaim must happen again
        if (side == 1 and newLo) or (side == -1 and newHi)
            rclF := false
            rclC := false
        if side == 1
            bool crossed = (bar_index > loBar and high >= cO) or (bar_index == loBar and close >= cO)
            if crossed
                rclF := true
            if barstate.isconfirmed and bar_index >= loBar and close >= cO
                rclF := true
                rclC := true
            if not na(p4H) and cH >= p4H
                tgtHit := true
        if side == -1
            bool crossed = (bar_index > hiBar and low <= cO) or (bar_index == hiBar and close <= cO)
            if crossed
                rclF := true
            if barstate.isconfirmed and bar_index >= hiBar and close <= cO
                rclF := true
                rclC := true
            if not na(p4L) and cL <= p4L
                tgtHit := true

// Live C4H values come from the chart's own bars inside the current 4H candle (same feed, exact match
// to request.security on live bars). request.security(lookahead_off) returns the PREVIOUS 4H candle on a
// last bar that is calculated as history (chart load before the first tick, bar replay), so it is only the fallback.
float kO = na(cO) ? c4O : cO
float kH = na(cO) ? c4H : cH
float kL = na(cO) ? c4L : cL
float kC = na(cO) ? c4C : close

// ================= YOUR LEVELS (computed exactly as Levels PRO v2.4.2, Mac 11/24) =================
string LTZ = "America/Los_Angeles"
lvNewDay    = ta.change(time("D", LTZ)) != 0
lvInAsia    = not na(time(timeframe.period, "1500-0000", LTZ))
lvInLon     = not na(time(timeframe.period, "0000-0630", LTZ))
lvAsiaStart = lvInAsia and not lvInAsia[1]
lvAsiaEnd   = not lvInAsia and lvInAsia[1]
lvLonStart  = lvInLon and not lvInLon[1]
lvLonEnd    = not lvInLon and lvInLon[1]
lvY  = year(time, LTZ)
lvMo = month(time, LTZ)
lvDd = dayofmonth(time, LTZ)
lvTs0630 = timestamp(LTZ, lvY, lvMo, lvDd, 6, 30)
lvTs0730 = timestamp(LTZ, lvY, lvMo, lvDd, 7, 30)
lvTs1500 = timestamp(LTZ, lvY, lvMo, lvDd, 15, 0)
lvX0630 = time >= lvTs0630 and nz(time[1]) < lvTs0630
lvX1500 = time >= lvTs1500 and nz(time[1]) < lvTs1500
lvInIB  = time >= lvTs0630 and time < lvTs0730

var float dayHi = na
var float dayLo = na
var float prevDayHi = na
var float prevDayLo = na
var float prevDayC = na
var float dayOpen = na
var bool dayFull = false
if lvNewDay
    prevDayHi := dayFull ? dayHi : na
    prevDayLo := dayFull ? dayLo : na
    prevDayC  := nz(close[1], close)
    dayHi     := high
    dayLo     := low
    dayOpen   := open
    dayFull   := true
else
    if na(dayHi)
        dayHi   := high
        dayLo   := low
        dayOpen := na
    dayHi := math.max(dayHi, high)
    dayLo := math.min(dayLo, low)

var float asiaHiL = na
var float asiaLoL = na
var float asiaHiK = na
var float asiaLoK = na
if lvAsiaStart
    asiaHiL := high
    asiaLoL := low
if lvInAsia
    asiaHiL := math.max(nz(asiaHiL, high), high)
    asiaLoL := math.min(nz(asiaLoL, low),  low)
if lvAsiaEnd and not na(asiaHiL)
    asiaHiK := asiaHiL
    asiaLoK := asiaLoL
asiaHi = lvInAsia ? asiaHiL : asiaHiK
asiaLo = lvInAsia ? asiaLoL : asiaLoK

var float lonHiL = na
var float lonLoL = na
var float lonHiK = na
var float lonLoK = na
if lvLonStart
    lonHiL := high
    lonLoL := low
if lvInLon
    lonHiL := math.max(nz(lonHiL, high), high)
    lonLoL := math.min(nz(lonLoL, low),  low)
if lvLonEnd and not na(lonHiL)
    lonHiK := lonHiL
    lonLoK := lonLoL
lonHi = lvInLon ? lonHiL : lonHiK
lonLo = lvInLon ? lonLoL : lonLoK

var float open0630 = na
var int   day0630  = -1
var float open1500 = na
var int   day1500  = -1
if lvX0630
    open0630 := time == lvTs0630 ? open : na
    day0630  := lvDd
if lvX1500
    open1500 := time == lvTs1500 ? open : na
    day1500  := lvDd
o0630 = day0630 == lvDd ? open0630 : na
o1500 = day1500 == lvDd ? open1500 : na

var float ibHiL = na
var float ibLoL = na
var float ibHi = na
var float ibLo = na
if lvNewDay
    ibHiL := na
    ibLoL := na
    ibHi  := na
    ibLo  := na
if lvInIB
    ibHiL := math.max(nz(ibHiL, high), high)
    ibLoL := math.min(nz(ibLoL, low),  low)
    ibHi  := ibHiL
    ibLo  := ibLoL

var float vwPV = 0.0
var float vwVol = 0.0
if lvX0630 or lvNewDay
    vwPV  := 0.0
    vwVol := 0.0
if time >= lvTs0630
    vwPV  := vwPV + hlc3 * volume
    vwVol := vwVol + volume
sessVWAP = vwVol > 0 ? vwPV / vwVol : na

pwh_v   = request.security("", "W", high[1], lookahead = barmerge.lookahead_on)
pwl_v   = request.security("", "W", low[1],  lookahead = barmerge.lookahead_on)
wk_open = request.security("", "W", open,    lookahead = barmerge.lookahead_on)
pwo_v   = request.security("", "W", open[1], lookahead = barmerge.lookahead_on)
mo_v    = request.security("", "M", open,    lookahead = barmerge.lookahead_on)
pmo_v   = request.security("", "M", open[1], lookahead = barmerge.lookahead_on)
pmoh_v  = request.security("", "M", high[1], lookahead = barmerge.lookahead_on)
pmol_v  = request.security("", "M", low[1],  lookahead = barmerge.lookahead_on)

int  m_start_t = time("M")
bool roll_m    = ta.change(time("M")) != 0
var bool  mSeen  = false
var float mHiAcc = na
var float mLoAcc = na
if roll_m
    mSeen  := not na(m_start_t) and time == m_start_t
    mHiAcc := na
    mLoAcc := na
mh_v = mSeen ? mHiAcc : na
ml_v = mSeen ? mLoAcc : na
mHiAcc := math.max(nz(mHiAcc, high), high)
mLoAcc := math.min(nz(mLoAcc, low), low)

// ================= CHART-CANDLE LIFE (drives the path line) =================
// The path line follows the candle of the timeframe being viewed (e.g. the forming 30m candle),
// using Mac's definitions (v3.2): RECLAIM = a 3m / 5m close through the open, EXPANSION = new candle prices after it
// -> RECLAIM (back through that candle's open) -> EXPANSION -> TARGET (previous chart candle high/low) -> CLOSED.
// Order inside the candle comes from its 1-minute bars (5-minute above 1H); on a 1m chart, from live ticks.
int chSec = timeframe.in_seconds()
int confSec = confTF == "3m" ? 180 : 300
string ltf = chSec > confSec ? (confTF == "3m" ? "3" : "5") : "1"
[sbO, sbH, sbL, sbC] = request.security_lower_tf(syminfo.tickerid, ltf, [open, high, low, close])
varip tk = array.new_float()
varip int tkBar = -1
if barstate.islast and chSec <= 60
    if bar_index != tkBar
        array.clear(tk)
        tkBar := bar_index
        array.push(tk, open)
        array.push(tk, close >= open ? low : high)
        array.push(tk, close >= open ? high : low)
    if array.size(tk) < 4000 and close != array.get(tk, array.size(tk) - 1)
        array.push(tk, close)

// v3.2 (Mac 11/25), Mac's definitions, no percentages:
//   RECLAIM   = a 3m / 5m candle (input "Reclaim confirmed by") CLOSES through the open. Direction = the side it closes on.
//               Every such close counts: closing back the other way is a reclaim the other way (the latest one wins).
//   EXTREME   = the far point the candle reached on the other side of the open before that close.
//               Before the first reclaim: the side price is closing on, and its far point so far.
//   EXPANSION = after the reclaim, price VISITS NEW PRICES for the candle in the reclaim direction
//               (a new candle high for a bullish reclaim, a new candle low for a bearish one).
//   Right now, after the reclaim:  EXPANDING (making new prices now) / RETEST (back at the open, no close through)
//               / CONSOLIDATING (inside the candle's range, no new prices).
// Sub-bars are the confirmation candles (3m / 5m); on charts at or below that timeframe, 1m bars (ticks on 1m).
// Returns: dir, extreme, reclaimed, expanded, now (0 -, 1 EXPANDING, 2 CONSOLIDATING, 3 RETEST), expansion peak,
//          extreme set on the last sub-bar, candle high, candle low, reclaim count, flips
f_life(float[] ao, float[] ah, float[] al, float[] ac, float O, float tol) =>
    int dir = 0
    float ext = na
    bool recl = false
    bool expd = false
    int nowT = 0
    int extI = -1
    int recI = -1
    int rCount = 0
    int flips = 0
    int segSide = 0
    float segHi = O
    float segLo = O
    float sHi = O
    float sLo = O
    float pkHi = na
    float pkLo = na
    int n = array.size(ah)
    if n > 0
        for i = 0 to n - 1
            float h = array.get(ah, i)
            float l = array.get(al, i)
            float c = array.get(ac, i)
            float prevHi = sHi
            float prevLo = sLo
            sHi := math.max(sHi, h)
            sLo := math.min(sLo, l)
            segHi := math.max(segHi, h)
            segLo := math.min(segLo, l)
            int side = c > O + tol ? 1 : c < O - tol ? -1 : segSide
            bool crossed = false
            if segSide == 0
                segSide := side
            else if side != segSide
                // a confirmation candle closed through the open: RECLAIM in the direction it closed
                crossed := true
                if dir != 0 and recl and dir != side
                    flips += 1
                    rCount := 0
                ext := segSide == 1 ? segHi : segLo
                extI := i
                dir := side
                recl := true
                // the reclaim candle itself may already visit new prices for the candle
                expd := (side == 1 and h > prevHi) or (side == -1 and l < prevLo)
                rCount += 1
                recI := i
                pkHi := h
                pkLo := l
                segSide := side
                segHi := side == 1 ? h : c
                segLo := side == -1 ? l : c
            if not recl and segSide != 0
                // before the first reclaim: the extreme is forming on the side price is closing on
                float e0 = segSide == 1 ? segHi : segLo
                if na(ext) or e0 != ext
                    extI := i
                ext := e0
                dir := -segSide
            if recl and not crossed
                pkHi := math.max(pkHi, h)
                pkLo := math.min(pkLo, l)
                bool newP = dir == 1 ? h > prevHi : l < prevLo
                if newP
                    expd := true
                if i == n - 1
                    nowT := newP ? 1 : (dir == 1 ? l <= O + 2 * syminfo.mintick : h >= O - 2 * syminfo.mintick) ? 3 : 2
            else if recl and crossed and i == n - 1
                nowT := expd ? 1 : 3
    float peak = dir == 1 ? pkHi : pkLo
    [dir, ext, recl, expd, nowT, peak, n > 0 and extI == n - 1, sHi, sLo, rCount, flips]

// reference size of a chart candle: the larger of the previous candle's range and the 14-candle ATR
// (a tiny previous candle no longer makes every wiggle around the open count)
float bRef = math.max(nz(high[1] - low[1]), nz(ta.atr(14)))
[bSideL, bExtPL, bRFL, bExpL, bNowL, bPeakL, bExtL, sHiL, sLoL, bRcL, bFlL] = f_life(sbO, sbH, sbL, sbC, open, syminfo.mintick / 2)
[bSideT, bExtPT, bRFT, bExpT, bNowT, bPeakT, bExtT, sHiT, sLoT, bRcT, bFlT] = f_life(tk, tk, tk, tk, open, syminfo.mintick / 2)
bool useTicks = chSec <= 60
int bSide = useTicks ? bSideT : bSideL
float bExtRaw = useTicks ? bExtPT : bExtPL
float cHiS = useTicks ? sHiT : sHiL
float cLoS = useTicks ? sLoT : sLoL
// when the extreme is the candle's own high/low, show the chart candle's exact price (1m feed can differ by a few ticks)
int bRCount = useTicks ? bRcT : bRcL
int bFlips = useTicks ? bFlT : bFlL
// the extreme is the candle's own low (bullish) / high (bearish) unless the model has flipped: use the chart
// candle's exact price (the 1m feed can differ by a few ticks); after a flip, snap only when within 4 ticks
f_snapExt(int sd, float ex, int fl, float lo, float hi) =>
    sd == 1 and (fl == 0 or math.abs(ex - lo) <= 12 * syminfo.mintick) ? lo : sd == -1 and (fl == 0 or math.abs(ex - hi) <= 12 * syminfo.mintick) ? hi : ex
float bExtP = f_snapExt(bSide, bExtRaw, bFlips, low, high)
bool bRF = useTicks ? bRFT : bRFL
bool bExp = useTicks ? bExpT : bExpL
int bNow = useTicks ? bNowT : bNowL
bool bRC = bRF
bool bLostS = false
float bPeak = useTicks ? bPeakT : bPeakL
bool bExtLive = useTicks ? bExtT : bExtL
string tfTxt = chSec < 3600 ? str.tostring(math.round(chSec / 60)) + "m" : str.tostring(math.round(chSec / 3600)) + "H"

// effective geometry (mobile mode packs the drawings close to the last bar so they fit a phone screen)
int eP4 = mobile ? 3 : offP4H
int eC4 = mobile ? 8 : offC4H
int eW = mobile ? 2 : candleW
int ePath = mobile ? 10 : offPath
int eStep = mobile ? 2 : pathStep
string eSize = mobile ? mobSizeS : dashSizeS
string lblSz = mobile ? size.normal : size.small

// the current 4H candle's confirmation candles (3m / 5m; 1m on small charts), stored once per closed chart bar
var h4o = array.new_float()
var h4h = array.new_float()
var h4l = array.new_float()
var h4c = array.new_float()
if newC
    array.clear(h4o)
    array.clear(h4h)
    array.clear(h4l)
    array.clear(h4c)
if barstate.isconfirmed and inSess
    if chSec <= 60 or array.size(sbH) == 0
        array.push(h4o, open)
        array.push(h4h, high)
        array.push(h4l, low)
        array.push(h4c, close)
    else
        for q = 0 to array.size(sbH) - 1
            array.push(h4o, array.get(sbO, q))
            array.push(h4h, array.get(sbH, q))
            array.push(h4l, array.get(sbL, q))
            array.push(h4c, array.get(sbC, q))
    if array.size(h4c) > 2000
        array.shift(h4o)
        array.shift(h4h)
        array.shift(h4l)
        array.shift(h4c)

// ================= DRAWING =================
var bxs = array.new<box>()
var lns = array.new<line>()
var lbs = array.new<label>()
var stageNames = array.from("OPEN", "EXTREME", "RECLAIM", "EXPANSION")
var table dash = showDash ? table.new(f_pos(mobile ? mobPosS : dashPosS), 2, 22, bgcolor = dashBg, frame_color = color.new(color.gray, 60), frame_width = 1, border_color = color.new(color.gray, 80), border_width = 1) : na
var color clear = color.new(color.black, 100)

f_clear() =>
    while array.size(bxs) > 0
        box.delete(array.pop(bxs))
    while array.size(lns) > 0
        line.delete(array.pop(lns))
    while array.size(lbs) > 0
        label.delete(array.pop(lbs))

f_candle(int cx, int hw, float o, float h, float l, float c, int bodyTr, int wickTr, string txt) =>
    color col = c >= o ? bullCol : bearCol
    float top = math.max(o, c)
    float bot = math.min(o, c)
    array.push(bxs, box.new(left = cx - hw, top = top, right = cx + hw, bottom = bot, border_color = color.new(col, wickTr), border_width = 1, bgcolor = color.new(col, bodyTr)))
    array.push(lns, line.new(cx, top, cx, h, color = color.new(col, wickTr), width = wickW))
    array.push(lns, line.new(cx, bot, cx, l, color = color.new(col, wickTr), width = wickW))
    array.push(lbs, label.new(cx, h, txt, style = label.style_label_down, color = clear, textcolor = chart.fg_color, size = lblSz))

f_level(int x1, int x2, float y, color col, string sty, int w, string txt) =>
    if not na(y)
        array.push(lns, line.new(x1, y, x2, y, color = col, style = f_sty(sty), width = w, extend = extLeft ? extend.left : extend.none))
        bool onRight = lvlLblS == "Right"
        array.push(lbs, label.new(onRight ? x2 : x1, y, txt + " " + str.tostring(y, format.mintick), style = onRight ? label.style_label_left : label.style_label_right, color = col, textcolor = color.white, size = lblSz))

f_row(int r, string k, string v, color vc) =>
    table.cell(dash, 0, r, k, text_color = dashTxt, text_halign = text.align_left, text_size = f_size(eSize))
    table.cell(dash, 1, r, v, text_color = vc, text_halign = text.align_right, text_size = f_size(eSize))

// level list helpers (v3.0): heavier levels are added first; a level within 2 ticks of one already listed merges into it
f_addLv(string[] n, float[] p, int[] g, bool on, string nm, float px, int tier) =>
    bool added = false
    if on and not na(px)
        bool dup = false
        int sz = array.size(p)
        if sz > 0
            for j = 0 to sz - 1
                if not dup and math.abs(array.get(p, j) - px) <= syminfo.mintick * 2
                    dup := true
                    if array.get(g, j) > 0
                        array.set(n, j, array.get(n, j) + " +" + nm)
        if not dup
            array.push(n, nm)
            array.push(p, px)
            array.push(g, tier)
            added := true
    added

f_nearLv(string[] n, float[] p, float price, float tol) =>
    string best = ""
    float bd = tol
    int sz = array.size(p)
    if sz > 0 and not na(price)
        for j = 0 to sz - 1
            float d = math.abs(array.get(p, j) - price)
            if d <= bd
                bd := d
                best := array.get(n, j)
    best

f_tgtLv(string[] n, float[] p, float from, int dir) =>
    string tn = ""
    float tp = na
    float bg = 1e12
    int sz = array.size(p)
    if sz > 0 and not na(from) and dir != 0
        for j = 0 to sz - 1
            float pj = array.get(p, j)
            float gap = dir == 1 ? pj - from : from - pj
            if gap > syminfo.mintick * 4 and gap < bg
                bg := gap
                tn := array.get(n, j)
                tp := pj
    [tn, tp]

f_nm(string full, string ab) => mobile ? ab : full

if barstate.islast
    f_clear()
    // ---- stage
    float tCl = nz(float(time_close("240")), float(nz(t4, time)) + 14400000.0)
    bool closedNow = timenow >= tCl
    float tolP = syminfo.mintick / 2
    // 4H uses the same 4-stage life as the line (Mac 11/22): completed chart bars of this 4H candle,
    // then the live chart bar's own 1-minute bars (ticks on a 1m chart).
    a4o = array.copy(h4o)
    a4h = array.copy(h4h)
    a4l = array.copy(h4l)
    a4c = array.copy(h4c)
    if barstate.isconfirmed
        // this bar is already in the stored list
        array.clear(a4o)
        array.clear(a4h)
        array.clear(a4l)
        array.clear(a4c)
        array.concat(a4o, h4o)
        array.concat(a4h, h4h)
        array.concat(a4l, h4l)
        array.concat(a4c, h4c)
    else if useTicks and array.size(tk) > 0
        for q = 0 to array.size(tk) - 1
            float pq = array.get(tk, q)
            array.push(a4o, pq)
            array.push(a4h, pq)
            array.push(a4l, pq)
            array.push(a4c, pq)
    else if array.size(sbH) > 0
        for q = 0 to array.size(sbH) - 1
            array.push(a4o, array.get(sbO, q))
            array.push(a4h, array.get(sbH, q))
            array.push(a4l, array.get(sbL, q))
            array.push(a4c, array.get(sbC, q))
    else
        array.push(a4o, open)
        array.push(a4h, high)
        array.push(a4l, low)
        array.push(a4c, close)
    [side4, ext4Raw, r4, exp4, now4, pk4, el4, hi4S, lo4S, rCnt4, fl4] = f_life(a4o, a4h, a4l, a4c, kO, tolP)
    bool rc4 = r4
    bool lostS4 = false
    float ext4 = f_snapExt(side4, ext4Raw, fl4, kL, kH)
    bool beyond4 = r4 and exp4
    int stage = 1
    if side4 != 0
        stage := 2
        if r4 or lostS4
            stage := 3
            if beyond4
                stage := 4
    bool lost4 = stage == 3 and lostS4 and not r4
    string nowTxt4 = now4 == 1 ? "EXPANDING" : now4 == 3 ? "RETEST" : "CONSOLIDATING"
    string tag = stage == 2 ? (el4 ? " FORMING" : " SET") : stage == 3 ? (rCnt4 > 1 ? " ×" + str.tostring(rCnt4) : "") + (now4 == 3 ? " · RETEST" : " · HOLDING") : stage == 4 ? " · " + nowTxt4 : ""
    // DRIVE (v2.3): the extreme has run past the P4H's opposite side with no reclaim -> the candle is driving,
    // not forming an extreme. Shown as the drive's direction; never counts toward FULL ALIGNMENT.
    bool drive4 = side4 != 0 and not r4 and ((side4 == 1 and kC <= p4L) or (side4 == -1 and kC >= p4H))
    int drv4Dir = drive4 ? -side4 : 0
    string stageTxt = drive4 ? "2/4  DRIVE " + (drv4Dir == 1 ? "▲" : "▼") : str.tostring(stage) + "/4  " + array.get(stageNames, stage - 1) + tag
    // ENGULFING (v2.3): body past the P4H body. FORMING while live, CONFIRMED once the 4H closes; P4H ENGULFED = the last 4H was one.
    float p4BT = math.max(p4O, p4C)
    float p4BB = math.min(p4O, p4C)
    bool eng4Dn = kO >= p4BT and kC < p4BB
    bool eng4Up = kO <= p4BB and kC > p4BT
    bool eng4PDn = not na(p2O) and p4O >= math.max(p2O, p2C) and p4C < math.min(p2O, p2C)
    bool eng4PUp = not na(p2O) and p4O <= math.min(p2O, p2C) and p4C > math.max(p2O, p2C)
    string eng4Txt = eng4Dn ? (closedNow ? "CONFIRMED ▼" : "FORMING ▼") : eng4Up ? (closedNow ? "CONFIRMED ▲" : "FORMING ▲") : eng4PDn ? "P4H ENGULFED ▼" : eng4PUp ? "P4H ENGULFED ▲" : "—"
    int eng4Dir = eng4Dn or (not eng4Up and eng4PDn) ? -1 : eng4Up or eng4PUp ? 1 : 0
    // chart-candle stage (path line)
    bool bClosed = timenow >= time_close
    bool bBeyond = bRF and bExp
    int bStage = 1
    if bSide != 0
        bStage := 2
        if bRF or bLostS
            bStage := 3
            if bBeyond
                bStage := 4
    bool bLost = bStage == 3 and bLostS and not bRF
    string bNowTxt = bNow == 1 ? "EXPANDING" : bNow == 3 ? "RETEST" : "CONSOLIDATING"
    string bTag = bStage == 2 ? (bExtLive ? " FORMING" : " SET") : bStage == 3 ? (bRCount > 1 ? " ×" + str.tostring(bRCount) : "") + (bNow == 3 ? " · RETEST" : " · HOLDING") : bStage == 4 ? " · " + bNowTxt : ""
    bool bDrive = bSide != 0 and not bRF and ((bSide == 1 and close <= low[1]) or (bSide == -1 and close >= high[1]))
    int bDrvDir = bDrive ? -bSide : 0
    string bStageTxt = bDrive ? "2/4  DRIVE " + (bDrvDir == 1 ? "▲" : "▼") : str.tostring(bStage) + "/4  " + array.get(stageNames, bStage - 1) + bTag
    float pBT = math.max(open[1], close[1])
    float pBB = math.min(open[1], close[1])
    bool engDn = open >= pBT and close < pBB
    bool engUp = open <= pBB and close > pBT
    bool engPDn = open[1] >= math.max(open[2], close[2]) and close[1] < math.min(open[2], close[2])
    bool engPUp = open[1] <= math.min(open[2], close[2]) and close[1] > math.max(open[2], close[2])
    string engTxt = engDn ? (bClosed ? "CONFIRMED ▼" : "FORMING ▼") : engUp ? (bClosed ? "CONFIRMED ▲" : "FORMING ▲") : engPDn ? "LAST CANDLE ▼" : engPUp ? "LAST CANDLE ▲" : "—"
    int engDir = engDn or (not engUp and engPDn) ? -1 : engUp or engPUp ? 1 : 0

    // ---- FULL ALIGNMENT (Mac 11/22: "take trades when price is trading in full alignment")
    //   1. P4H closed in the model's direction (switchable)
    //   2. 4H model named, past its reclaim and not lost (RECLAIM / EXPANSION / TARGET)
    //   3. chart-timeframe candle has the same model, past its reclaim and not lost
    //      (RECLAIM counts only once CLOSED, switchable; EXPANSION / TARGET always count)
    int p4Dir = na(p4O) or na(p4C) ? 0 : p4C > p4O ? 1 : p4C < p4O ? -1 : 0
    bool ok4 = side4 != 0 and stage >= 3 and not lost4
    bool okCh = bSide != 0 and bSide == side4 and not bLost and (bStage == 4 or (bStage == 3 and bRF and (bRC or not alReqRC or useTicks)))
    bool okP4 = not alReqP4 or p4Dir == side4
    int alDir = ok4 and okCh and okP4 ? side4 : 0
    string alWhy = drive4 ? "4H DRIVE" : bDrive ? tfTxt + " DRIVE" : side4 == 0 ? "4H EXTREME NOT SET" : not okP4 ? "P4H AGAINST" : not ok4 ? (lost4 ? "4H RECLAIM LOST" : "4H NOT RECLAIMED") : bSide != side4 ? tfTxt + " AGAINST 4H" : bLost ? tfTxt + " RECLAIM LOST" : tfTxt + " NOT RECLAIMED"
    string fullTxt = alDir == 1 ? "LONG ✓" : alDir == -1 ? "SHORT ✓" : "NO · " + alWhy
    varip int alLast = 0
    if alAlert and alDir != 0 and alDir != alLast and barstate.isrealtime
        alert(syminfo.ticker + " FULL ALIGNMENT " + (alDir == 1 ? "LONG" : "SHORT") + " · 4H " + array.get(stageNames, stage - 1) + " · " + tfTxt + " " + array.get(stageNames, bStage - 1) + " · price " + str.tostring(close, format.mintick), alert.freq_once_per_bar)
    alLast := alDir

    int hw = int(eW / 2)
    int rightOff = 8
    if showCandles
        rightOff := math.max(rightOff, math.max(eP4, eC4) + hw + 2)
    if showPath
        rightOff := math.max(rightOff, ePath + 4 * eStep + 8)
    rightOff := math.min(rightOff, 450)

    // ---- Element 1: side candles
    if showCandles
        if not na(p4O)
            f_candle(bar_index + eP4, hw, p4O, p4H, p4L, p4C, p4Transp, p4WickTr, "P4H")
        if not na(kO)
            f_candle(bar_index + eC4, hw, kO, kH, kL, kC, c4Transp, 0, mobile ? "C4H" : "C4H LIVE")

    // ---- Element 2: formation path of the CHART-timeframe candle (not the 4H)
    if showPath
        // the chart candle's 4 stages, always all identified:
        //   a stage is drawn and labelled only once it has happened (Mac 11/22); "◀" marks the stage price is in now.
        //   Everything is rebuilt from the current chart bar on every tick, so a new candle starts a new path.
        int x0 = bar_index + ePath
        int xO = x0 + eStep
        int xE = x0 + 2 * eStep
        int xR = x0 + 3 * eStep
        int xX = x0 + 4 * eStep
        string tagSty = pathLblS == "Right" ? label.style_label_left : label.style_label_right
        array.push(lbs, label.new(x0, open, tfTxt + " CANDLE", style = label.style_label_right, color = clear, textcolor = pathCol, size = lblSz))
        array.push(lns, line.new(x0, open, xO, open, color = pathCol, width = pathW))
        int curX = xO
        float curY = open
        if bSide == 0
            array.push(lbs, label.new(xO, open, "1 OPEN ◀  waiting for the extreme", style = tagSty, color = clear, textcolor = pathCol, size = lblSz))
        else
            array.push(lbs, label.new(xO, open, "1 OPEN", style = label.style_label_down, color = clear, textcolor = chart.fg_color, size = lblSz))
            array.push(lns, line.new(xO, open, xE, bExtP, color = pathCol, width = pathW))
            bool atExt = not bRF and not bLost
            string extLbl = bDrive ? "2 DRIVE " + (bDrvDir == 1 ? "▲ " : "▼ ") + f_px(bExtP) : "2 EXTREME " + f_px(bExtP)
            color extCol = bDrive ? (bDrvDir == 1 ? bullCol : bearCol) : atExt ? pathCol : chart.fg_color
            array.push(lbs, label.new(xE, bExtP, extLbl + (atExt ? " ◀" : ""), style = tagSty, color = clear, textcolor = extCol, size = lblSz))
            if atExt
                curX := xE
                curY := bExtP
            else
                array.push(lns, line.new(xE, bExtP, xR, open, color = pathCol, width = pathW))
                bool atRcl = bStage == 3 and not bLost
                array.push(lbs, label.new(xR, open, "3 RECLAIM" + (bRCount > 1 ? " ×" + str.tostring(bRCount) : "") + (atRcl ? (bNow == 3 ? " · RETEST ◀" : " · HOLDING ◀") : ""), style = tagSty, color = clear, textcolor = atRcl ? pathCol : chart.fg_color, size = lblSz))
                if bLost
                    array.push(lns, line.new(xR, open, xX, close, color = lostCol, width = pathW, style = line.style_dashed))
                    array.push(lbs, label.new(xX, close, "RECLAIM LOST ◀", style = tagSty, color = clear, textcolor = lostCol, size = lblSz))
                    curX := xX
                    curY := close
                else if bStage >= 4
                    // the expansion leg goes to the new prices the candle visited; the live price is marked after it
                    array.push(lns, line.new(xR, open, xX, bPeak, color = pathCol, width = pathW))
                    array.push(lbs, label.new(xX, bPeak, "4 EXPANSION " + f_px(bPeak) + (bNow == 1 ? " ◀" : ""), style = tagSty, color = clear, textcolor = bNow == 1 ? pathCol : chart.fg_color, size = lblSz))
                    curX := xX
                    curY := bPeak
                    if bNow != 1
                        array.push(lns, line.new(xX, bPeak, xX + eStep, close, color = pathCol, width = 1, style = line.style_dotted))
                        array.push(lbs, label.new(xX + eStep, close, (bNow == 3 ? "RETEST" : "CONSOLIDATING") + " ◀", style = tagSty, color = clear, textcolor = pathCol, size = lblSz))
                        curX := xX + eStep
                        curY := close
                else
                    // reclaimed, no new prices yet: mark the live price beside the reclaim
                    array.push(lns, line.new(xR, open, xX, close, color = pathCol, width = 1, style = line.style_dotted))
                    curX := xX
                    curY := close
        array.push(lbs, label.new(curX, curY, "", style = label.style_circle, color = bLost ? lostCol : pathCol, size = size.tiny))

    if showLevels
        int x1 = na(p4Start) ? bar_index - 30 : math.max(p4Start, bar_index - 4900)
        int x2 = bar_index + rightOff
        f_level(x1, x2, p4H, p4hHiCol, p4hHiSty, lvlW, mobile ? "P4H H" : "P4H HIGH")
        f_level(x1, x2, p4L, p4hLoCol, p4hLoSty, lvlW, mobile ? "P4H L" : "P4H LOW")
        f_level(x1, x2, p4O, p4hOpCol, p4hOpSty, lvlW, mobile ? "P4H O" : "P4H OPEN")
        f_level(x1, x2, kO, c4hOpCol, c4hOpSty, c4hOpW, mobile ? "C4H O" : "C4H OPEN")

    // ---- Element 4: dashboard
    // ---- YOUR LEVELS (v3.0): the 4H references first, then Levels PRO v2.4.2's set by its own weights ----
    lvN = array.new_string()
    lvP = array.new_float()
    lvG = array.new_int()
    f_addLv(lvN, lvP, lvG, true, "P4H H", p4H, 0)
    f_addLv(lvN, lvP, lvG, true, "P4H L", p4L, 0)
    f_addLv(lvN, lvP, lvG, true, "C4H O", kO, 0)
    f_addLv(lvN, lvP, lvG, true, "P4H O", p4O, 0)
    if showLv
        f_addLv(lvN, lvP, lvG, lvPM, "PMoH", pmoh_v, 3)
        f_addLv(lvN, lvP, lvG, lvPM, "PMoL", pmol_v, 3)
        f_addLv(lvN, lvP, lvG, lvWeek, "PWH", pwh_v, 3)
        f_addLv(lvN, lvP, lvG, lvWeek, "PWL", pwl_v, 3)
        f_addLv(lvN, lvP, lvG, lvMO, "MO", mo_v, 3)
        f_addLv(lvN, lvP, lvG, lvPDH, "PDH", prevDayHi, 2)
        f_addLv(lvN, lvP, lvG, lvPDH, "PDL", prevDayLo, 2)
        f_addLv(lvN, lvP, lvG, lvOpens, f_nm("06:30 Open", "NYO"), o0630, 1)
        f_addLv(lvN, lvP, lvG, lvVW, f_nm("VWAP", "VW"), sessVWAP, 2)
        f_addLv(lvN, lvP, lvG, lvWeek, f_nm("Week Open", "WO"), wk_open, 3)
        f_addLv(lvN, lvP, lvG, lvMHML, "MH", mh_v, 3)
        f_addLv(lvN, lvP, lvG, lvMHML, "ML", ml_v, 3)
        f_addLv(lvN, lvP, lvG, lvPDC, "PDC", prevDayC, 2)
        f_addLv(lvN, lvP, lvG, lvAsia, f_nm("Asia High", "AH"), asiaHi, 1)
        f_addLv(lvN, lvP, lvG, lvAsia, f_nm("Asia Low", "AL"), asiaLo, 1)
        f_addLv(lvN, lvP, lvG, lvLon, f_nm("London High", "LH"), lonHi, 1)
        f_addLv(lvN, lvP, lvG, lvLon, f_nm("London Low", "LL"), lonLo, 1)
        f_addLv(lvN, lvP, lvG, lvOpens, f_nm("15:00 Open", "1500"), o1500, 1)
        f_addLv(lvN, lvP, lvG, lvPWO, "PWO", pwo_v, 3)
        f_addLv(lvN, lvP, lvG, lvPM, "PMO", pmo_v, 3)
        f_addLv(lvN, lvP, lvG, lvDO, f_nm("Daily Open", "DO"), dayOpen, 2)
        f_addLv(lvN, lvP, lvG, lvIB, f_nm("IB High", "IBH"), ibHi, 1)
        f_addLv(lvN, lvP, lvG, lvIB, f_nm("IB Low", "IBL"), ibLo, 1)
        // draw the nearest N (the 4H references are drawn by the level lines above)
        int nL = array.size(lvP)
        int maxN = mobile ? lvMaxMob : lvMax
        if nL > 0
            for j = 0 to nL - 1
                int tr = array.get(lvG, j)
                if tr > 0
                    float pj = array.get(lvP, j)
                    float dj = math.abs(pj - close)
                    int rk = 0
                    for q = 0 to nL - 1
                        if q != j and array.get(lvG, q) > 0 and math.abs(array.get(lvP, q) - close) < dj
                            rk += 1
                    if rk < maxN
                        color lc = tr == 3 ? lvColW : tr == 2 ? lvColD : lvColS
                        int lx1 = math.max(0, bar_index - lvBack)
                        int lx2 = bar_index + rightOff
                        bool onR = lvlLblS == "Right"
                        array.push(lns, line.new(lx1, pj, lx2, pj, color = lc, width = tr == 3 ? 2 : 1, style = tr == 1 ? line.style_dotted : line.style_solid))
                        array.push(lbs, label.new(onR ? lx2 : lx1, pj, array.get(lvN, j) + " " + str.tostring(pj, format.mintick), style = onR ? label.style_label_left : label.style_label_right, color = color.new(#060B14, 15), textcolor = lc, size = lblSz))

    // ---- AT LEVEL: an extreme that formed at one of the levels (a sweep of a level, then the reclaim = the A+ setup)
    float tolB = math.max(syminfo.mintick * 4, bRef * atLvlPct / 100)
    float tol4L = math.max(syminfo.mintick * 4, nz(p4H - p4L) * atLvlPct / 200)
    string atB = bSide != 0 and not bDrive ? f_nearLv(lvN, lvP, bExtP, tolB) : ""
    string at4 = side4 != 0 and not drive4 ? f_nearLv(lvN, lvP, ext4, tol4L) : ""
    string atTxt = atB == "" and at4 == "" ? "—" : (atB != "" ? tfTxt + " extreme at " + atB : "") + (atB != "" and at4 != "" ? " · " : "") + (at4 != "" ? "4H extreme at " + at4 : "")

    // ---- TRADE PLAN (v3.0): WAIT -> ARMED -> GO, or INVALID / SKIP
    //   WAIT    the 4H is not ready (no extreme, DRIVE, P4H against, not reclaimed or reclaim lost) or the chart candle is not with it
    //   ARMED   the 4H is past its reclaim with P4H; the chart candle has its extreme in the same direction; waiting for its reclaim
    //   GO      FULL ALIGNMENT: the chart candle's reclaim is confirmed (or it is expanding); entry = its open, stop beyond its extreme
    //   SKIP    GO, but the next level gives less than the minimum R
    //   INVALID the chart candle's reclaim was lost
    int D = side4
    int pState = 0
    string pWhy = ""
    float eP = open
    float sP = na
    string tN = ""
    float tP = na
    float rr = na
    if drive4
        pWhy := "4H DRIVE"
    else if D == 0
        pWhy := "4H no extreme yet"
    else if not okP4
        pWhy := "P4H against"
    else if lost4
        pWhy := "4H reclaim lost"
    else if stage < 3
        pWhy := "4H reclaim " + f_px(kO)
    else if bDrive or bSide == -D
        pWhy := tfTxt + " against"
    else if bSide == 0
        pWhy := tfTxt + " no extreme yet"
    else if bLost
        pState := 3
        pWhy := tfTxt + " reclaim lost"
    else if alDir == D
        pState := 2
    else
        pState := 1
        pWhy := (bStage == 3 ? "reclaim forming " : "reclaim ") + f_px(open)
    if pState == 1 or pState == 2
        sP := D == 1 ? bExtP - stopTk * syminfo.mintick : bExtP + stopTk * syminfo.mintick
        [tn0, tp0] = f_tgtLv(lvN, lvP, eP, D)
        tN := tn0
        tP := tp0
        float rkP = math.abs(eP - sP)
        rr := na(tP) or rkP <= 0 ? na : math.abs(tP - eP) / rkP
        if pState == 2 and not na(rr) and rr < minR
            pState := 4
    float usd = syminfo.pointvalue * contracts
    float riskPts = na(sP) ? na : math.abs(eP - sP)
    float rewPts = na(tP) ? na : math.abs(tP - eP)
    string rTxt = na(rr) ? "R —" : str.tostring(rr, "0.0") + "R"
    string money = na(riskPts) ? "" : "-$" + str.tostring(riskPts * usd, "#,##0") + (na(rewPts) ? "" : " / +$" + str.tostring(rewPts * usd, "#,##0"))
    string riskTxt = na(sP) ? "—" : "E " + f_px(eP) + "  S " + f_px(sP) + "  T " + (na(tP) ? "no level" : f_px(tP) + " " + tN) + "  ·  " + rTxt + "  ·  " + money
    string riskM = na(sP) ? "—" : rTxt + "  " + money
    string dirW = D == 1 ? "LONG" : "SHORT"
    string star = atB != "" ? " ★" : ""
    string planTxt = pState == 2 ? "GO " + dirW + star : pState == 4 ? "SKIP " + dirW + " · " + rTxt + star : pState == 1 ? "ARMED " + dirW + " · " + pWhy + star : pState == 3 ? "INVALID · " + pWhy : "WAIT · " + pWhy
    color planCol = pState == 2 ? (D == 1 ? bullCol : bearCol) : pState == 1 ? #ffb300 : pState == 3 ? lostCol : pState == 4 ? #ffb300 : dashTxt
    varip int planLast = -1
    if planAlert and barstate.isrealtime and pState != planLast and (pState == 1 or pState == 2 or pState == 3)
        alert(syminfo.ticker + " " + tfTxt + " " + planTxt + (atTxt != "—" ? " · " + atTxt : "") + (pState == 2 ? " · " + riskTxt : "") + " · price " + str.tostring(close, format.mintick), alert.freq_once_per_bar)
    planLast := pState

    if showDash
        table.cell(dash, 0, 0, pState == 2 ? (mobile ? "GO " + dirW : "4H LIVE MODEL · GO " + dirW) : pState == 1 ? (mobile ? "ARMED " + dirW : "4H LIVE MODEL · ARMED " + dirW) : "4H LIVE MODEL", text_color = dashTxt, text_halign = text.align_center, text_size = f_size(eSize), bgcolor = pState == 2 ? color.new(D == 1 ? bullCol : bearCol, 25) : pState == 1 ? color.new(#ffb300, 45) : color.new(pathCol, 35))
        table.merge_cells(dash, 0, 0, 1, 0)
        string modelTxt = drive4 ? (drv4Dir == 1 ? "BULLISH DRIVE" : "BEARISH DRIVE") : side4 == 1 ? "BULLISH" : side4 == -1 ? "BEARISH" : "—"
        color modelCol = drive4 ? (drv4Dir == 1 ? bullCol : bearCol) : side4 == 1 ? bullCol : side4 == -1 ? bearCol : dashTxt
        color eng4Col = eng4Dir == 1 ? bullCol : eng4Dir == -1 ? bearCol : dashTxt
        color engCol = engDir == 1 ? bullCol : engDir == -1 ? bearCol : dashTxt
        float tol = syminfo.mintick / 2
        string loc = na(kC) or na(kO) ? "—" : kC > kO + tol ? "ABOVE OPEN" : kC < kO - tol ? "BELOW OPEN" : "AT OPEN"
        string extTxt = side4 == 1 ? "LOW " + f_px(ext4) : side4 == -1 ? "HIGH " + f_px(ext4) : "—"
        string tgtTxt = side4 == 1 ? "P4H HIGH " + f_px(p4H) : side4 == -1 ? "P4H LOW " + f_px(p4L) : "—"
        string rngTxt = f_px(kH - kL) + " / " + f_px(p4O)
        string cdTxt = closedNow ? "—" : f_cd(tCl - timenow)
        // previous 4H candle's direction and whether the current 4H model runs with it or against it
        string p4Txt = na(p4O) ? "—" : p4Dir == 1 ? "BULLISH" : p4Dir == -1 ? "BEARISH" : "DOJI"
        color p4Col = p4Dir == 1 ? bullCol : p4Dir == -1 ? bearCol : dashTxt
        string alTxt = side4 == 0 or p4Dir == 0 ? "—" : side4 == p4Dir ? "WITH P4H" : "COUNTER P4H"
        color alCol = side4 == 0 or p4Dir == 0 ? dashTxt : side4 == p4Dir ? modelCol : #ffb300
        if mobile
            // 7 rows sized for a phone: what you need at a glance
            var shortNames = array.from("OPEN", "EXTREME", "RECLAIM", "EXPAND")
            string n4M = stage == 4 ? (now4 == 1 ? " ▶" : now4 == 3 ? " RT" : " CONS") : stage == 3 ? (now4 == 3 ? " RT" : "") : ""
            string nBM = bStage == 4 ? (bNow == 1 ? " ▶" : bNow == 3 ? " RT" : " CONS") : bStage == 3 ? (bNow == 3 ? " RT" : "") : ""
            string s4 = drive4 ? (drv4Dir == 1 ? "DRIVE ▲" : "DRIVE ▼") : (side4 == 1 ? "BULL " : side4 == -1 ? "BEAR " : "— ") + str.tostring(stage) + "/4 " + array.get(shortNames, stage - 1) + n4M
            string sB = bDrive ? (bDrvDir == 1 ? "DRIVE ▲" : "DRIVE ▼") : (bSide == 1 ? "BULL " : bSide == -1 ? "BEAR " : "— ") + str.tostring(bStage) + "/4 " + array.get(shortNames, bStage - 1) + nBM
            f_row(1, "PLAN", planTxt, planCol)
            f_row(2, "RISK", riskM, pState == 2 ? planCol : dashTxt)
            f_row(3, "4H", s4, lost4 ? lostCol : modelCol)
            f_row(4, tfTxt, sB, bLost ? lostCol : bDrive ? (bDrvDir == 1 ? bullCol : bearCol) : bSide == 1 ? bullCol : bSide == -1 ? bearCol : dashTxt)
            f_row(5, "P4H", p4Txt, p4Col)
            f_row(6, "ALIGN", alDir == 1 ? "LONG ✓" : alDir == -1 ? "SHORT ✓" : alWhy, alDir == 1 ? bullCol : alDir == -1 ? bearCol : #ffb300)
            f_row(7, "OPEN", f_px(kO) + (kC > kO + tol ? " ▲" : kC < kO - tol ? " ▼" : " ="), dashTxt)
            f_row(8, "4H CLOSE", cdTxt, dashTxt)
            string engM = eng4Txt != "—" ? "4H " + eng4Txt : engTxt != "—" ? tfTxt + " " + engTxt : "—"
            f_row(9, "ENGULF", engM, eng4Txt != "—" ? eng4Col : engCol)
        else
            f_row(1, "PLAN", planTxt, planCol)
            f_row(2, "RISK", riskTxt, pState == 2 ? planCol : dashTxt)
            f_row(3, "AT LEVEL", atTxt, atTxt == "—" ? dashTxt : #ffc53d)
            f_row(4, "MODEL", modelTxt, modelCol)
            f_row(5, "P4H CANDLE", p4Txt, p4Col)
            f_row(6, "ALIGNMENT", alTxt, alCol)
            f_row(7, "STAGE", stageTxt, lost4 ? lostCol : dashTxt)
            f_row(8, "LOCATION", loc, dashTxt)
            f_row(9, "C4H OPEN", f_px(kO), dashTxt)
            f_row(10, "C4H EXTREME", extTxt, dashTxt)
            f_row(11, "P4H HIGH", f_px(p4H), dashTxt)
            f_row(12, "P4H LOW", f_px(p4L), dashTxt)
            f_row(13, "RANGE / P4H O", rngTxt, dashTxt)
            f_row(14, "NEXT TARGET", tgtTxt, modelCol)
            f_row(15, "4H CLOSE IN", cdTxt, dashTxt)
            f_row(16, tfTxt + " CANDLE", bDrive ? (bDrvDir == 1 ? "BULLISH DRIVE" : "BEARISH DRIVE") : bSide == 1 ? "BULLISH" : bSide == -1 ? "BEARISH" : "—", bDrive ? (bDrvDir == 1 ? bullCol : bearCol) : bSide == 1 ? bullCol : bSide == -1 ? bearCol : dashTxt)
            f_row(17, tfTxt + " STAGE", bStageTxt, bLost ? lostCol : dashTxt)
            f_row(18, "FULL ALIGNMENT", fullTxt, alDir == 1 ? bullCol : alDir == -1 ? bearCol : dashTxt)
            f_row(19, "4H ENGULF", eng4Txt, eng4Col)
            f_row(20, tfTxt + " ENGULF", engTxt, engCol)
