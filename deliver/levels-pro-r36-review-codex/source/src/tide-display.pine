
// == TIDE DISPLAY BEGIN (17D-17E: drawing only; the parity harness runs the engine above it) ==========
// ---------------------------------------------------------------- 17D. TIDE on the chart (display only): the 1m feed, the focus level, the chip
// One request: the chart bar's CLOSED 1m bars (intrabars), the bot's own input. On a 1m chart this is the bar itself.
[tx_t, tx_o, tx_h, tx_l, tx_c, tx_v] = request.security_lower_tf(syminfo.tickerid, "1", [time, open, high, low, close, volume], ignore_invalid_timeframe=true)
bool td_ok = td_on and timeframe.isintraday and not timeframe.isseconds and timeframe.multiplier <= 60 and chart.is_standard
if td_ok and (last_bar_index - bar_index) * tf_min <= td_hist
    G.wH := pwh_v
    G.wL := pwl_v
    G.wO := wk_open
    G.wId := time("W")
    int n = array.size(tx_t)
    if n > 0
        for i = 0 to n - 1
            // a realtime chart bar's last intrabar is still forming until the chart bar closes
            if not barstate.isrealtime or i < n - 1 or barstate.isconfirmed
                t_step(array.get(tx_t, i), array.get(tx_o, i), array.get(tx_h, i), array.get(tx_l, i), array.get(tx_c, i), array.get(tx_v, i), false, na, na)
int td_T = G.lastT + 60
// the registry key of a TIDE board level (tags, glow): 13 4H Open, 0 PDH, 1 PDL, 4/5 Asia, 6/7 London, 14 1H Open
t_key(string nm) =>
    nm == "4H Open" ? 13 : nm == "PDH" ? 0 : nm == "PDL" ? 1 : nm == "Asia High" ? 4 : nm == "Asia Low" ? 5 : nm == "London High" ? 6 : nm == "London Low" ? 7 : nm == "1H Open" ? 14 : -1
t_arrow(int d) =>
    d > 0 ? "▲" : d < 0 ? "▼" : ""
t_srcl(string s) =>
    s == "board" ? "B" : s == "or" ? "OR" : s == "eq" ? "EQ" : "R"
// the global gates of this minute (the chip's STAND DOWN reasons), in the board's codes
t_glob(int T) =>
    t_blk(T) ? "TIME_BLOCK" : t_owE(T) or t_owW(T) ? "OPEN_WAIT" : t_sc(T) ? "SESSION_CLOSE" : not G.msK ? "1H range unknown" : ""
// the focus: retest-pending > armed > broken / accepted / failed > watching, then the nearest to price
t_focus(int T) =>
    TZone fz = na
    int fr = -1
    float fd = 1e12
    for z in ZS
        if z.src != "round"
            [st, dr, ln, s0, cd] = t_zs(z, T)
            int r = st == "retest-pending" ? 3 : st == "armed" ? 2 : st == "broken" or st == "accepted" or st == "failed" ? 1 : 0
            float d = math.abs(close - z.p)
            if r > fr or (r == fr and d < fd)
                fz := z
                fr := r
                fd := d
    fz
TZone td_z = td_ok ? t_focus(td_T) : na
[td_st, td_dir, td_lane, td_s, td_cd] = t_zs(na(td_z) ? TZone.new(0.0, 0.0, "-", "-", 0.0, "round") : td_z, td_T)
string td_g = td_ok ? t_glob(td_T) : "TIDE off"
bool td_against = td_dir != 0 and G.cDir != 0 and td_dir != G.cDir
// Observed opposition can be waived by r3.6; do not turn it into an unconditional stand-down.
int td_rank = not td_ok or na(td_z) or td_g != "" ? 0 : td_st == "retest-pending" ? 3 : td_st == "armed" ? 2 : 1
bool td_m0 = na(td_z) ? false : t_mid(na(td_s) ? td_z.p : td_s.lvl)
bool td_mid = na(td_m0) ? true : td_m0
int td_n = (G.cDir != 0 ? 1 : 0) + (td_st == "failed" or td_st == "accepted" or td_st == "armed" or td_st == "retest-pending" ? 1 : 0) + (G.msK and not td_mid ? 1 : 0) + ((na(td_s) ? 0 : td_s.rno) <= 1 and td_g == "" ? 1 : 0)
int td_k = na(td_z) ? -1 : t_key(td_z.nm)
float td_px = na(td_z) ? close : td_z.p
// the reference stop of an armed setup (contract r1.4): the engine's stop rule + stopBuf; null until the accepted retest exists
t_refstop(TSet s) =>
    TBar h1 = t_fol(2, B60)
    float hw = na(h1) ? na : s.dir < 0 ? h1.h + 2 : h1.l - 2
    float r = na
    if s.kind == 0
        r := s.s4 ? (s.dir < 0 ? s.ext + 2 : s.ext - 2) : hw
    else if s.rt
        float rx = s.dir < 0 ? s.rx + 2 : s.rx - 2
        r := s.s4 or na(hw) ? rx : s.dir < 0 ? math.max(hw, rx) : math.min(hw, rx)
    r
// one tag's TIDE word and tooltip, for a registry level that is a TIDE zone member right now
t_tag(int k, float px) =>
    string nm = k == 13 ? "4H Open" : k == 0 ? "PDH" : k == 1 ? "PDL" : k == 4 ? "Asia High" : k == 5 ? "Asia Low" : k == 6 ? "London High" : k == 7 ? "London Low" : k == 14 ? "1H Open" : ""
    string w = ""
    string tip = ""
    if nm != "" and not na(px)
        for z in ZS
            if w == "" and str.contains(z.mem, "|" + nm + "|") and px >= z.lo - 0.5 and px <= z.hi + 0.5
                [st, dr, ln, s0, cd] = t_zs(z, td_T)
                w := "· " + (st == "watching" ? "TIDE" : st + t_arrow(dr)) + (na(s0) ? "" : s0.rno > 0 ? " R" + str.tostring(s0.rno) : "")
                tip := "\nTIDE zone " + z.nm + " (" + z.src + ", " + (z.t4 ? "4H" : "1H") + " type) " + str.tostring(z.lo, format.mintick) + "-" + str.tostring(z.hi, format.mintick) + ": " + st + (dr != 0 ? (dr > 0 ? " long" : " short") : "") + (ln == 0 ? ", failed-break lane" : ln == 1 ? ", accepted-break lane" : "") + (cd != "" ? "\nblockedBy: " + cd : "") + (na(s0) ? "" : na(s0.why) ? "" : "\n" + s0.why) + "\nThe bot's engine words (contract r1.4). NEWS_WAIT and the broker are not visible on a chart."
    [w, tip]
// the HUD rows (17E reads them)
t_ctlrow() =>
    G.cDir == 0 ? "4H none" + (td_T <= nz(G.pWait) ? " · wait " + str.format_time(G.pWait * 1000, "HH:mm", "America/Los_Angeles") : "") : "4H " + t_arrow(G.cDir) + (G.cKind == "trap" ? " TRAP " + str.tostring(G.cExt, format.mintick) : " BIAS≈") + " · " + str.format_time(G.cT * 1000 - 60000, "HH:mm", "America/Los_Angeles")
t_msrow() =>
    not G.msK ? "1H unknown" : G.ms == "RANGE" ? "1H RANGE " + str.tostring(G.msLo, "#") + "-" + str.tostring(G.msHi, "#") : G.ms == "TREND" ? "1H TREND " + t_arrow(G.msDir) : "1H TRANSITION"
t_bsrow() =>
    "CTRL≈ 15m " + (na(G.b15) ? "--" : (G.b15 >= 0 ? "+" : "") + str.tostring(G.b15, "0.00")) + " 30m " + (na(G.b30) ? "--" : (G.b30 >= 0 ? "+" : "") + str.tostring(G.b30, "0.00"))

// ---------------------------------------------------------------- 17E. TIDE drawings (pooled, last bar only)
int TDN = 10
var box[] TDB = array.new_box(0)
var box[] TDR = array.new_box(0)
var box[] TDP = array.new_box(0)
var box   TDM = na
var box   TDX = na
var line[] TDV = array.new_line(0)
var label[] TDL = array.new_label(0)
if barstate.isfirst
    for i = 0 to TDN - 1
        array.push(TDB, box.new(bar_index, close, bar_index + 1, close, border_color=col_hide, bgcolor=col_hide, text_size=size.tiny, text_halign=text.align_left, text_color=col_hide))
    for i = 0 to 3
        array.push(TDR, box.new(bar_index, close, bar_index + 1, close, border_color=col_hide, bgcolor=col_hide, text_size=size.tiny, text_halign=text.align_right, text_color=col_hide))
        array.push(TDP, box.new(bar_index, close, bar_index + 1, close, border_color=col_hide, bgcolor=col_hide, text_size=size.tiny, text_halign=text.align_right, text_color=col_hide))
    TDM := box.new(bar_index, close, bar_index + 1, close, border_color=col_hide, bgcolor=col_hide, text="1H RANGE mid band: no TIDE entry (MID_RANGE)", text_size=size.tiny, text_halign=text.align_left, text_color=col_hide)
    TDX := box.new(bar_index, close, bar_index + 1, close, border_color=col_hide, bgcolor=col_hide, text_size=size.tiny, text_halign=text.align_left, text_color=col_hide)
    for i = 0 to 1
        array.push(TDV, line.new(time, close, time, close + 1, xloc=xloc.bar_time, extend=extend.both, color=col_hide, style=i == 0 ? line.style_dashed : line.style_solid))
        array.push(TDL, label.new(time, close, "", xloc=xloc.bar_time, style=label.style_label_down, size=size.tiny, color=col_hide, textcolor=col_hide))
t_bx(box b, float top, float bot, color bg, color bc, string txt, color tc) =>
    box.set_lefttop(b, math.max(bar_index - lookback_l, 0), top)
    box.set_rightbottom(b, bar_index + extend_r, bot)
    box.set_bgcolor(b, bg)
    box.set_border_color(b, bc)
    box.set_text(b, txt)
    box.set_text_color(b, tc)
t_hide(box b) =>
    t_bx(b, close, close, col_hide, col_hide, "", col_hide)
t_draw() =>
    color fg = chart.fg_color
    // zone bands: the TIDE zones nearest price (non-round)
    array<TZone> zs = array.new<TZone>()
    for z in ZS
        if z.src != "round" and math.abs(close - z.p) <= atr_ref * distant_atr * 2
            int j = array.size(zs)
            while j > 0
                if math.abs(close - array.get(zs, j - 1).p) > math.abs(close - z.p)
                    j -= 1
                else
                    break
            array.insert(zs, j, z)
    for i = 0 to TDN - 1
        box b = array.get(TDB, i)
        if td_zones and i < array.size(zs)
            TZone z = array.get(zs, i)
            [st, dr, ln, s0, cd] = t_zs(z, td_T)
            color c = st == "watching" or dr == 0 ? color.new(fg, 94) : color.new(dr > 0 ? col_buy : col_sell, st == "retest-pending" ? 78 : 88)
            t_bx(b, z.hi, z.lo, c, col_hide, z.nm + " " + t_srcl(z.src) + " · " + st + t_arrow(dr) + (na(s0) ? "" : s0.rno > 0 ? " R" + str.tostring(s0.rno) : "") + (cd != "" ? "  ✕ " + cd : ""), color.new(fg, 40))
        else
            t_hide(b)
    // rounds: context only, never a target or a setup (r3.2 ruling 2): the 2 nearest above and below
    int ra = 0
    int rb = 0
    for i = 0 to 3
        t_hide(array.get(TDR, i))
    for z in ZS
        if td_zones and z.src == "round" and math.abs(z.p - close) <= 100
            int slot = z.p > close ? (ra < 2 ? ra : -1) : (rb < 2 ? 2 + rb : -1)
            if slot >= 0
                t_bx(array.get(TDR, slot), z.p + 0.25, z.p - 0.25, color.new(fg, 90), col_hide, "R " + str.tostring(z.p, "#") + " ctx · never a target", color.new(fg, 60))
                ra += z.p > close ? 1 : 0
                rb += z.p > close ? 0 : 1
    // the 1H mid band and the 4H trap extreme
    if td_ok and G.msK and G.ms == "RANGE"
        float w = G.msHi - G.msLo
        t_bx(TDM, G.msHi - w * 0.25, G.msLo + w * 0.25, color.new(fg, 95), col_hide, "1H RANGE " + str.tostring(G.msLo, "#") + "-" + str.tostring(G.msHi, "#") + " mid band: no TIDE entry (MID_RANGE)", color.new(fg, 55))
    else
        t_hide(TDM)
    if td_ok and G.cKind == "trap"
        t_bx(TDX, G.cExt + 0.25, G.cExt - 0.25, color.new(G.cDir < 0 ? col_sell : col_buy, 70), col_hide, "4H TRAP " + t_arrow(G.cDir) + " ext " + str.tostring(G.cExt, format.mintick) + ": control holds until taken back or the 4H closes", color.new(fg, 30))
    else
        t_hide(TDX)
    // the plan: the engine's numbers on a signal (an hour, or while the virtual trade is open); on an armed focus the reference stop only
    bool vo = false
    for x in VT
        vo := vo or not x.cl
    bool sg = td_ok and td_plan and not na(G.sigT) and (td_T - G.sigT <= 3600 or vo)
    array<float> pv = sg ? array.from(G.sigE, G.sigS, G.sigT1, G.sigT2) : array.from(float(na), na, na, na)
    array<string> pn = array.from("TIDE E ", "SL ", "TP1 2/3 ", "TP2 ")
    if not sg and td_ok and td_plan and (na(td_s) ? false : td_s.stat == 0 and na(td_s.ent))
        array.set(pv, 0, td_s.lvl)
        array.set(pv, 1, t_refstop(td_s))
        array.set(pn, 0, "ref E ")
        array.set(pn, 1, "ref SL ")
    for i = 0 to 3
        float p = array.get(pv, i)
        if na(p)
            t_hide(array.get(TDP, i))
        else
            color c = i == 1 ? col_sell : i == 0 ? col_viol : col_buy
            t_bx(array.get(TDP, i), p + 0.25, p - 0.25, color.new(c, 40), col_hide, array.get(pn, i) + str.tostring(p, format.mintick) + (i == 0 and sg ? (G.sigDir > 0 ? " LONG " : " SHORT ") + G.sigTxt : ""), color.new(c, 10))
    // 12:55 no entry and 13:05 flat (ruling 8), for the session in play (early-close days are not known to the chart)
    int ts = time + (t_ptm(int(time / 1000)) >= 900 ? 86400000 : 0)
    for i = 0 to 1
        int x = timestamp("America/Los_Angeles", year(ts, "America/Los_Angeles"), month(ts, "America/Los_Angeles"), dayofmonth(ts, "America/Los_Angeles"), i == 0 ? 12 : 13, i == 0 ? 55 : 5)
        line v = array.get(TDV, i)
        label lb = array.get(TDL, i)
        line.set_xy1(v, x, close)
        line.set_xy2(v, x, close + 1)
        line.set_color(v, td_ok and td_shade ? color.new(i == 0 ? col_amber : col_sell, 45) : col_hide)
        label.set_xy(lb, x, high + atr_ref * 0.5)
        label.set_text(lb, td_ok and td_shade ? (i == 0 ? "12:55 TIDE no entry" : "13:05 flat") : "")
        label.set_textcolor(lb, td_ok and td_shade ? color.new(i == 0 ? col_amber : col_sell, 20) : col_hide)
    0
// TIDE time shading: blocks 15:00-17:00 / 06:30-07:10 darker, the open wait lighter, the session close (12:55-15:00) amber
int td_bT = int(time / 1000) + 60
bgcolor(td_ok and td_shade ? (t_blk(td_bT) ? color.new(chart.fg_color, 93) : t_owE(td_bT) or t_owW(td_bT) ? color.new(chart.fg_color, 96) : t_sc(td_bT) ? color.new(col_amber, 94) : na) : na, title="TIDE blocks / open wait / session close")
